#!/usr/bin/env python3
"""The gate this repository must pass. Run: scripts/check

Steps, in order:
  1. scripts/lib/selftest.py                 — the parsing layer everything else stands on
  2. scripts/lint-skills                     — the methodology against spec/skill-contract.md
  3. must-fail fixture                       — validate-workspace over fixtures/broken-workspace,
                                               asserting the emitted finding codes equal
                                               EXPECTED-CODES.txt exactly
  4. rendered adapter output is current      — re-render and compare with the committed dist
  5. must-pass workspace                     — validate-workspace over examples/toy-project
  6. claim-provenance fixtures              — scripts/lint-claims must find both defects in
                                               fixtures/broken-workspace and nothing at all in
                                               fixtures/sourced-claims; and the three states of
                                               its diff window, by execution — a real window that
                                               is empty passes, a real window still catches an
                                               unsourced absolute, `--all` is the ending's scope,
                                               and `--changed-since main` standing on `main` is
                                               refused rather than passing over nothing (F-066)
  6a. a mention is not a verdict             — the row that ended iteration 5, replayed over a
                                               copy of the banked evidence: a bare `path:line`
                                               written in prose produces no error, and a citation
                                               planted in the same row that matches a form and
                                               resolves to nothing still does (F-113)
  6b. the document window                    — F-076 and F-058, by execution: a document the
                                               plan's invalidation set names is inside
                                               `lint-claims`' window even though the branch never
                                               opened it; a window nothing could have filled exits
                                               0 and prints NOTHING COULD HAVE BEEN IN SCOPE
                                               rather than a pass; a real empty window stays an
                                               unmarked pass; an absent plan section is an error;
                                               and `check-verify-freshness` stops exempting a
                                               document the item was asked to deliver
  6c. the document obligations               — the eight `[auto]` obligations of ADR-0010's
                                               enforcement table, which stood in six contracts as
                                               `manual_check`: five decidable from a tree alone
                                               over fixtures/document-obligations (wrong/, whose
                                               emitted codes must equal EXPECTED-CODES.txt
                                               exactly; right/, over which every rule must be
                                               silent), and the three that read a diff by
                                               execution in a throwaway repository — a document
                                               written that the plan names nowhere, a write
                                               inside a delimited `## Engagement state` region,
                                               and a quantified sentence propagated with no
                                               enumeration in its audit row. Obligation 10 is
                                               NOT covered and cannot be: see
                                               scripts/lint-documents' docstring
  7. the legal repair for a standing ADR     — fixtures/adr-correction: the reduced iteration-4
                                               ADR reproduces its three true-but-unsourced
                                               absolutes, and the same ADR repaired through
                                               doc-header.md §4b's `## Corrections` is clean.
                                               The shape of a correction is covered by steps 3
                                               and 5 (F-067)
  8. cross-answer consistency               — scripts/lint-answers over fixtures/crossed-answers
                                               (exact codes, the compliant escalation among them
                                               producing none), over the two clean engagements,
                                               and rule 3 by execution in a throwaway repository:
                                               the human's own quoted sentence rewritten without
                                               asking, and each of ADR-0008's two legal moves
                                               clearing it (F-062)
  9. epic sign-off gate                      — scripts/check-epic-signoff refuses the broken
                                               fixture's epic and passes the sourced-claims one
 10. the termination gate                    — check-epic-signoff over fixtures/ended-engagement:
                                               one epic per verdict it has to reach, and
                                               engagement-state's own two
 10b. the abandoned ending, end to end  — fixtures/abandoned-engagement: an E4-by-silence
                                               ending that actually happened. right/ is a VALID
                                               workspace (the validator is run over it) holding
                                               the three states the mechanism must reach — the
                                               ending declared before rest, the ending declared
                                               after rest with an abandoned sign-off, and the
                                               moment before the declaration where
                                               engagement-state says `abandoned`. The trailing
                                               digest is recomputed and required to match, the
                                               orphans are required to be at `blocked` with no
                                               outcome and an `orphaned by E4:` reason, and
                                               wrong/ holds four near misses whose validator
                                               codes must equal EXPECTED-CODES.txt exactly
 11. pipeline invariants                     — lint-skills must report the expected finding code
                                               for each defect reintroduced into pipeline.yaml
 12. a dropped rule obligation is refused    — validate-workspace against a pipeline.yaml whose
                                               rule_obligations no longer scope a status rule;
                                               the registry has to be load-bearing to be worth
                                               having (F-050)
 13. the derived model, by execution         — creation authority refused and permitted through
                                               new-item, and an engagement refused an ending
                                               while nobody had asked the stakeholder
 14. the journal body the prose promises     — a body with no `**Status:**` bullet goes through
                                               the transition and comes back carrying the move
                                               that was made; standalone journal-entry still
                                               requires it, and a body missing a bullet the tool
                                               does not write is still refused (F-049)
 14c. the gate verdicts belong to the runner — the `**Gates:**` bullet the entry carries is
                                               composed from the run `transition` just did: one
                                               line per contract gate, the runner's verdict, the
                                               worker's evidence sentence, a named contradiction
                                               when the two disagreed, `pending` on the one move
                                               a skill hands work to itself, and the validator's
                                               comparison of the bullet against the contract of
                                               the skill in the entry's own heading (F-091,
                                               F-080)
 14b. one silence threshold, three consumers — `termination.silence.threshold_rounds` moved from
                                               3 to 5 over one unchanged workspace, and each of
                                               `record-halt`, `engagement-state` and
                                               `check-epic-signoff` required to change its mind
                                               with it; plus the two properties the E4 model
                                               rests on — that a reader leaves the waiting log
                                               byte-identical, and that an answer resets the
                                               count while our own writes do not (F-045,
                                               ADR-0011)
 15. a trial merge leaves the trunk alone   — the command block review-close's procedure prints,
                                               run against a throwaway repository: the trunk sha
                                               is unchanged, and the same block with --detach
                                               removed moves it (F-055)
 15b. the record catches up                  — the three fields the record cannot hold at the
                                               moment it is written, by execution in a throwaway
                                               repository that is also a workspace. The merge
                                               sha: record-merge refuses five shapes of merge
                                               git cannot confirm and writes nothing after each
                                               refusal, accepts the real one, and the validator
                                               re-asks — catching both a typed field and a merge
                                               nobody recorded (F-081, F-035). The close order:
                                               transition refuses --outcome on a move that does
                                               not end at done and refuses a move to done that
                                               carries none, and the pending move does NOT
                                               downgrade item.outcome.premature, because that
                                               state is avoidable rather than forced (F-083,
                                               contrast F-014). The version row: matched against
                                               the journal of the item it names, both ways, plus
                                               the boundary — the same offending row on a closed
                                               item is history and is not reported (F-084)
 15c. a criterion's identity                 — F-094 and F-096 in one throwaway workspace. The
                                               citation: an `ITEM ACn` may quote the criterion's
                                               words, and the list is then renumbered under two
                                               standing citations — the bare number follows it
                                               silently, the anchored one fails; a bare number is
                                               refused at `draft` and at `ready` and resolves
                                               past them. The tick: `- [~]` names a question on
                                               its own item or is refused, a question elsewhere
                                               or a missing one does not count, and a done item
                                               settled entirely by substitution closes D1 while
                                               the same item unticked does not
 16. write-guard self-test                   — adapters/claude-code/hooks/test_guard.py: the
                                               guard denies every way of writing a protected
                                               file and allows every way of reading or naming one
 17. findings citations resolve             — every `commit <sha>` cited in
                                               meta/findings/FINDINGS.md is an ancestor of HEAD
 17b. finding numbers cited resolve         — and the other direction (F-099): every
                                               `F-###`/`H-###` written in any git-tracked file
                                               matches a `## ` heading in the ledger. A
                                               tombstone resolves; that is how a phantom banked
                                               in read-only evidence is corrected without the
                                               evidence being edited. A tracked path the sweep
                                               cannot read as text is named on stdout
 17c. every finding's status is readable    — meta/findings/FINDINGS.md is append-only, so the
                                               LAST status line in an entry is the current one
                                               (F-112). Every `## F-###`/`## H-###` entry carries
                                               at least one, the header states the reading rule,
                                               and the reader is proved on a probe whose first
                                               entry has none
 18. export profiles                        — scripts/export leaves the workspace behind, and
                                               refuses to write a workspace file into a copy
 19a. the retrospective format             — scripts/lint-retro over fixtures/retro: a correctly
                                               written report produces nothing, and seven
                                               deliberately wrong ones produce exactly the codes
                                               in EXPECTED-CODES.txt, compared as a multiset
 19b. a retrospective invalidates nothing   — the toy project validates clean, gains an
                                               artifacts/retro.md, validates clean again, and
                                               its engagement-state verdict moves from `ended`
                                               to `closed` (ADR-0009 §2)
 19. harness self-test                       — harness/tests/test_harness.py: the contamination
                                               assertions fire on transcripts that must be
                                               rejected, and pass on ones that must not

Steps 4 and 5 report **SKIP** with a reason when their inputs do not exist yet, and a skip is
printed as loudly as a failure. A gate that quietly checks nothing is the thing this file exists
to prevent.
"""

from __future__ import annotations

import os
import re
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SCRIPTS = os.path.join(ROOT, "scripts")


class Runner:
    def __init__(self) -> None:
        self.failures = []
        self.skips = []

    def run(self, label: str, argv: list, expect_zero: bool = True) -> subprocess.CompletedProcess:
        result = subprocess.run(argv, capture_output=True, text=True, cwd=ROOT)
        ok = (result.returncode == 0) if expect_zero else (result.returncode != 0)
        self.emit(label, ok, result)
        return result

    def emit(self, label, ok, result=None, detail="") -> None:
        print(f"{'PASS' if ok else 'FAIL'}  {label}")
        if not ok:
            self.failures.append(label)
            if result is not None:
                for stream in (result.stdout, result.stderr):
                    for line in (stream or "").rstrip().split("\n"):
                        if line:
                            print(f"      {line}")
            if detail:
                for line in detail.rstrip().split("\n"):
                    print(f"      {line}")

    def skip(self, label: str, reason: str) -> None:
        print(f"SKIP  {label}")
        print(f"      {reason}")
        self.skips.append(label)


def codes_from(output: str) -> set:
    found = set()
    for line in output.split("\n"):
        for level in ("ERROR [", "WARNING ["):
            index = line.find(level)
            if index != -1:
                start = index + len(level)
                end = line.find("]", start)
                if end != -1:
                    found.add(line[start:end])
    return found


def write(path: str, text: str) -> None:
    directory = os.path.dirname(path)
    if directory and not os.path.isdir(directory):
        os.makedirs(directory, exist_ok=True)
    with open(path, "w", encoding="utf-8") as handle:
        handle.write(text)


def read(path: str) -> str:
    with open(path, "r", encoding="utf-8") as handle:
        return handle.read()


def check_fixture(runner: Runner) -> None:
    fixture = os.path.join(ROOT, "fixtures", "broken-workspace")
    expected_path = os.path.join(fixture, "EXPECTED-CODES.txt")
    if not os.path.isfile(expected_path):
        runner.skip("must-fail fixture", f"{expected_path} does not exist")
        return
    result = subprocess.run([sys.executable, os.path.join(SCRIPTS, "validate-workspace"),
                             fixture], capture_output=True, text=True, cwd=ROOT)
    if result.returncode == 0:
        runner.emit("must-fail fixture", False, result,
                    detail="the deliberately broken fixture validated clean")
        return
    with open(expected_path, "r", encoding="utf-8") as handle:
        expected = {line.strip() for line in handle if line.strip()}
    actual = codes_from(result.stdout + result.stderr)
    missing = sorted(expected - actual)
    extra = sorted(actual - expected)
    if missing or extra:
        detail = []
        if missing:
            detail.append("rules that stopped firing (present in EXPECTED-CODES.txt, not "
                          "emitted):")
            detail += [f"  - {code}" for code in missing]
        if extra:
            detail.append("codes emitted that EXPECTED-CODES.txt does not list:")
            detail += [f"  + {code}" for code in extra]
        detail.append("if this change is intended, update EXPECTED-CODES.txt in the same "
                      "commit and say why")
        runner.emit("must-fail fixture", False, detail="\n".join(detail))
    else:
        runner.emit(f"must-fail fixture ({len(expected)} codes)", True)


def check_cross_answers(runner: Runner) -> None:
    """A conflict between two of the stakeholder's own answers reaches the stakeholder.

    ADR-0008. Three assertions, because each covers a way the rule could be wrong:

    * the reduced iteration-3 tree produces **exactly** the codes `EXPECTED-CODES.txt` lists —
      which includes the compliant escalation in it producing none, so a rule that starts firing
      on correct work fails here too;
    * the two engagements that end cleanly stay clean;
    * rule 3, which reads a diff, is executed in a throwaway repository: the human's own quoted
      sentence is rewritten, and the gate refuses until one of ADR-0008 §3's two legal moves is
      in the record. The degenerate window (F-066's shape) is asserted in the same repository,
      because a scope check that only ever runs on a real diff has never been tested.
    """
    fixture = os.path.join(ROOT, "fixtures", "crossed-answers")
    expected_path = os.path.join(fixture, "EXPECTED-CODES.txt")
    if not os.path.isfile(expected_path):
        runner.skip("cross-answer consistency", f"{expected_path} does not exist")
        return
    result = subprocess.run([sys.executable, os.path.join(SCRIPTS, "lint-answers"),
                             fixture], capture_output=True, text=True, cwd=ROOT)
    with open(expected_path, "r", encoding="utf-8") as handle:
        expected = {line.strip() for line in handle if line.strip()}
    output = result.stdout + result.stderr
    actual = codes_from(output)
    missing, extra = sorted(expected - actual), sorted(actual - expected)
    # Set equality alone cannot see the compliant escalation regressing: WI-0003 would start
    # producing a code WI-0004 already produces, and the set would not move. The count can.
    # Set equality alone cannot see a rule regressing on the *compliant* half of the fixture:
    # WI-0003 would start producing a code WI-0004 already produces, and the set would not move.
    # Two counts can. Each is pinned to a rule that was fragile when it was written — the
    # escalation whose IDs live in `## Options considered`, and the verdict that wraps onto the
    # next line — and each was confirmed to move under a reverting mutation.
    for code, expected_count, why in (
            ("answer.conflict.unescalated", 1,
             "WI-0003's escalation names both answers in its options and must produce none"),
            ("answer.cross-check.no-verdict", 1,
             "WI-0003's verdict wraps onto a second line and must still be read"),
            ("answer.delegation.unresolved", 2,
             "a delegation citing an answer this workspace does not have, and one citing a "
             "request that does not exist"),
            ("answer.delegation.no-category", 1,
             "an answer ID and nothing else is the unbounded delegation F-082 reports; "
             "WI-0002's compliant one names its category and must produce none"),
            ("answer.delegation.unnamed", 1,
             "a delegation in prose, with no route back to whoever granted it"),
            ("answer.delegation.unsurfaced", 0,
             "the ending's rule; it must not fire in a scope that is not an ending")):
        seen = output.count(f"[{code}]")
        if seen != expected_count:
            extra = extra + [f"{code} fired {seen} time(s), expected {expected_count} — {why}"]
    if result.returncode == 0 or missing or extra:
        detail = ["the reduced iteration-3 record did not produce the expected findings:"]
        detail += [f"  - {code} (expected, not emitted)" for code in missing]
        detail += [f"  + {code} (emitted, not expected)" for code in extra]
        if result.returncode == 0:
            detail.append("  lint-answers exited 0 over a fixture built to fail")
        runner.emit("cross-answer consistency (must-fail fixture)", False,
                    detail="\n".join(detail))
    else:
        runner.emit(f"cross-answer consistency (must-fail fixture, {len(expected)} codes)", True)

    for name in ("ended-engagement", "signed-off-epic"):
        runner.run(f"cross-answer consistency over fixtures/{name}",
                   [sys.executable, os.path.join(SCRIPTS, "lint-answers"),
                    os.path.join(ROOT, "fixtures", name)])

    check_delegation_surfaced(runner)
    check_rewritten_claim(runner)


def check_delegation_surfaced(runner: Runner) -> None:
    """The ending surfaces the assumptions taken on the stakeholder's behalf (F-082, half 2).

    Rule 5 runs only at an ending — `--context epic`, which is how `review-close` runs this gate —
    so the fixture is run a second way and the count is pinned from both sides. `WI-0002/Q-002`
    is spent and named in `EP-001/Q-005`'s `## Question`: it must produce nothing, or a rule that
    fires on every delegation would pass here. `WI-0002/Q-001` is spent and named nowhere: it
    must produce exactly one, or a rule that surfaced nothing would pass here too. `EP-002` is
    that pair again at **E4**, where there is no sign-off and the engagement's account of itself
    is `artifacts/review.md`'s `## Ending statement`; `EP-003` is the third branch — a delegation
    spent in an engagement that has filed neither, which this gate names on stdout and does not
    report, because an ending with no ask at all is `check-epic-signoff`'s to refuse.

    The clean engagements are run the same way, because rule 5 walks every epic in a workspace
    and a rule that reports an ending with no delegation at all is a rule nobody can end under.
    """
    fixture = os.path.join(ROOT, "fixtures", "crossed-answers")
    result = subprocess.run([sys.executable, os.path.join(SCRIPTS, "lint-answers"),
                             fixture, "--context", "epic"],
                            capture_output=True, text=True, cwd=ROOT)
    output = result.stdout + result.stderr
    problems = []
    seen = output.count("[answer.delegation.unsurfaced]")
    if seen != 2:
        problems.append(f"  - answer.delegation.unsurfaced fired {seen} time(s) over "
                        f"fixtures/crossed-answers --context epic, expected exactly 2")
    # One per place an ending's account of itself can live, each with its silent twin beside it
    # in the same fixture: EP-001 has a sign-off, EP-002 ended at E4 and has an ending statement
    # instead, and EP-003 has neither, which is not this gate's failure to report.
    for wanted, why in (
            ("EP-001 ends without the sign-off's `## Question` naming WI-0002/Q-001",
             "the sign-off branch"),
            ("EP-002 ends without `artifacts/review.md`'s `## Ending statement` naming "
             "WI-0002/Q-002",
             "the E4 branch, where there is nobody to address"),
            ("EP-003: 1 delegation(s) spent, and no sign-off or ending statement exists yet",
             "the branch that defers to check-epic-signoff rather than reporting twice")):
        if wanted not in output:
            problems.append(f"  - {why}: expected the report to say {wanted!r}")
    for unwanted, why in (
            ("EP-001 ends without the sign-off's `## Question` naming WI-0002/Q-002",
             "EP-001's sign-off names WI-0002/Q-002"),
            ("naming WI-0003/Q-001", "EP-002's ending statement names WI-0003/Q-001"),
            ("R-001, which is not", "R-001 is a request that exists in this workspace")):
        if unwanted in output:
            problems.append(f"  - {why}, and it was reported anyway")
    for name in ("ended-engagement", "signed-off-epic", "abandoned-engagement/right"):
        clean = subprocess.run([sys.executable, os.path.join(SCRIPTS, "lint-answers"),
                                os.path.join(ROOT, "fixtures", *name.split("/")),
                                "--context", "epic"],
                               capture_output=True, text=True, cwd=ROOT)
        if clean.returncode != 0:
            problems.append(f"  - fixtures/{name} --context epic exited {clean.returncode}\n"
                            + (clean.stdout + clean.stderr).strip())
    if problems:
        runner.emit("the ending surfaces every delegation spent (F-082)", False,
                    detail="\n".join(problems))
        return
    runner.emit("the ending surfaces every delegation spent (F-082, 12 observations)", True)


REWRITTEN_CLAIM_QUESTION = """---
id: Q-001
item: WI-0001
from-skill: refine
addressed-to: human
blocking: true
status: answered
created: 2026-08-29T09:00:00Z
answered-at: 2026-08-29T09:30:00Z
answered-by: human
---

## Context

The alignment question.

## Question

Where does the text sit in a cell?

## Options considered

- **A --** the marker decides. **B --** multiline cells are special.
- **Recommendation:** none, insufficient basis.

## Answer

The marker decides everything -- every row, every column, no exceptions.

## Consequences

`docs/product/vision.md` records the rule.

## Cross-answer check

Checked against: none -- the first answer on this behaviour.
"""

VISION_BEFORE = """---
title: Vision
version: 1
status: current
updated: 2026-08-29T09:40:00Z
updated-by: intake
updated-for: WI-0001
---

# Vision

The marker decides where the text sits, in every column without exception
[src: WI-0001/Q-001].

## Change log

| version | when | by | for | what changed |
|---------|------|----|-----|--------------|
| 1 | 2026-08-29T09:40:00Z | intake | WI-0001 | First version |
"""

VISION_AFTER = VISION_BEFORE.replace(
    "The marker decides where the text sits, in every column without exception\n"
    "[src: WI-0001/Q-001].",
    "The marker decides where the text sits, except in a cell holding a line break\n"
    "[src: WI-0001/Q-001].")

# The same paragraph with the marker *shown* instead of made: a sentence about how an answer is
# cited, sourced to nobody. Rewriting it owes the stakeholder nothing, and a bare scrape of the
# citation vocabulary said it did (F-113).
VISION_MENTION = VISION_BEFORE.replace(
    "The marker decides where the text sits, in every column without exception\n"
    "[src: WI-0001/Q-001].",
    "A claim taken from an answer names it, so this document writes `[src: WI-0001/Q-001]`\n"
    "wherever it repeats one. This paragraph is about the convention and claims nothing.")

VISION_MENTION_REWRITTEN = VISION_MENTION.replace(
    "This paragraph is about the convention and claims nothing.",
    "This paragraph explains the convention and claims nothing.")


def check_rewritten_claim(runner: Runner) -> None:
    """The refused move, by execution: the human's own sentence, rewritten without asking."""
    import shutil
    import tempfile
    label = "the human's own sentence is not rewritten unasked (F-062, 5 cases)"
    if shutil.which("git") is None:
        runner.skip(label, "git is not on PATH")
        return
    with tempfile.TemporaryDirectory() as base:
        repo = os.path.join(base, "workspace")
        shutil.copytree(os.path.join(ROOT, "fixtures", "crossed-answers"), repo)
        # One item, one human answer, one document quoting it. Everything else from the fixture
        # would only add findings that have nothing to do with the diff.
        shutil.rmtree(os.path.join(repo, "tracker", "items"))
        item_dir = os.path.join(repo, "tracker", "items", "WI-0001")
        os.makedirs(os.path.join(item_dir, "questions"))
        write(os.path.join(item_dir, "item.md"),
              "---\nid: WI-0001\ntype: work-item\nstatus: done\npriority: high\n"
              "epic: EP-001\n---\n\n## Story\n\nFixture.\n\n## Acceptance criteria\n\n"
              "- [x] AC1 -- the fixture loads\n")
        write(os.path.join(item_dir, "journal.md"), "# Journal -- WI-0001\n")
        write(os.path.join(item_dir, "questions", "Q-001.md"), REWRITTEN_CLAIM_QUESTION)
        os.makedirs(os.path.join(repo, "docs", "product"))
        vision = os.path.join(repo, "docs", "product", "vision.md")
        write(vision, VISION_BEFORE)

        def git(*args):
            return subprocess.run(["git", *args], cwd=repo, capture_output=True, text=True)

        git("init", "--initial-branch=main")
        git("config", "user.email", "check@example.invalid")
        git("config", "user.name", "check")
        git("add", "-A")
        git("commit", "-m", "the record as the stakeholder left it")

        def lint(*extra):
            return subprocess.run([sys.executable, os.path.join(SCRIPTS, "lint-answers"),
                                   "--root", repo, *extra],
                                  capture_output=True, text=True, cwd=ROOT)

        cases = []
        # 1. the window that cannot see: main is HEAD and nothing is modified (F-066's shape).
        clean = lint("--changed-since", "main")
        cases.append(("a window that could not have seen anything is refused",
                      clean.returncode != 0
                      and "answer.scope.degenerate" in codes_from(clean.stdout + clean.stderr),
                      clean))
        # 2. the refused move itself.
        write(vision, VISION_AFTER)
        rewritten = lint("--changed-since", "main")
        cases.append(("rewriting a claim sourced to a human answer is refused",
                      rewritten.returncode != 0
                      and "answer.claim-rewritten-unasked" in codes_from(rewritten.stdout
                                                                        + rewritten.stderr),
                      rewritten))
        # 3. legal move one: cite compatibility, in the journal, naming the answer.
        write(os.path.join(item_dir, "journal.md"),
              "# Journal -- WI-0001\n\n## 2026-08-29T11:00:00Z -- implement v0.1.0 -- developer\n"
              "\n- **Cross-answer check:** WI-0001/Q-001 -- compatible; the sentence was our "
              "paraphrase, not theirs, and the answer itself is unchanged.\n")
        cited = lint("--changed-since", "main")
        cases.append(("citing compatibility in the journal clears it",
                      cited.returncode == 0, cited))
        # 4. legal move two: ask. The journal bullet goes away and a question names both answers.
        write(os.path.join(item_dir, "journal.md"), "# Journal -- WI-0001\n")
        write(os.path.join(item_dir, "questions", "Q-002.md"),
              "---\nid: Q-002\nitem: WI-0001\nfrom-skill: implement\naddressed-to: human\n"
              "blocking: true\nstatus: open\ncreated: 2026-08-29T11:00:00Z\n---\n\n"
              "## Context\n\nTwo things you told us cannot both hold.\n\n## Question\n\n"
              "In `WI-0001/Q-001` you said the marker decides every row and column with no\n"
              "exceptions. The sign-off condition says a cell with a line break ignores it.\n"
              "Which wins?\n\n## Options considered\n\n- **A --** the marker. **B --** the "
              "exception.\n- **Recommendation:** none -- this is yours to settle.\n\n"
              "## Answer\n\n<!-- filled in by answer-questions -->\n\n## Consequences\n\n"
              "<!-- filled in by answer-questions -->\n")
        asked = lint("--changed-since", "main")
        cases.append(("asking its author clears it", asked.returncode == 0, asked))
        # 5. and the other direction of the same reader: a paragraph whose only marker is
        # *quoted* is not sourced to that answer, so rewriting it is not the refused move. The
        # question and the journal bullet are both gone, so nothing but the masking can clear it
        # — under a scrape that ignores code spans this case is refused, which is F-113 (F-075's
        # class, in the direction that reports a defect where there is none).
        os.remove(os.path.join(item_dir, "questions", "Q-002.md"))
        write(vision, VISION_MENTION)
        git("add", "-A")
        git("commit", "-m", "a paragraph that shows the form rather than using it")
        write(vision, VISION_MENTION_REWRITTEN)
        mention = lint("--changed-since", "main")
        cases.append(("a quoted marker is not a source, so rewriting it is not refused",
                      mention.returncode == 0, mention))

    failed = [(name, result) for name, ok, result in cases if not ok]
    if failed:
        detail = []
        for name, result in failed:
            detail.append(f"  - {name}: exit {result.returncode}")
            detail += [f"      {line}" for line in
                       (result.stdout + result.stderr).strip().split("\n")[-6:]]
        runner.emit(label, False, detail="\n".join(detail))
    else:
        runner.emit(label, True)


def check_retro(runner: Runner) -> None:
    """A retrospective says what it read and cites what it claims (spec/retro.md).

    Two directions in one fixture, which is the pattern `lint-claims` established: a report a
    person would actually write must produce **zero** findings, and seven deliberately wrong ones
    must produce exactly the listed codes. The comparison is a multiset rather than a set, so a
    rule that starts firing twice fails as loudly as one that stops firing.
    """
    fixture = os.path.join(ROOT, "fixtures", "retro")
    expected_path = os.path.join(fixture, "EXPECTED-CODES.txt")
    if not os.path.isfile(expected_path):
        runner.skip("the retrospective format", f"{expected_path} does not exist")
        return
    linter = os.path.join(SCRIPTS, "lint-retro")

    # The must-pass half first: the report EP-001 carries is what the format asks for.
    for extra in ([], ["--require-scope"]):
        clean = subprocess.run([sys.executable, linter, "EP-001", "--root", fixture] + extra,
                               capture_output=True, text=True, cwd=ROOT)
        if clean.returncode != 0:
            runner.emit("the retrospective format", False, clean,
                        detail="a correctly written retrospective must produce nothing"
                               + (" (with --require-scope)" if extra else ""))
            return

    result = subprocess.run([sys.executable, linter, "--all", "--require-scope",
                             "--root", fixture], capture_output=True, text=True, cwd=ROOT)
    if result.returncode == 0:
        runner.emit("the retrospective format", False, result,
                    detail="the deliberately broken reports produced no findings")
        return
    actual = sorted(ordered_codes(result.stdout + result.stderr))
    with open(expected_path, "r", encoding="utf-8") as handle:
        expected = sorted(line.strip() for line in handle if line.strip())
    if actual != expected:
        missing = sorted(_multiset_difference(expected, actual))
        extra = sorted(_multiset_difference(actual, expected))
        detail = []
        if missing:
            detail.append("rules that stopped firing (or fire fewer times):")
            detail += [f"  - {code}" for code in missing]
        if extra:
            detail.append("codes emitted that EXPECTED-CODES.txt does not account for:")
            detail += [f"  + {code}" for code in extra]
        detail.append("if this change is intended, update EXPECTED-CODES.txt in the same "
                      "commit and say why")
        runner.emit("the retrospective format", False, detail="\n".join(detail))
        return
    runner.emit(f"the retrospective format (must-pass, and {len(expected)} codes)", True)


def check_retro_is_additive(runner: Runner) -> None:
    """Adding a retrospective to a valid workspace invalidates nothing (ADR-0009 §2).

    The retro was introduced after every existing workspace already existed, and the design says
    plainly that none of them changes verdict class or fails a check because the skill now
    exists. That is a claim about software, so it is executed rather than asserted: the toy
    project validates clean, gains a report, and validates clean again — while the engagement's
    verdict moves from `ended` to `closed`, which is the only thing that may change.
    """
    import shutil
    import tempfile
    example = os.path.join(ROOT, "examples", "toy-project")
    if not os.path.isdir(example):
        runner.skip("a retrospective invalidates nothing", f"{example} does not exist")
        return
    report = os.path.join(ROOT, "fixtures", "retro", "tracker", "items", "EP-001",
                          "artifacts", "retro.md")
    if not os.path.isfile(report):
        runner.skip("a retrospective invalidates nothing", f"{report} does not exist")
        return
    validator = os.path.join(SCRIPTS, "validate-workspace")
    state = os.path.join(SCRIPTS, "engagement-state")
    with tempfile.TemporaryDirectory() as base:
        workspace = os.path.join(base, "toy")
        shutil.copytree(example, workspace)
        before = subprocess.run([sys.executable, validator, workspace],
                                capture_output=True, text=True, cwd=ROOT)
        if before.returncode != 0:
            runner.emit("a retrospective invalidates nothing", False, before,
                        detail="the copied example does not validate before the report is added")
            return
        verdict_before = subprocess.run([sys.executable, state, "--all", "--root", workspace],
                                        capture_output=True, text=True, cwd=ROOT)
        shutil.copyfile(report, os.path.join(workspace, "tracker", "items", "EP-001",
                                             "artifacts", "retro.md"))
        after = subprocess.run([sys.executable, validator, workspace],
                               capture_output=True, text=True, cwd=ROOT)
        if after.returncode != 0:
            runner.emit("a retrospective invalidates nothing", False, after,
                        detail="adding artifacts/retro.md made a valid workspace invalid")
            return
        verdict_after = subprocess.run([sys.executable, state, "--all", "--root", workspace],
                                       capture_output=True, text=True, cwd=ROOT)
        if "EP-001 ended" not in verdict_before.stdout:
            runner.emit("a retrospective invalidates nothing", False, verdict_before,
                        detail="the engagement was expected to read 'ended' before the report")
            return
        if "EP-001 closed" not in verdict_after.stdout:
            runner.emit("a retrospective invalidates nothing", False, verdict_after,
                        detail="the engagement was expected to read 'closed' once the report "
                               "exists — the orchestrator's step 7 does not terminate otherwise")
            return
    runner.emit("a retrospective invalidates nothing (clean, ended -> closed, clean)", True)


def ordered_codes(output: str) -> list:
    """Every finding code in emission order, duplicates kept."""
    found = []
    for line in output.split("\n"):
        for level in ("ERROR [", "WARNING ["):
            index = line.find(level)
            if index != -1:
                start = index + len(level)
                end = line.find("]", start)
                if end != -1:
                    found.append(line[start:end])
    return found


def _multiset_difference(left: list, right: list) -> list:
    remaining = list(right)
    surplus = []
    for item in left:
        if item in remaining:
            remaining.remove(item)
        else:
            surplus.append(item)
    return surplus


def check_render(runner: Runner) -> None:
    renderer = os.path.join(ROOT, "adapters", "claude-code", "render.py")
    if not os.path.isfile(renderer):
        runner.skip("rendered output is current", "the adapter renderer does not exist yet")
        return
    runner.run("rendered output is current",
               [sys.executable, renderer, "--check"])


def check_example(runner: Runner) -> None:
    example = os.path.join(ROOT, "examples", "toy-project")
    if not os.path.isdir(os.path.join(example, "tracker")):
        runner.skip("must-pass workspace", "examples/toy-project has no workspace yet")
        return
    runner.run("must-pass workspace",
               [sys.executable, os.path.join(SCRIPTS, "validate-workspace"), example])


def check_claims(runner: Runner) -> None:
    linter = os.path.join(SCRIPTS, "lint-claims")
    broken = os.path.join(ROOT, "fixtures", "broken-workspace")
    clean = os.path.join(ROOT, "fixtures", "sourced-claims")
    if not os.path.isfile(linter) or not os.path.isdir(clean):
        runner.skip("claim-provenance fixtures", "scripts/lint-claims or its fixtures are absent")
        return
    result = subprocess.run([sys.executable, linter, "--root", broken, "--all"],
                            capture_output=True, text=True, cwd=ROOT)
    output = result.stdout + result.stderr
    found = codes_from(output)
    expected = {"claim.citation.unresolved", "claim.unsourced",
                "claim.citation.outside-the-record"}
    # A subset cannot see the second unsourced paragraph regressing into the first one's code, so
    # rule 2 is pinned by count as well — the same reasoning `check_cross_answers` gives. The two
    # are the pair F-113 is about: one absolute with no marker at all, and one whose only marker
    # is *shown* inside backticks and must not be read as a source.
    #
    # `claim.citation.unresolved` is pinned at 2 for ADR-0013's sake: one of the two is the
    # `toolkit:` citation that quotes nothing, and it shares its code with an older case, so the
    # exact-set comparison over this fixture cannot see it stop firing. The count can.
    counts = {"claim.unsourced": 2, "claim.citation.unresolved": 2,
              "claim.citation.outside-the-record": 1}
    wrong = {code: output.count(f"[{code}]") for code in counts
             if output.count(f"[{code}]") != counts[code]}
    if result.returncode == 0 or not expected <= found or wrong:
        runner.emit("claim-provenance fixtures", False, result,
                    detail=f"expected {sorted(expected)} over the broken fixture with counts "
                           f"{counts}, found {sorted(found)} with "
                           f"{ {code: output.count(f'[{code}]') for code in counts} }")
        return
    # A rule nobody can satisfy is not a rule: prose that cites its sources must pass cleanly.
    runner.run("claim-provenance fixtures",
               [sys.executable, linter, "--root", clean, "--all"])
    # And the form the GATE actually runs. `--all` and `--changed-since` take different code
    # paths, and a preflight caught the second one crashing while the first was green — the
    # fixtures proved the rules and never proved the invocation.
    #
    # F-066: this exact invocation, over a tree standing at the ref it is comparing against, is
    # the vacuous pass. It must now be refused, and the case is asserted on the code rather than
    # on the exit status, because "exits non-zero" would also be satisfied by the gate crashing.
    degenerate = subprocess.run(
        [sys.executable, linter, "--root", clean, "--changed-since", "HEAD"],
        capture_output=True, text=True, cwd=ROOT)
    ok = (degenerate.returncode != 0
          and "claim.scope.degenerate" in codes_from(degenerate.stdout + degenerate.stderr))
    runner.emit("a claims window that could not see is refused (F-066)", ok,
                None if ok else degenerate,
                detail="" if ok else "  the invocation the contract runs at an epic ending "
                                     "still reports a pass over an empty comparison")
    check_claims_scope(runner)


def check_claims_scope(runner: Runner) -> None:
    """The three states of a claims window, by execution (F-066).

    A real window that happens to be empty must stay a pass — otherwise the fix turns every item
    that touched no document into a blocked transition, which is how a gate gets switched off.
    """
    import shutil
    import tempfile
    label = "the three states of a claims window (F-066, 4 cases)"
    linter = os.path.join(SCRIPTS, "lint-claims")
    if shutil.which("git") is None:
        runner.skip(label, "git is not on PATH")
        return
    unsourced = ("---\ntitle: Overview\nversion: 1\nstatus: current\n"
                 "updated: 2026-08-29T09:00:00Z\nupdated-by: plan\nupdated-for: WI-0001\n"
                 "---\n\n# Overview\n\n`render_table` never touches a line outside a table.\n"
                 "\n## Change log\n\n| version | when | by | for | what changed |\n"
                 "|---------|------|----|-----|--------------|\n"
                 "| 1 | 2026-08-29T09:00:00Z | plan | WI-0001 | First version |\n")
    with tempfile.TemporaryDirectory() as base:
        repo = os.path.join(base, "workspace")
        os.makedirs(os.path.join(repo, "docs", "architecture"))
        overview = os.path.join(repo, "docs", "architecture", "overview.md")

        def git(*args):
            return subprocess.run(["git", *args], cwd=repo, capture_output=True, text=True)

        write(os.path.join(repo, "README.md"), "# workspace\n")
        git("init", "--initial-branch=main")
        git("config", "user.email", "check@example.invalid")
        git("config", "user.name", "check")
        git("add", "-A")
        git("commit", "-m", "base")

        def lint(*extra):
            return subprocess.run([sys.executable, linter, "--root", repo, *extra],
                                  capture_output=True, text=True, cwd=ROOT)

        cases = []
        # 1. a real window with nothing in it: the branch moved, no document did.
        git("checkout", "-q", "-b", "wi/WI-0001")
        write(os.path.join(repo, "code.py"), "def render_table():\n    return None\n")
        git("add", "-A")
        git("commit", "-m", "code only")
        empty = lint("--changed-since", "main")
        cases.append(("a real window with no documents in it is a pass",
                      empty.returncode == 0, empty))
        # 2. the same window, with a document in it, still finds the defect.
        write(overview, unsourced)
        real = lint("--changed-since", "main")
        cases.append(("a real window still catches an unsourced absolute",
                      real.returncode != 0
                      and "claim.unsourced" in codes_from(real.stdout + real.stderr), real))
        git("add", "-A")
        git("commit", "-m", "the document")
        # 3. the ending's scope: no branch, no diff, and the defect is still found.
        git("checkout", "-q", "main")
        git("merge", "-q", "--no-ff", "-m", "merge", "wi/WI-0001")
        ending = lint("--all")
        cases.append(("--all at an ending is a real scope and finds the same defect",
                      ending.returncode != 0
                      and "claim.unsourced" in codes_from(ending.stdout + ending.stderr), ending))
        # 4. and the invocation the ending used to run is refused rather than passing over it.
        vacuous = lint("--changed-since", "main")
        cases.append(("--changed-since main, standing on main, is refused",
                      vacuous.returncode != 0
                      and "claim.scope.degenerate" in codes_from(vacuous.stdout
                                                                 + vacuous.stderr), vacuous))

    failed = [(name, result) for name, ok, result in cases if not ok]
    if failed:
        detail = []
        for name, result in failed:
            detail.append(f"  - {name}: exit {result.returncode}")
            detail += [f"      {line}" for line in
                       (result.stdout + result.stderr).strip().split("\n")[-6:]]
        runner.emit(label, False, detail="\n".join(detail))
    else:
        runner.emit(label, True)


PLAN_TABLE_HEADER = ("| document | what | kind | why | disposition |\n"
                     "|----------|------|------|-----|-------------|\n")

UNSOURCED_VISION = (
    "---\ntitle: Vision\nversion: 1\nstatus: current\n"
    "updated: 2026-09-01T09:00:00Z\nupdated-by: plan\nupdated-for: WI-0001\n---\n\n"
    "# Vision\n\n`render_table` never touches a line outside a table.\n\n"
    "## Change log\n\n| version | when | by | for | what changed |\n"
    "|---------|------|----|-----|--------------|\n"
    "| 1 | 2026-09-01T09:00:00Z | plan | WI-0001 | First version |\n")

SOURCED_VISION = UNSOURCED_VISION.replace(
    "`render_table` never touches a line outside a table.",
    "`render_table` never touches a line outside a table [src: code.py].")


def _plan(invalidation: str, deliverable: str) -> str:
    return ("# Plan — WI-0001\n\n## Invalidation set\n\n"
            + PLAN_TABLE_HEADER + invalidation + "\n## Deliverable documents\n\n"
            + deliverable)


def check_mention_is_not_a_verdict(runner: Runner) -> None:
    """The row that ended iteration 5, re-run against the fix (F-113, F-075).

    `meta/harness/evidence/iteration-5-envel-abandoned/` is a real workspace as it stood at a
    `validator-failed` stop, and the single error that stopped it is still in it at
    `tracker/items/WI-0002/history.md:14`: `verify` naming the citation form `path:line` in prose,
    bare, in the sentence reporting four real citations it had just found falsified. The copy is
    the anchor rather than a hand-made fixture because a fixture is written by whoever wrote the
    rule, and this row was not.

    Both directions, because a split that only ever softens is the same defect turned around: the
    mention must produce no error, and a citation planted in the same row that *matches a form*
    and does not resolve must still produce one. The rest of the copy reports ~43 unrelated
    errors — `envel/` and `.claude/` were never banked — so the assertions name the row, not the
    total. The evidence is copied and never touched: it is read-only history.
    """
    import shutil
    import tempfile
    source = os.path.join(ROOT, "meta", "harness", "evidence", "iteration-5-envel-abandoned")
    row = os.path.join("tracker", "items", "WI-0002", "history.md")
    if not os.path.isfile(os.path.join(source, row)):
        runner.skip("the row that ended iteration 5 (F-113)", f"{source} has no {row}")
        return
    validator = os.path.join(SCRIPTS, "validate-workspace")
    located = f"{row.replace(os.sep, '/')}:14:"
    problems = []
    with tempfile.TemporaryDirectory() as base:
        copy = os.path.join(base, "workspace")
        shutil.copytree(source, copy)

        def findings_on_the_row():
            result = subprocess.run([sys.executable, validator, copy],
                                    capture_output=True, text=True, cwd=ROOT)
            return [line for line in (result.stdout + result.stderr).split("\n")
                    if line.startswith(located)]

        before = findings_on_the_row()
        errors = [line for line in before if " ERROR " in line]
        warnings = [line for line in before if " WARNING " in line]
        if errors:
            problems.append("the mention still fails the run:\n      " + "\n      ".join(errors))
        if not any("claim.citation.unrecognised" in line for line in warnings):
            problems.append("the mention is not reported at all — silence is not the fix, the "
                            "gate must still say it could not check this")

        # The other half: a citation in a form the gate knows, pointing at nothing.
        text = read(os.path.join(copy, row))
        planted = text.replace("were falsified by this item's own edits",
                               "were falsified by this item's own edits [src: ADR-9999]", 1)
        if planted == text:
            problems.append("the planted-citation anchor no longer matches the banked row")
        else:
            write(os.path.join(copy, row), planted)
            after = findings_on_the_row()
            if not any(" ERROR " in line and "claim.citation.unresolved" in line
                       for line in after):
                problems.append("a citation matching a known form and resolving to nothing no "
                                "longer fails:\n      " + "\n      ".join(after) or
                                "(nothing reported on the row)")
    if problems:
        runner.emit("the row that ended iteration 5 (F-113)", False,
                    detail="\n".join(f"  - {problem}" for problem in problems))
        return
    runner.emit("the row that ended iteration 5 is a warning, a wrong citation still an error "
                "(F-113)", True)


def check_document_window(runner: Runner) -> None:
    """The window a document gate stands in, by execution (F-076, F-058, ADR-0010 §5).

    Two gates were looking in the wrong place and both were reporting a pass for it.

    `lint-claims --changed-since {{trunk}}` on `implement` is a window over the documents the
    branch changed, and the documents a change *falsifies* are exactly the ones its diff does not
    touch. The window was empty on every execution in every engagement, and `scope.py`'s
    three-state model called that an honest pass *"because the comparison could have found
    something"* — the one sentence F-076 falsifies. Case 1 below is that fixture: the plan names a
    document, the branch never opens it, the document carries an unsourced absolute, and before
    this change the gate exited 0.

    `check-verify-freshness` exempts everything under `docs/` from D10 because `verify` and
    `review-close` must commit their own records. True of a document that *records* a decision;
    false of a document that IS the deliverable (F-058). Cases 7 and 8 are that pair.

    Both directions on every rule, because a rule nobody can satisfy is not a rule: an item that
    legitimately has no documents must still pass (case 3), and a plan that names a clean document
    must still pass (case 2).
    """
    import shutil
    import tempfile
    label = "the document window (F-076, F-058, 8 cases)"
    linter = os.path.join(SCRIPTS, "lint-claims")
    freshness = os.path.join(SCRIPTS, "check-verify-freshness")
    if shutil.which("git") is None:
        runner.skip(label, "git is not on PATH")
        return
    cases = []
    with tempfile.TemporaryDirectory() as base:
        # ---- the claims window ----------------------------------------------------------
        repo = os.path.join(base, "claims")
        artifacts = os.path.join(repo, "tracker", "items", "WI-0001", "artifacts")
        os.makedirs(os.path.join(repo, "docs", "product"))
        os.makedirs(artifacts)
        plan_path = os.path.join(artifacts, "plan.md")
        vision = os.path.join(repo, "docs", "product", "vision.md")

        def git(*args):
            return subprocess.run(["git", *args], cwd=repo, capture_output=True, text=True)

        write(os.path.join(repo, "code.py"), "def render_table():\n    return None\n")
        write(vision, UNSOURCED_VISION)
        write(os.path.join(repo, "docs", "product", "charter.md"), SOURCED_VISION)
        write(plan_path, _plan("| `docs/product/vision.md` | the sentence about `render_table` "
                               "| cited-fact | the change alters it | to-update |\n",
                               "- none\n"))
        git("init", "--initial-branch=main")
        git("config", "user.email", "check@example.invalid")
        git("config", "user.name", "check")
        git("add", "-A")
        git("commit", "-m", "base")
        # The branch changes code and never opens a document — F-076's shape exactly.
        git("checkout", "-q", "-b", "wi/WI-0001")
        write(os.path.join(repo, "code.py"),
              "def render_table():\n    return []\n")
        git("add", "-A")
        git("commit", "-m", "code only")

        def lint(*extra):
            return subprocess.run([sys.executable, linter, "--root", repo, *extra],
                                  capture_output=True, text=True, cwd=ROOT)

        # 1. must-fail — the plan names a falsified document the diff does not contain.
        found = lint("--changed-since", "main", "--plan-documents", "WI-0001")
        cases.append(("a document the plan names is in the window even though the branch never "
                      "touched it",
                      found.returncode != 0
                      and "claim.unsourced" in codes_from(found.stdout + found.stderr), found))

        # 2. must-pass — a plan naming a document whose absolute IS sourced. Asserted on the
        #    scope line as well as the exit code: "exits 0" is also what the defect did, and the
        #    thing being proved is that the widened window examined a document at all. Neither
        #    document is in the branch diff, in this case or the one above.
        write(plan_path, _plan("| `docs/product/charter.md` | the sentence about "
                               "`render_table` | cited-fact | the change alters it | to-update "
                               "|\n", "- none\n"))
        clean = lint("--changed-since", "main", "--plan-documents", "WI-0001")
        cases.append(("the widened window passes when the claim it reaches carries its source",
                      clean.returncode == 0
                      and "1 document(s) in 1 path(s) in scope" in clean.stdout, clean))

        # 3. the fourth state: the plan declares nothing, so nothing could have been in scope.
        #    Exit 0 — an item with no documents is ordinary work and a gate that fails on
        #    ordinary work gets switched off — but never spelled as a pass.
        write(plan_path, _plan("| none | no document is at risk | cited-fact | the change is "
                               "confined to code.py | verified-still-true |\n", "- none\n"))
        marked = lint("--changed-since", "main", "--plan-documents", "WI-0001")
        output = marked.stdout + marked.stderr
        cases.append(("an empty-by-construction window exits 0 and says so in its own words",
                      marked.returncode == 0
                      and "claim.scope.by-construction" in codes_from(output)
                      and "NOTHING COULD HAVE BEEN IN SCOPE" in output, marked))

        # 4. and the state it must not be confused with: a real, empty window is still a plain
        #    pass, with no mark on it. Losing this is how the fix becomes a blocked pipeline.
        plain = lint("--changed-since", "main")
        cases.append(("a real window with nothing in it is still an unmarked pass",
                      plain.returncode == 0
                      and "claim.scope.by-construction" not in codes_from(plain.stdout
                                                                          + plain.stderr), plain))

        # 5. an absent section is not an empty one.
        write(plan_path, "# Plan — WI-0001\n\n## Invalidation set\n\n" + PLAN_TABLE_HEADER
              + "| none | nothing | cited-fact | code only | verified-still-true |\n")
        absent = lint("--changed-since", "main", "--plan-documents", "WI-0001")
        cases.append(("a plan missing ## Deliverable documents is an error, not an empty set",
                      absent.returncode != 0
                      and "claim.plan.section.missing" in codes_from(absent.stdout
                                                                     + absent.stderr), absent))

        # 6. a degenerate window stays a failure. Naming documents in a plan must not become a
        #    way to make a broken comparison look answerable.
        write(plan_path, _plan("| `docs/product/vision.md` | a sentence | cited-fact | it "
                               "changes | to-update |\n", "- none\n"))
        broken = lint("--changed-since", "no-such-ref", "--plan-documents", "WI-0001")
        cases.append(("--plan-documents does not rescue a degenerate window",
                      broken.returncode != 0
                      and "claim.scope.degenerate" in codes_from(broken.stdout
                                                                 + broken.stderr), broken))

        # ---- the freshness exemption ----------------------------------------------------
        fresh = os.path.join(base, "freshness")
        fresh_artifacts = os.path.join(fresh, "tracker", "items", "WI-0002", "artifacts")
        os.makedirs(os.path.join(fresh, "docs", "product"))
        os.makedirs(os.path.join(fresh, "docs", "architecture"))
        os.makedirs(fresh_artifacts)

        def fgit(*args):
            return subprocess.run(["git", *args], cwd=fresh, capture_output=True, text=True)

        write(os.path.join(fresh, "code.py"), "x = 1\n")
        write(os.path.join(fresh, "docs", "product", "vision.md"), "# Vision\n\nOne sentence.\n")
        write(os.path.join(fresh, "docs", "architecture", "overview.md"), "# Overview\n\nOne.\n")
        write(os.path.join(fresh_artifacts, "plan.md"),
              ("# Plan — WI-0002\n\n## Invalidation set\n\n" + PLAN_TABLE_HEADER
               + "| none | nothing else at risk | cited-fact | the item is about the vision "
                 "| verified-still-true |\n\n## Deliverable documents\n\n"
                 "- `docs/product/vision.md` — AC1 is a criterion about this document\n"))
        fgit("init", "--initial-branch=main")
        fgit("config", "user.email", "check@example.invalid")
        fgit("config", "user.name", "check")
        fgit("add", "-A")
        fgit("commit", "-m", "base")
        verified = fgit("rev-parse", "HEAD").stdout.strip()
        write(os.path.join(fresh_artifacts, "verify-report.md"),
              f"# Verify — WI-0002\n\nVerified-commit: {verified}\n")
        fgit("add", "-A")
        fgit("commit", "-m", "the verify record")

        def stale():
            return subprocess.run([sys.executable, freshness, "WI-0002", "main", "--root", fresh],
                                  capture_output=True, text=True, cwd=ROOT)

        # 7. must-pass — a record document changed after verification. `verify` and
        #    `review-close` must commit their own records; that must stay exempt.
        write(os.path.join(fresh, "docs", "architecture", "overview.md"),
              "# Overview\n\nOne. And a record edit.\n")
        fgit("commit", "-qam", "a record edit under docs/")
        record_only = stale()
        cases.append(("a record document changed after verification is still exempt",
                      record_only.returncode == 0, record_only))

        # 8. must-fail — the *delivered* document changed after verification. F-058: the old
        #    exemption excluded the one thing the item was asked to produce.
        write(os.path.join(fresh, "docs", "product", "vision.md"),
              "# Vision\n\nOne sentence, edited after it was verified.\n")
        fgit("commit", "-qam", "an edit to the delivered document")
        delivered = stale()
        cases.append(("a delivered document changed after verification sends the item back",
                      delivered.returncode != 0
                      and "docs/product/vision.md" in (delivered.stdout + delivered.stderr),
                      delivered))

    failed = [(name, result) for name, ok, result in cases if not ok]
    if failed:
        detail = []
        for name, result in failed:
            detail.append(f"  - {name}: exit {result.returncode}")
            detail += [f"      {line}" for line in
                       (result.stdout + result.stderr).strip().split("\n")[-8:]]
        runner.emit(label, False, detail="\n".join(detail))
    else:
        runner.emit(label, True)


# ---- the document obligations (META-148b, ADR-0010's enforcement table) --------------------

# The five rules a workspace alone can decide, and the item each is aimed at in the must-fail
# tree. Kept as data so the fixture's README, `EXPECTED-CODES.txt` and this list can be read
# against each other by a person in one sitting.
# The third element is whether this invocation must report SOMETHING. `WI-0002`'s plan is the
# control: it is well formed, and its still-open disposition is legal at `planned` and illegal
# only afterwards. A control that starts emitting a code is caught by the set comparison; a
# control asserted to emit one would be a rule that fails compliant work.
DOCUMENT_RULES = [
    ("documents-at-risk-are-enumerated", ["--item", "WI-0001"], True),
    ("documents-at-risk-are-enumerated", ["--item", "WI-0002"], False),
    ("documents-at-risk-are-enumerated", ["--item", "WI-0003"], True),
    ("documents-at-risk-are-enumerated", ["--item", "WI-0004"], True),
    ("invalidation-set-is-disposed", ["--item", "WI-0001"], True),
    ("invalidation-set-is-disposed", ["--item", "WI-0002"], True),
    ("adr-conformance-is-decided", ["--item", "WI-0001"], True),
    ("adr-conformance-is-decided", ["--item", "WI-0002"], True),
    ("engagement-state-is-restated", ["--item", "EP-001", "--context", "epic"], True),
    ("engagement-state-is-restated", ["--item", "EP-002", "--context", "epic"], True),
    ("engagement-state-is-delimited", ["--document", "docs/process/ways-of-working.md"], True),
]

DOCUMENT_RULES_CLEAN = [
    ("documents-at-risk-are-enumerated", ["--item", "WI-0001"]),
    ("invalidation-set-is-disposed", ["--item", "WI-0001"]),
    ("adr-conformance-is-decided", ["--item", "WI-0001"]),
    ("engagement-state-is-restated", ["--item", "EP-001", "--context", "epic"]),
    ("engagement-state-is-restated", ["--item", "WI-0001", "--context", "work-item"]),
    ("engagement-state-is-delimited", ["--document", "docs/product/vision.md"]),
]


def _lint_documents(root: str, rule: str, extra: list):
    return subprocess.run([sys.executable, os.path.join(SCRIPTS, "lint-documents"),
                           "--root", root, "--rule", rule, *extra],
                          capture_output=True, text=True, cwd=ROOT)


def check_document_obligations(runner: Runner) -> None:
    """The eight obligations ADR-0010 marks `[auto]`, over a tree that is wrong on purpose.

    They stood in six contracts as `manual_check` — an instruction where a gate was claimed, and
    an instruction is the thing this repository exists to distrust (F-001). Codes are compared as
    an exact set against `EXPECTED-CODES.txt`, so a rule that stops firing fails the build and so
    does a rule that starts firing somewhere new.
    """
    fixture = os.path.join(ROOT, "fixtures", "document-obligations")
    expected_path = os.path.join(fixture, "EXPECTED-CODES.txt")
    if not os.path.isfile(expected_path):
        runner.skip("the document obligations (must-fail fixture)",
                    f"{expected_path} does not exist")
        return
    with open(expected_path, "r", encoding="utf-8") as handle:
        expected = {line.strip() for line in handle if line.strip()}
    found, failed = set(), []
    for rule, extra, must_report in DOCUMENT_RULES:
        result = _lint_documents(os.path.join(fixture, "wrong"), rule, extra)
        codes = codes_from(result.stdout + result.stderr)
        found |= codes
        # A rule whose only finding is a warning still exits 0; what must never happen is a rule
        # reporting nothing at all over a tree built to break it.
        if must_report and not codes:
            failed.append(f"  - {rule} {' '.join(extra)} reported nothing over the broken tree")
        if not must_report and codes:
            failed.append(f"  - {rule} {' '.join(extra)} is the control and reported "
                          f"{sorted(codes)}")
    missing = sorted(expected - found)
    extra_codes = sorted(found - expected)
    detail = list(failed)
    if missing:
        detail.append("rules that stopped firing (in EXPECTED-CODES.txt, not emitted):")
        detail += [f"  - {code}" for code in missing]
    if extra_codes:
        detail.append("codes emitted that EXPECTED-CODES.txt does not list:")
        detail += [f"  + {code}" for code in extra_codes]
    if detail:
        detail.append("if this change is intended, update EXPECTED-CODES.txt in the same commit "
                      "and say why")
        runner.emit("the document obligations (must-fail fixture)", False,
                    detail="\n".join(detail))
    else:
        runner.emit(f"the document obligations (must-fail fixture, {len(expected)} codes)", True)

    # A rule nobody can satisfy is not a rule (F-050). The same shapes, correct, must be silent.
    noisy = []
    for rule, extra in DOCUMENT_RULES_CLEAN:
        result = _lint_documents(os.path.join(fixture, "right"), rule, extra)
        if result.returncode != 0 or codes_from(result.stdout + result.stderr):
            noisy.append(f"  - {rule} {' '.join(extra)}: exit {result.returncode}")
            noisy += [f"      {line}" for line in
                      (result.stdout + result.stderr).strip().split("\n")[-6:]]
    runner.emit(f"the document obligations pass compliant work ({len(DOCUMENT_RULES_CLEAN)} rules)",
                not noisy, detail="\n".join(noisy))
    check_document_obligations_by_execution(runner)


def check_document_obligations_by_execution(runner: Runner) -> None:
    """The three obligations that read a diff, both ways, in a throwaway repository.

    A diff is not a tree, so these cannot be a fixture directory — the same reason `lint-answers`
    rule 3 and the claims window are built here rather than under `fixtures/`.

    Obligation 19 (`implement` wrote only inside the set its plan declared), obligation 7 (only
    `intake` and an ending wrote inside a delimited `## Engagement state` region) and obligation 3
    (a quantified sentence propagated into a document has an enumeration entry in the audit row).
    The must-pass half of each is the load-bearing one: an execution that edited a declared
    document, one that edited a document *around* its engagement-state section, and one whose
    enumeration is complete must all be silent, or the gate is a blocked pipeline.

    F-088 rides on the third: the enumeration's fifth part, `Falsifier:`, and the one degenerate
    case a script can decide — `Members:` naming nobody, which exits 0 **with a mark** rather
    than silently, on `scripts/lib/scope.py`'s precedent.
    """
    import shutil
    import tempfile
    label = "the document obligations by execution (F-087, F-093, F-095, F-088, 10 cases)"
    if shutil.which("git") is None:
        runner.skip(label, "git is not on PATH")
        return
    plan = ("# Plan — WI-0001\n\n## Invalidation set\n\n" + PLAN_TABLE_HEADER
            + "| `docs/product/vision.md` | the sentence naming `store.py` | cited-fact "
              "| the path changes | to-update |\n\n## Deliverable documents\n\n- none\n\n"
              "## Binding ADRs\n\n- none\n")
    vision = ("# Vision\n\nFor the person who keeps the record.\n\n## Engagement state\n\n"
              "The stakeholder has not yet been asked to accept this engagement.\n\n"
              "## What it does\n\nIt reads a directory and names `store.py` as the store.\n")
    consequences = ("---\nid: Q-001\nstatus: answered\naddressed-to: human\n"
                    "answered-by: human\n---\n\n## Answer\n\nYes — the one function.\n\n"
                    "## Consequences\n\n"
                    "- `docs/architecture/overview.md` — the rendering sentence added\n")
    enumeration = ("  - **Enumeration:** \"every adapter writes through `render_all()`\"\n"
                   "    - **Set:** the adapters under `adapters/`\n"
                   "    - **Enumerated by:** `ls -d adapters/*/` \u2192 `one/`, `two/`\n"
                   "    - **Members:** `one`, `two`\n"
                   "    - **Verdict:** both call `render_all()`; true of each\n"
                   "    - **Falsifier:** an adapter with its own `open(...).write(...)`; `two` "
                   "predates `render_all()` and is where one would be\n")
    quantified = ("\nEvery adapter writes through `render_all()`, and no caller reaches the "
                  "writer directly.\n")
    cases = []
    with tempfile.TemporaryDirectory() as base:
        repo = os.path.join(base, "repo")
        artifacts = os.path.join(repo, "tracker", "items", "WI-0001", "artifacts")
        questions = os.path.join(repo, "tracker", "items", "WI-0001", "questions")
        os.makedirs(os.path.join(repo, "docs", "product"))
        os.makedirs(os.path.join(repo, "docs", "architecture"))
        os.makedirs(artifacts)
        os.makedirs(questions)
        write(os.path.join(repo, "tracker", "project.yaml"),
              "project:\n  name: t\n  trunk-branch: main\n")
        write(os.path.join(repo, "code.py"), "x = 1\n")
        write(os.path.join(repo, "docs", "product", "vision.md"), vision)
        write(os.path.join(repo, "docs", "architecture", "overview.md"),
              "# Overview\n\nOne loader, one writer.\n")
        write(os.path.join(artifacts, "plan.md"), plan)
        write(os.path.join(questions, "Q-001.md"), consequences)

        def git(*args):
            return subprocess.run(["git", *args], cwd=repo, capture_output=True, text=True)

        git("init", "-q", "--initial-branch=main")
        git("config", "user.email", "check@example.invalid")
        git("config", "user.name", "check")
        git("add", "-A")
        git("commit", "-qm", "base")

        def branch(name):
            git("checkout", "-q", "main")
            git("branch", "-q", "-D", name)
            git("checkout", "-q", "-b", name)

        def commit():
            git("add", "-A")
            git("commit", "-qm", "work")

        def run(rule, *extra):
            return _lint_documents(repo, rule, ["--changed-since", "main", *extra])

        # ---- obligation 19: a document written that the plan does not name -----------------
        branch("wi/undeclared")
        write(os.path.join(repo, "docs", "architecture", "overview.md"),
              "# Overview\n\nOne loader, one writer, and a new paragraph.\n")
        commit()
        found = run("document-writes-are-declared", "--item", "WI-0001")
        cases.append(("a document written on the branch that the plan names nowhere is refused",
                      found.returncode != 0
                      and "document.write.undeclared" in codes_from(found.stdout + found.stderr),
                      found))

        # And the direction that must stay open: the declared document, edited.
        branch("wi/declared")
        write(os.path.join(repo, "docs", "product", "vision.md"),
              vision.replace("It reads a directory", "It reads one directory"))
        commit()
        clean = run("document-writes-are-declared", "--item", "WI-0001")
        cases.append(("editing the document the plan declared is not a finding",
                      clean.returncode == 0
                      and not codes_from(clean.stdout + clean.stderr), clean))

        # ---- obligation 7: the delimited region ------------------------------------------
        cases.append(("editing a document around its Engagement state section is not a finding",
                      run("engagement-state-is-left-to-the-ending").returncode == 0,
                      run("engagement-state-is-left-to-the-ending")))
        branch("wi/k8")
        write(os.path.join(repo, "docs", "product", "vision.md"),
              vision.replace("has not yet been asked to accept this engagement",
                             "has accepted this engagement"))
        commit()
        written = run("engagement-state-is-left-to-the-ending")
        cases.append(("writing inside a delimited Engagement state section is refused (F-093)",
                      written.returncode != 0
                      and "document.engagement-state.written" in codes_from(written.stdout
                                                                            + written.stderr),
                      written))

        # The same edit, made by an execution holding an `owned-by-ending` entry, is refused by
        # `implement`'s gate too — the disposition is permission to record it, never to fix it.
        owned = _lint_documents(
            repo, "document-writes-are-declared",
            ["--changed-since", "main", "--item", "WI-0001"])
        write(os.path.join(artifacts, "plan.md"),
              plan.replace("| cited-fact | the path changes | to-update |",
                           "| engagement-state | the ending falsifies it | owned-by-ending |"))
        commit()
        owned = _lint_documents(repo, "document-writes-are-declared",
                                ["--changed-since", "main", "--item", "WI-0001"])
        cases.append(("an entry disposed owned-by-ending may be recorded and not edited",
                      owned.returncode != 0
                      and "document.engagement-state.written" in codes_from(owned.stdout
                                                                            + owned.stderr),
                      owned))

        # ---- obligation 3: the enumeration a quantified claim owes ------------------------
        branch("wi/quantified")
        write(os.path.join(repo, "docs", "architecture", "overview.md"),
              "# Overview\n\nOne loader, one writer.\n" + quantified)
        commit()
        bare = run("propagated-claims-carry-their-obligation", "--item", "WI-0001")
        cases.append(("a quantified sentence propagated with no enumeration is refused (F-095)",
                      bare.returncode != 0
                      and "document.enumeration.missing" in codes_from(bare.stdout
                                                                       + bare.stderr), bare))
        write(os.path.join(questions, "Q-001.md"),
              consequences + "".join(enumeration.split("\n")[:3]) + "\n")
        commit()
        partial = run("propagated-claims-carry-their-obligation", "--item", "WI-0001")
        cases.append(("an enumeration missing its members and its verdict is refused",
                      partial.returncode != 0
                      and "document.enumeration.incomplete" in codes_from(partial.stdout
                                                                          + partial.stderr),
                      partial))
        # ---- F-088: the example has to be able to fail ------------------------------------
        # The four old parts, with no `Falsifier:`. This is the shape every enumeration in the
        # repository had before this unit, so the case is the finding: an audit row that records
        # what was opened and never says why opening it could have produced a `false`.
        no_falsifier = "".join(line + "\n" for line in enumeration.split("\n")[:5] if line)
        write(os.path.join(questions, "Q-001.md"), consequences + no_falsifier)
        commit()
        unfalsifiable = run("propagated-claims-carry-their-obligation", "--item", "WI-0001")
        cases.append(("an enumeration that never says why the example could have failed is "
                      "refused (F-088)",
                      unfalsifiable.returncode != 0
                      and "document.enumeration.incomplete" in codes_from(unfalsifiable.stdout
                                                                          + unfalsifiable.stderr)
                      and "falsifier" in (unfalsifiable.stdout + unfalsifiable.stderr),
                      unfalsifiable))

        write(os.path.join(questions, "Q-001.md"), consequences + enumeration)
        commit()
        complete = run("propagated-claims-carry-their-obligation", "--item", "WI-0001")
        cases.append(("a complete enumeration discharges the claim",
                      complete.returncode == 0
                      and not codes_from(complete.stdout + complete.stderr), complete))

        # An enumeration over nobody: `scope.py`'s fourth state reached through the example. It
        # exits 0 — a genuinely empty family makes the sentence vacuously true — and it is MARKED,
        # because a pass that could not have failed is not spelled like one.
        empty = enumeration.replace("- **Members:** `one`, `two`", "- **Members:** none")
        write(os.path.join(questions, "Q-001.md"), consequences + empty)
        commit()
        vacuous = run("propagated-claims-carry-their-obligation", "--item", "WI-0001")
        output = vacuous.stdout + vacuous.stderr
        cases.append(("an enumeration naming no member passes with a mark, never silently "
                      "(F-088, scope.py's fourth state)",
                      vacuous.returncode == 0
                      and "document.enumeration.vacuous" in codes_from(output)
                      and "WARNING" in output, vacuous))

    failed = [(name, result) for name, ok, result in cases if not ok]
    if failed:
        detail = []
        for name, result in failed:
            detail.append(f"  - {name}: exit {result.returncode}")
            detail += [f"      {line}" for line in
                       (result.stdout + result.stderr).strip().split("\n")[-8:]]
        runner.emit(label, False, detail="\n".join(detail))
    else:
        runner.emit(label, True)

def check_accepted_gaps(runner: Runner) -> None:
    """F-090, both ways: a gap the orchestrator can act on, and every gap it cannot.

    The finding is not that a reviewer forgot to write something down. It is that the thing they
    wrote down was **unreachable**: `pipeline.yaml`'s orchestrator dispatches on open questions
    (steps 3-4) and on item status (step 5), so a remedy recorded in `review.md` or in the item's
    `## Notes` names an owner nothing will ever run. One engagement recorded exactly that, two
    executions passed over it, and it survived only because a later verification volunteered a
    question nobody required.

    So the cases here are about **reachability**, not shape, and the two that matter most are the
    ones where the row is well formed and still inert:

      * a gap owned by `implement` disposed to a question - the question exists, resolves, and
        dispatches `answer-questions` and nothing else;
      * a gap owned by `retro` disposed to an item - the item exists, and no status is owned by
        `retro`, so the board will never dispatch it.

    Both sets are read off `pipeline.yaml` by the rule itself. The assertion below re-derives them
    here from the same file, so that a change to the pipeline moves the expectation and a change
    to the rule's *reading* of the pipeline fails.

    **This step is the rule's whole coverage, and that is measured rather than assumed.** Every
    one of the 18 `review.md` files in `examples/` and `fixtures/` sits on an item that is
    already `done`, so the rule reports NOT APPLICABLE on all of them. Unscoped it refuses all
    18, six of them inside the must-pass `examples/toy-project` — free-prose gap sections written
    before the convention existed. The scope is not a convenience: the obligation is discharged
    at acceptance, and re-asking it of a closed item invalidates banked evidence retroactively.
    """
    import shutil
    import tempfile
    label = "an accepted gap the orchestrator can act on (F-090)"
    pipeline = os.path.join(ROOT, "methodology", "pipeline.yaml")
    if not os.path.isfile(pipeline):
        runner.skip(label, "methodology/pipeline.yaml does not exist")
        return
    sys.path.insert(0, os.path.join(SCRIPTS, "lib"))
    import miniyaml
    model = miniyaml.load_file(pipeline)
    statuses = {entry["name"]: entry for entry in model["statuses"]}
    suspended = {row.get("to") for row in model["transitions"]
                 if row.get("from") == "any-suspendable" and row.get("to") in statuses}
    by_question = {statuses[name].get("owner") for name in suspended if statuses[name].get("owner")}
    by_board = {entry.get("owner") for entry in statuses.values() if entry.get("owner")}
    unreachable = sorted(set(model["skills"]) - by_question - by_board)

    problems, observations = [], 0

    def note(ok, what):
        nonlocal observations
        observations += 1
        if not ok:
            problems.append(f"  - {what}")

    note(by_question == {"answer-questions"},
         "a question should dispatch answer-questions and nothing else; pipeline.yaml says "
         + ", ".join(sorted(by_question)))
    note(unreachable == ["intake", "next", "retro"],
         "the skills no accepted gap can reach should be intake, next and retro; got "
         + ", ".join(unreachable))

    header = "| gap | owner | disposition |\n|---|---|---|\n"

    def review(rows):
        return "# Review — WI-0001\n\n## Accepted gaps\n\n" + header + rows

    with tempfile.TemporaryDirectory() as base:
        root = os.path.join(base, "ws")
        artifacts = os.path.join(root, "tracker", "items", "WI-0001", "artifacts")
        questions = os.path.join(root, "tracker", "items", "WI-0001", "questions")
        os.makedirs(artifacts)
        os.makedirs(questions)
        os.makedirs(os.path.join(root, "tracker", "items", "WI-0002"))
        write(os.path.join(root, "tracker", "project.yaml"),
              "project:\n  name: t\n  trunk-branch: main\n")
        write(os.path.join(questions, "Q-001.md"),
              "---\nid: Q-001\nstatus: open\n---\n\n## Answer\n\n## Consequences\n")
        write(os.path.join(root, "tracker", "items", "WI-0002", "item.md"),
              "---\nid: WI-0002\ntype: work-item\nstatus: draft\n---\n")

        def item(status):
            write(os.path.join(root, "tracker", "items", "WI-0001", "item.md"),
                  f"---\nid: WI-0001\ntype: work-item\nstatus: {status}\n---\n\n## Story\n")

        def run():
            return _lint_documents(root, "accepted-gaps-are-dispatchable", ["--item", "WI-0001"])

        item("in-review")

        def case(rows, expect_code, what):
            write(os.path.join(artifacts, "review.md"), review(rows))
            result = run()
            found = codes_from(result.stdout + result.stderr)
            if expect_code is None:
                note(result.returncode == 0 and not found,
                     f"{what}: expected silence, got exit {result.returncode} "
                     f"{', '.join(sorted(found)) or '(no code)'}")
            else:
                note(result.returncode != 0 and expect_code in found,
                     f"{what}: expected {expect_code}, got exit {result.returncode} "
                     f"{', '.join(sorted(found)) or '(no code)'}")
            return result

        # The finding, verbatim: the remedy belongs to a skill, and it is written down and
        # nowhere else.
        case("| AC12's amendment is not propagated | `answer-questions` | no-owner |\n",
             "document.gaps.inert",
             "a gap naming an owner and disposed no-owner")
        # Reachability, both halves — well-formed rows that still put nobody to work.
        case("| the renderer is untested | `implement` | question-filed: WI-0001/Q-001 |\n",
             "document.gaps.undispatchable",
             "a gap owned by implement, filed as a question")
        case("| the floor is asserted | `retro` | item-filed: WI-0002 |\n",
             "document.gaps.undispatchable",
             "a gap owned by retro, put on the board")
        # A disposition that names nothing that exists is the appearance of a remedy.
        case("| the renderer is untested | `answer-questions` | question-filed: WI-0001/Q-009 |\n",
             "document.gaps.unresolved",
             "a question-filed disposition naming no question")
        case("| the floor is asserted | `implement` | item-filed: WI-0009 |\n",
             "document.gaps.unresolved",
             "an item-filed disposition naming no item")
        case("| the renderer is untested | `implement` | later |\n",
             "document.gaps.disposition.unknown",
             "a disposition outside the alphabet")
        case("| the renderer is untested | somebody | item-filed: WI-0002 |\n",
             "document.gaps.owner.unknown",
             "an owner who is neither a skill, an item, the human nor nobody")

        # The must-pass half, and it is the load-bearing one: a review that did the right thing
        # in each of the three legal ways must be silent, or the gate blocks correct work.
        case("| AC12's amendment | `answer-questions` | question-filed: WI-0001/Q-001 |\n"
             "| the renderer is untested | `implement` | item-filed: WI-0002 |\n"
             "| aged by the target's mtime | none | no-owner |\n",
             None, "the three legal dispositions together")
        case("| none | none | no-owner |\n", None, "no gaps, said in a row")

        # The finding's own historical shape: free prose naming a skill, in the section, with no
        # row and no disposition. That is what every banked `## Accepted gaps` looks like, and it
        # is the thing nothing dispatches.
        write(os.path.join(artifacts, "review.md"),
              "# Review — WI-0001\n\n## Accepted gaps\n\n"
              "The renderer is untested; `implement` will get to it.\n")
        prose = run()
        note(prose.returncode != 0
             and "document.gaps.empty" in codes_from(prose.stdout + prose.stderr),
             "a gap written as prose naming a skill should be refused — that is the shape "
             "F-090 was filed against")

        write(os.path.join(artifacts, "review.md"),
              "# Review — WI-0001\n\n## Accepted gaps\n\n| gap | owner |\n|---|---|\n"
              "| the renderer is untested | `implement` |\n")
        short = run()
        note(short.returncode != 0
             and "document.gaps.row.malformed" in codes_from(short.stdout + short.stderr),
             "a row with an owner and no disposition should be refused")

        # Absent is not empty — the same answer `documents-at-risk-are-enumerated` gives.
        write(os.path.join(artifacts, "review.md"), "# Review — WI-0001\n\n## Verdict\n\nok\n")
        missing = run()
        note(missing.returncode != 0
             and "document.gaps.section.missing" in codes_from(missing.stdout + missing.stderr),
             "a review with no Accepted gaps section at all should be refused")

        # The scope, measured before it was chosen: at `done` the obligation is discharged and
        # the review is history. Without this boundary the rule reports on every closed item in
        # every banked workspace, which is imported real-run evidence (F-084's lesson).
        write(os.path.join(artifacts, "review.md"),
              review("| the renderer is untested | `implement` | question-filed: WI-0001/Q-001 |\n"))
        item("in-review")
        live = run()
        item("done")
        closed = run()
        note(live.returncode != 0 and closed.returncode == 0
             and "NOT APPLICABLE" in (closed.stdout + closed.stderr),
             "the same review should be refused at in-review and reported NOT APPLICABLE at "
             "done — and say so in those words, never as a pass")

    runner.emit(f"{label} ({observations} observations)", not problems,
                detail="\n".join(problems))


def check_adr_correction(runner: Runner) -> None:
    """F-067's instance, both ways: the defect exists, and the legal repair clears it.

    Iteration 4's `lint-claims --all` found three `claim.unsourced` errors in an accepted ADR.
    The reviewer read all three against the code and found them **true**, and then found there
    was no move that cleared them: adding a citation is an edit, and the only repair the spec
    knew was supersession. `fixtures/adr-correction/` is that ADR reduced — `before/` as it
    stood, `after/` repaired through `doc-header.md` §4b.

    Both halves are asserted. If `before/` ever comes back clean the fixture has drifted and the
    repair proves nothing; if `after/` is not clean, the path this spec now advertises does not
    actually work.
    """
    linter = os.path.join(SCRIPTS, "lint-claims")
    fixture = os.path.join(ROOT, "fixtures", "adr-correction")
    if not os.path.isdir(fixture):
        runner.skip("the legal repair for a standing ADR (F-067)",
                    "fixtures/adr-correction does not exist")
        return
    before = subprocess.run([sys.executable, linter, "--root", os.path.join(fixture, "before"),
                             "--all"], capture_output=True, text=True, cwd=ROOT)
    codes = codes_from(before.stdout + before.stderr)
    unsourced = (before.stdout + before.stderr).count("claim.unsourced")
    if before.returncode == 0 or "claim.unsourced" not in codes or unsourced < 3:
        runner.emit("the legal repair for a standing ADR (F-067)", False, before,
                    detail="  fixtures/adr-correction/before must reproduce the three "
                           "true-but-unsourced absolutes the instance had; it did not")
        return
    after = subprocess.run([sys.executable, linter, "--root", os.path.join(fixture, "after"),
                            "--all"], capture_output=True, text=True, cwd=ROOT)
    if after.returncode != 0:
        runner.emit("the legal repair for a standing ADR (F-067)", False, after,
                    detail="  the repair doc-header.md §4b authorises does not clear the "
                           "finding it exists to clear")
        return
    runner.emit("the legal repair for a standing ADR (F-067, before and after)", True)
    check_superseded_adr(runner)


def check_superseded_adr(runner: Runner) -> None:
    """F-069: the repair rule is about the act, not the state.

    Two assertions the fixtures cannot make on their own, because both live inside
    `examples/toy-project`'s `ADR-0010` — an ADR corrected while it was current and superseded
    afterwards, which is the shape that had no valid state to be in:

    * `validate-workspace` accepts it (the corrections predate the supersession) — covered by the
      must-pass workspace step, and asserted here on the code so a silent rule change is loud;
    * `lint-claims --all` does not read its absolute claim, and **says** how many documents it
      skipped. An exemption nobody is told about is F-033's failure wearing a different hat.
    """
    label = "a superseded ADR keeps its corrections and is not read for absolutes (F-069)"
    example = os.path.join(ROOT, "examples", "toy-project")
    adr = os.path.join(example, "docs", "architecture", "adr",
                       "ADR-0010-counting-lines-with-a-generator.md")
    if not os.path.isfile(adr):
        runner.skip(label, "examples/toy-project has no superseded-and-corrected ADR")
        return
    result = subprocess.run([sys.executable, os.path.join(SCRIPTS, "lint-claims"),
                             "--root", example, "--all"], capture_output=True, text=True)
    output = result.stdout + result.stderr
    problems = []
    if "ADR-0010-counting-lines-with-a-generator.md" in output.replace(
            "rule 2 skipped 1 superseded document(s) — "
            "docs/architecture/adr/ADR-0010-counting-lines-with-a-generator.md", ""):
        problems.append("  rule 2 read a superseded document, which has no legal way to gain a "
                        "citation")
    if "rule 2 skipped" not in output:
        problems.append("  the exemption was applied without saying so — an exemption nobody is "
                        "told about is a gate that examined less than the reader thinks")
    validation = subprocess.run([sys.executable, os.path.join(SCRIPTS, "validate-workspace"),
                                 example], capture_output=True, text=True)
    if "adr.correction.superseded" in (validation.stdout + validation.stderr):
        problems.append("  an ADR corrected while it was current is refused after it is "
                        "superseded — the rule is testing the state again, not the act")
    runner.emit(label, not problems, detail="\n".join(problems))


# fixtures/ended-engagement: one epic per verdict the termination gate has to reach.
# (epic, extra args, must the gate pass?, what the case is)
TERMINATION_CASES = [
    ("EP-001", [], True, "the impasse ending, with every child named"),
    ("EP-002", [], False, "a statement that omits the bug the pipeline filed (F-046)"),
    ("EP-003", [], False, "an engagement nobody was ever asked about (F-045)"),
    ("EP-004", [], False, "closing on a deferred acknowledgment"),
    ("EP-004", ["--resolving", "EP-004:open->blocked"], True,
     "parking at the impasse on a deferred acknowledgment"),
    ("EP-006", [], False,
     "a complete, correct sign-off in an engagement where nobody asked an open question (F-064, "
     "DE8)"),
]
REST_VERDICTS = {"EP-001": "at-rest", "EP-002": "at-rest", "EP-003": "at-rest",
                 "EP-004": "at-rest", "EP-005": "active", "EP-006": "at-rest"}


def check_signoff(runner: Runner) -> None:
    """DE7 both ways: an epic with no usable sign-off is refused, one with a real one passes."""
    gate = os.path.join(SCRIPTS, "check-epic-signoff")
    broken = os.path.join(ROOT, "fixtures", "broken-workspace")
    clean = os.path.join(ROOT, "fixtures", "signed-off-epic")
    if not os.path.isfile(gate) or not os.path.isdir(clean):
        runner.skip("epic sign-off gate", "scripts/check-epic-signoff or its fixtures are absent")
        return
    runner.run("epic sign-off gate refuses an unaccepted epic",
               [sys.executable, gate, "EP-001", "--root", broken], expect_zero=False)
    runner.run("epic sign-off gate",
               [sys.executable, gate, "EP-001", "--root", clean])


def check_termination(runner: Runner) -> None:
    """The termination gate at each of the four verdicts, and rest at both of its own.

    Every epic in the fixture is a contradiction a real run produced. EP-003 is the one that
    matters most: an engagement that is over, with nobody ever asked. That is exactly where a run
    stopped — printed a board and called it a day — while the stakeholder was waiting to be asked
    and afterwards wrote down that the question never came (F-045).
    """
    gate = os.path.join(SCRIPTS, "check-epic-signoff")
    rest = os.path.join(SCRIPTS, "engagement-state")
    root = os.path.join(ROOT, "fixtures", "ended-engagement")
    if not os.path.isfile(gate) or not os.path.isfile(rest) or not os.path.isdir(root):
        runner.skip("the termination gate at every ending",
                    "the gate, engagement-state, or fixtures/ended-engagement is absent")
        return
    problems = []
    for epic, extra, should_pass, what in TERMINATION_CASES:
        result = subprocess.run([sys.executable, gate, epic, "--root", root] + extra,
                                capture_output=True, text=True, cwd=ROOT)
        ok = (result.returncode == 0) if should_pass else (result.returncode != 0)
        if not ok:
            problems.append(f"{epic} — {what}: expected "
                            + ("PASS" if should_pass else "FAIL")
                            + f", exited {result.returncode}\n      "
                            + (result.stdout + result.stderr).strip().split("\n")[0])
    for epic, verdict in sorted(REST_VERDICTS.items()):
        result = subprocess.run([sys.executable, rest, epic, "--root", root],
                                capture_output=True, text=True, cwd=ROOT)
        expected = f"engagement-state: {epic} {verdict}"
        if expected not in result.stdout:
            problems.append(f"{epic}: expected {verdict!r}\n      "
                            + (result.stdout + result.stderr).strip().split("\n")[0])
    if problems:
        runner.emit("the termination gate at every ending", False,
                    detail="\n".join(f"  - {problem}" for problem in problems))
        return
    runner.emit(f"the termination gate at every ending "
                f"({len(TERMINATION_CASES)} verdicts, {len(REST_VERDICTS)} rest checks)", True)


# fixtures/abandoned-engagement/right: what an E4-by-silence ending looks like when it is done.
# (epic, must the gate pass?, what the case is)
ABANDONED_CASES = [
    ("EP-001", True,
     "the silence began before rest: no sign-off was ever filed, and all five of §3.5a's child "
     "classes are present"),
    ("EP-002", True,
     "the silence began after rest: a sign-off exists, is 'abandoned', and its '## Answer' is "
     "empty"),
    ("EP-003", False,
     "the moment before the declaration: engagement-state says 'abandoned' and review-close has "
     "not run, so there is no '## Ending statement' to accept"),
]
ABANDONED_VERDICTS = {"EP-001": "ended", "EP-002": "ended", "EP-003": "abandoned"}
# The orphans, and the two things about them that no rule anywhere can see: the greppable
# prefix, and the absence of an outcome. `item.outcome.premature` catches the second only
# because `blocked` is not `done`; nothing at all catches the first.
ABANDONED_ORPHANS = {
    "WI-0003": "in-progress",
    "WI-0004": "awaiting-answer",
    "WI-0005": "draft",
}
# The near misses. The first and the last are refused by the termination gate. The middle two
# are NOT — they are refused by `workspace-valid`, which is a hard gate on `review-close`, so
# the ending cannot be recorded either way. Where the gate is not the arbiter, this table says
# so rather than implying a coverage it does not have.
ABANDONED_NEAR_MISSES = [
    ("EP-001", False, "", "one round short of the threshold"),
    ("EP-002", True, "",
     "an orphan carrying an 'outcome' — the termination gate does not read outcomes, so it "
     "passes; validate-workspace reports item.outcome.premature and review-close's own "
     "workspace-valid gate refuses the move. If this now FAILs the gate has grown a branch, "
     "which is an improvement: update this table and say so"),
    ("EP-003", True, "",
     "a sign-off marked 'answered' with an empty '## Answer' — E4 wearing E3's clothes. The "
     "gate's E4 branch inspects sign-offs at 'open' and 'abandoned' only, so it passes; "
     "validate-workspace reports question.answered.section. If this now FAILs the gate has "
     "grown a branch: update this table and say so"),
    ("EP-004", False, "WI-0005", "an ending statement that omits a child (F-046)"),
]


def check_abandoned(runner: Runner) -> None:
    """E4 by silence, end to end — and the near misses that must not be allowed to be it.

    ADR-0011 derived the ending; `spec/ids-and-statuses.md` §3.5a states it; step 14b proved the
    threshold has one source. What none of those proves is an actual **ending**: a workspace in
    which the pipeline came to a person, got nothing, and closed the engagement honestly. That is
    what `fixtures/abandoned-engagement/right` is, and it is a **valid workspace** — the
    validator is run over it, because a fixture that passes only where nothing looks is worth
    nothing.

    The three epics are the three states the mechanism has to reach: the ending declared where
    the silence began before rest (no sign-off, orphans of both kinds), the ending declared where
    it began after rest (a sign-off, `abandoned`, empty), and the moment **before** the
    declaration, where `engagement-state` says `abandoned` and `review-close` has not yet run.

    The digests are computed, never typed: EP-003 has not moved since its last halt, so the
    trailing row's `inbound` must equal the digest recomputed from the workspace now. If it does
    not, the log is asserting something about a stakeholder that never happened.
    """
    sys.path.insert(0, os.path.join(SCRIPTS, "lib"))
    try:
        import engagement as engagement_lib
        from workspace import Workspace
    except ImportError as exc:                       # pragma: no cover - the library is step 1
        runner.skip("the abandoned ending, end to end", f"scripts/lib is unusable: {exc}")
        return
    fixture = os.path.join(ROOT, "fixtures", "abandoned-engagement")
    right, wrong = os.path.join(fixture, "right"), os.path.join(fixture, "wrong")
    expected_path = os.path.join(fixture, "EXPECTED-CODES.txt")
    validator = os.path.join(SCRIPTS, "validate-workspace")
    gate = os.path.join(SCRIPTS, "check-epic-signoff")
    state = os.path.join(SCRIPTS, "engagement-state")
    if not os.path.isdir(right) or not os.path.isdir(wrong) \
            or not os.path.isfile(expected_path):
        runner.skip("the abandoned ending, end to end",
                    "fixtures/abandoned-engagement is absent or incomplete")
        return

    problems, observations = [], 0

    def observe(condition, complaint):
        nonlocal observations
        observations += 1
        if not condition:
            problems.append(complaint)

    def run(argv):
        return subprocess.run(argv, capture_output=True, text=True, cwd=ROOT)

    # --- the must-pass half is a workspace, not just a tree the gate happens to accept -------
    validation = run([sys.executable, validator, right])
    observe(validation.returncode == 0,
            "fixtures/abandoned-engagement/right does not validate:\n      "
            + (validation.stdout + validation.stderr).strip().replace("\n", "\n      "))

    for epic, should_pass, what in ABANDONED_CASES:
        result = run([sys.executable, gate, epic, "--root", right])
        ok = (result.returncode == 0) if should_pass else (result.returncode != 0)
        observe(ok, f"{epic} — {what}: expected the termination gate to "
                    + ("PASS" if should_pass else "FAIL")
                    + f", it exited {result.returncode}\n      "
                    + (result.stdout + result.stderr).strip().split("\n")[0])
    for epic, verdict in sorted(ABANDONED_VERDICTS.items()):
        result = run([sys.executable, state, epic, "--root", right])
        observe(f"engagement-state: {epic} {verdict}" in result.stdout,
                f"{epic}: expected the verdict {verdict!r}\n      "
                + (result.stdout + result.stderr).strip().split("\n")[0])

    # --- the log's evidence is real ---------------------------------------------------------
    workspace = Workspace(right).load()
    rows = engagement_lib.read_waiting_log(right, "EP-003")
    recomputed = engagement_lib.inbound_digest(workspace, workspace.items["EP-003"])
    observe(bool(rows) and rows[-1].inbound == recomputed,
            f"EP-003's waiting log ends at inbound {rows[-1].inbound if rows else '(no rows)'} "
            f"while the workspace's inbound state digests to {recomputed}. Nothing has moved "
            f"since that halt, so the two must agree — a digest that was typed rather than "
            f"computed makes the log assert a silence that did not happen "
            f"(spec/workspace-layout.md §1.4)")
    observe(engagement_lib.silent_rounds(rows) == 3,
            f"EP-003's trailing run is {engagement_lib.silent_rounds(rows)}, not 3")
    first = engagement_lib.read_waiting_log(right, "EP-001")
    observe(len(first) == 4 and engagement_lib.silent_rounds(first) == 3
            and first[0].inbound != first[1].inbound,
            f"EP-001's log should hold four rows whose trailing run is three, with the "
            f"stakeholder's one answer visible as a digest change between rows 1 and 2 — the "
            f"thing that makes a reset auditable rather than remembered (ADR-0011 §1.2). It "
            f"holds {len(first)} rows with a trailing run of "
            f"{engagement_lib.silent_rounds(first)}")

    # --- what happened to each orphan. Neither half of this is checked by any rule ----------
    for identifier, suspended_from in sorted(ABANDONED_ORPHANS.items()):
        item = workspace.items.get(identifier)
        if item is None:
            observe(False, f"{identifier} is not in the fixture")
            continue
        observe(item.status == "blocked" and item.fields.get("outcome") is None,
                f"{identifier} is an orphan: it must be at 'blocked' with NO outcome at all — "
                f"one at 'blocked' carrying one is invalid and one pushed to 'done' to carry "
                f"one claims its work concluded (spec/ids-and-statuses.md §3.5a). It is "
                f"{item.status!r} with outcome {item.fields.get('outcome')!r}")
        last = item.history[-1] if item.history else None
        observe(last is not None and last.reason.startswith("orphaned by E4:")
                and last.actor == "review-close"
                and last.normalised(last.from_status) == suspended_from,
                f"{identifier}'s last history row must be {suspended_from} → blocked by "
                f"review-close with a reason beginning 'orphaned by E4:' — the greppable prefix "
                f"is the only thing distinguishing an orphan from an item blocked on its own "
                f"impasse, and nothing anywhere checks it")

    # --- the must-fail half ------------------------------------------------------------------
    broken = run([sys.executable, validator, wrong])
    actual = sorted(ordered_codes(broken.stdout + broken.stderr))
    with open(expected_path, "r", encoding="utf-8") as handle:
        expected = sorted(line.strip() for line in handle if line.strip())
    if actual != expected:
        missing = sorted(_multiset_difference(expected, actual))
        surplus = sorted(_multiset_difference(actual, expected))
        detail = []
        if missing:
            detail.append("rules that stopped firing (or fire fewer times):")
            detail += [f"    - {code}" for code in missing]
        if surplus:
            detail.append("codes emitted that EXPECTED-CODES.txt does not account for:")
            detail += [f"    + {code}" for code in surplus]
        detail.append("if this change is intended, update EXPECTED-CODES.txt in the same commit "
                      "and say why")
        problems.append("\n      ".join(detail))
    observations += 1

    for epic, should_pass, must_name, what in ABANDONED_NEAR_MISSES:
        result = run([sys.executable, gate, epic, "--root", wrong])
        output = result.stdout + result.stderr
        ok = (result.returncode == 0) if should_pass else (result.returncode != 0)
        observe(ok, f"wrong/{epic} — {what}: expected the termination gate to "
                    + ("PASS" if should_pass else "FAIL")
                    + f", it exited {result.returncode}\n      "
                    + output.strip().split("\n")[0])
        if must_name:
            observe(must_name in output,
                    f"wrong/{epic}'s refusal does not name {must_name}; a gate that refuses "
                    f"without saying which child was left out cannot be acted on")

    # `workspace-valid` is a HARD gate on review-close, so it is what actually stops the two
    # near misses the termination gate cannot see. Run it, rather than asserting it.
    runner_gate = os.path.join(SCRIPTS, "run-gate")
    for root, epic, should_pass in ((wrong, "EP-002", False), (right, "EP-001", True)):
        result = run([sys.executable, runner_gate, "--skill", "review-close", "--item", epic,
                      "--gate", "workspace-valid", "--root", root])
        ok = (result.returncode == 0) if should_pass else (result.returncode != 0)
        observe(ok, f"review-close's own 'workspace-valid' hard gate over "
                    f"{os.path.basename(root)}/: expected "
                    + ("PASS" if should_pass else "FAIL")
                    + f", it exited {result.returncode}")

    label = f"the abandoned ending, end to end ({observations} observations, {len(expected)} codes)"
    if problems:
        runner.emit("the abandoned ending, end to end", False,
                    detail="\n".join(f"  - {problem}" for problem in problems))
        return
    runner.emit(label, True)

# Each entry: a label, an edit to methodology/pipeline.yaml, and the finding code lint-skills
# must report. Every one of these is a defect a real run found, restated as an invariant — the
# point of the step is that flipping the rule back reproduces the finding.
PIPELINE_FAULTS = [
    ("an epic ending that is not gated (F-045)",
     ("    actor: review-close\n    applies_to: [epic]\n    gated: true\n"
      "    resume_to: required\n",
      "    actor: review-close\n    applies_to: [epic]\n"
      "    resume_to: required\n"),
     "transition.ending.ungated"),
    ("an epic ending any skill may make (ADR-0006 §2)",
     ("  - from: open\n    to: blocked\n    actor: review-close\n",
      "  - from: open\n    to: blocked\n    actor: any\n"),
     "transition.ending.actor"),
    ("a creation row with no provenance (F-029)",
     ("    provenance: The question whose answer widened the scope, as arose-from ITEM/Q-###.\n",
      ""),
     "transition.creation.provenance"),
    ("a transition scoped to an item type that does not exist",
     ("    to: draft\n    actor: refine\n    applies_to: [work-item]\n",
      "    to: draft\n    actor: refine\n    applies_to: [work-itme]\n"),
     "transition.applies_to.unknown"),
    # F-050, in both directions. The registry exists so that "which item types does this rule
    # apply to" is a question a program answers; these two faults are the question being asked.
    ("a status rule scoped wider than the moves that satisfy it (F-050)",
     ("  - code: question.deferred.not-blocked\n    applies_to: [work-item, bug]\n",
      "  - code: question.deferred.not-blocked\n    applies_to: [work-item, bug, epic]\n"),
     "obligation.applies_to.mismatch"),
    ("a status rule whose transition no row provides (F-050)",
     ("  - from: awaiting-answer\n    to: blocked\n    actor: answer-questions\n"
      "    applies_to: [work-item, bug]\n",
      "  - from: awaiting-answer\n    to: blocked\n    actor: refine\n"
      "    applies_to: [work-item, bug]\n"),
     "obligation.unsatisfiable"),
    # The registry's second shape, added for the obligation many moves satisfy. Removing
    # review-close's route out of `awaiting-answer` strands an orphan suspended there — the hole
    # ADR-0011 found by derivation, and the reason the shape grew rather than the truth bending.
    ("a rule many moves satisfy, with one status stranded (F-050, ADR-0011 §5)",
     ("  - from: awaiting-answer\n    to: blocked\n    actor: review-close\n",
      "  - from: awaiting-answer\n    to: blocked\n    actor: answer-questions\n"),
     "obligation.unsatisfiable"),
    ("an epic that cannot be suspended (F-013)",
     ("  - name: open\n    applies_to: [epic]\n    owner: null\n    terminal: true\n"
      "    suspendable: true\n",
      "  - name: open\n    applies_to: [epic]\n    owner: null\n    terminal: true\n"
      "    suspendable: false\n"),
     "pipeline.status.unsuspendable"),
]


def check_pipeline_faults(runner: Runner) -> None:
    """Every pipeline invariant, proven to fire by reintroducing the defect it came from.

    lint-skills has no fixture directory of its own: it lints `methodology/`, and there is one
    of those. So the step copies the tree, injects one fault at a time, and asserts the expected
    code comes back — which is the same bargain `fixtures/broken-workspace` strikes for the
    workspace validator. A rule nobody has watched fail is a rule nobody knows works.
    """
    import shutil
    import tempfile
    linter = os.path.join(SCRIPTS, "lint-skills")
    source = os.path.join(ROOT, "methodology", "pipeline.yaml")
    if not os.path.isfile(linter) or not os.path.isfile(source):
        runner.skip("pipeline invariants refuse each injected fault",
                    "scripts/lint-skills or methodology/pipeline.yaml is absent")
        return
    with open(source, "r", encoding="utf-8") as handle:
        original = handle.read()
    problems = []
    with tempfile.TemporaryDirectory() as base:
        root = os.path.join(base, "tree")
        os.makedirs(root)
        for name in ("methodology", "spec"):
            shutil.copytree(os.path.join(ROOT, name), os.path.join(root, name))
        target = os.path.join(root, "methodology", "pipeline.yaml")
        for label, (find, replace), code in PIPELINE_FAULTS:
            if find not in original:
                problems.append(f"{label}: the text this fault edits is no longer in "
                                f"pipeline.yaml — the fault, not the rule, is stale")
                continue
            with open(target, "w", encoding="utf-8") as handle:
                handle.write(original.replace(find, replace, 1))
            result = subprocess.run([sys.executable, linter, root],
                                    capture_output=True, text=True, cwd=ROOT)
            if result.returncode == 0:
                problems.append(f"{label}: lint-skills passed; expected [{code}]")
            elif f"[{code}]" not in result.stdout:
                problems.append(f"{label}: lint-skills failed without reporting [{code}]")
    if problems:
        runner.emit("pipeline invariants refuse each injected fault", False,
                    detail="\n".join(f"  - {problem}" for problem in problems))
        return
    runner.emit(f"pipeline invariants refuse each injected fault "
                f"({len(PIPELINE_FAULTS)} faults)", True)


def check_obligation_binding(runner: Runner) -> None:
    """The validator's status rules are bound to the registry, not merely described by it.

    `rule_obligations` is only worth having if dropping an entry breaks something. So: rename the
    obligation `question.deferred.not-blocked` depends on, point the validator at that pipeline,
    and require it to refuse. Without this the registry could rot into a comment while the rule
    it is supposed to scope carried on deciding its own scope — which is the state F-050 was
    filed against.
    """
    import tempfile
    validator = os.path.join(SCRIPTS, "validate-workspace")
    source = os.path.join(ROOT, "methodology", "pipeline.yaml")
    workspace = os.path.join(ROOT, "examples", "toy-project")
    if not all(os.path.exists(path) for path in (validator, source, workspace)):
        runner.skip("a dropped rule obligation is refused",
                    "the validator, pipeline.yaml or examples/toy-project is absent")
        return
    with open(source, "r", encoding="utf-8") as handle:
        original = handle.read()
    find = "  - code: question.deferred.not-blocked\n"
    if find not in original:
        runner.emit("a dropped rule obligation is refused", False,
                    detail="  - the obligation this case removes is no longer in pipeline.yaml "
                           "— the case, not the rule, is stale")
        return
    with tempfile.TemporaryDirectory() as base:
        target = os.path.join(base, "pipeline.yaml")
        with open(target, "w", encoding="utf-8") as handle:
            handle.write(original.replace(find, "  - code: question.deferred.not-parked\n", 1))
        result = subprocess.run([sys.executable, validator, "--root", workspace,
                                 "--pipeline", target],
                                capture_output=True, text=True, cwd=ROOT)
    if result.returncode == 0:
        runner.emit("a dropped rule obligation is refused", False,
                    detail="  - validate-workspace passed against a pipeline missing the "
                           "obligation that scopes question.deferred.not-blocked")
        return
    if "pipeline.obligation.missing" not in codes_from(result.stdout + result.stderr):
        runner.emit("a dropped rule obligation is refused", False,
                    detail="  - validate-workspace failed without reporting "
                           "[pipeline.obligation.missing]")
        return
    runner.emit("a dropped rule obligation is refused", True)

def check_derived_model(runner: Runner) -> None:
    """The termination model, exercised against a real workspace rather than described.

    Every case below is a contradiction a real run hit, re-decided by the model derived in
    ADR-0006. They are run by execution because that is the only way to know the *tools* agree
    with the spec: `new-item` refusing a creation, and `transition` refusing an ending, are the
    two places where the authority table and the termination gate actually bite.

    The last one is the session's centre. A run ended at an impasse with the stakeholder writing
    down that nobody ever asked them (F-045); here, ending an engagement while no acknowledgment
    exists is refused by the gate, not by anyone's discipline.
    """
    import tempfile
    tools = {name: os.path.join(SCRIPTS, name)
             for name in ("workspace-init", "new-item", "transition", "validate-workspace")}
    if not all(os.path.isfile(path) for path in tools.values()):
        runner.skip("the derived model, by execution", "one of the scripts is absent")
        return

    problems = []
    with tempfile.TemporaryDirectory() as root:
        def run(script, *args):
            return subprocess.run([sys.executable, tools[script], *args, "--root", root],
                                  capture_output=True, text=True, cwd=ROOT)

        subprocess.run([sys.executable, tools["workspace-init"], root],
                       capture_output=True, text=True, cwd=ROOT)

        def item(*args):
            return subprocess.run([sys.executable, tools["new-item"], "--root", root, *args],
                                  capture_output=True, text=True, cwd=ROOT)

        def expect(label, result, should_pass):
            ok = (result.returncode == 0) if should_pass else (result.returncode != 0)
            if not ok:
                tail = (result.stdout + result.stderr).strip().split("\n")[-3:]
                problems.append(f"{label}: expected "
                                + ("success" if should_pass else "a refusal")
                                + ", got exit {}\n      {}".format(result.returncode,
                                                                   "\n      ".join(tail)))

        expect("intake creates the epic",
               item("--id", "EP-001", "--type", "epic", "--title", "A goal",
                    "--status", "open", "--actor", "intake", "--reason", "from the raw idea"),
               True)
        expect("intake creates a work item",
               item("--id", "WI-0001", "--type", "work-item", "--epic", "EP-001",
                    "--title", "Do the thing", "--status", "draft", "--actor", "intake",
                    "--reason", "refined from the idea"),
               True)

        # F-029.2: review-close found a defect belonging to another item and could not file it.
        expect("plan may not create a bug",
               item("--id", "BUG-0001", "--type", "bug", "--epic", "EP-001", "--title", "Broken",
                    "--status", "ready", "--actor", "plan", "--reason", "noticed it"),
               False)
        expect("review-close may not create a bug with no provenance",
               item("--id", "BUG-0001", "--type", "bug", "--epic", "EP-001", "--title", "Broken",
                    "--status", "ready", "--actor", "review-close", "--reason", "found in review"),
               False)
        expect("review-close files a bug it found (F-029.2)",
               item("--id", "BUG-0001", "--type", "bug", "--epic", "EP-001", "--title", "Broken",
                    "--status", "ready", "--actor", "review-close", "--found-in", "WI-0001",
                    "--reason", "found while reviewing WI-0001"),
               True)

        # The question the widening answer came from has to exist, because provenance that does
        # not resolve is the failure the field is guarding against.
        question_dir = os.path.join(root, "tracker", "items", "WI-0001", "questions")
        os.makedirs(question_dir, exist_ok=True)
        with open(os.path.join(question_dir, "Q-001.md"), "w", encoding="utf-8") as handle:
            handle.write("---\nid: Q-001\nitem: WI-0001\nfrom-skill: refine\n"
                         "addressed-to: human\nblocking: true\nstatus: open\n"
                         "created: 2026-08-27T00:00:00Z\n---\n\n## Context\n\nx\n\n"
                         "## Question\n\nDoes this cover the second case too?\n\n"
                         "## Options considered\n\n- A\n- B\n\n## Answer\n\n"
                         "## Consequences\n")

        # F-029.1: an answer widened the scope and there was nowhere to record the implied work.
        expect("answer-questions may not create a work item with no provenance",
               item("--id", "WI-0002", "--type", "work-item", "--epic", "EP-001",
                    "--title", "Widened scope", "--status", "draft",
                    "--actor", "answer-questions", "--reason", "an answer widened the scope"),
               False)
        expect("answer-questions records work an answer implied (F-029.1)",
               item("--id", "WI-0002", "--type", "work-item", "--epic", "EP-001",
                    "--title", "Widened scope", "--status", "draft",
                    "--actor", "answer-questions", "--arose-from", "WI-0001/Q-001",
                    "--reason", "an answer widened the scope"),
               True)
        # DoR R9 tells refine to split an item; until ADR-0006 it could not create the part.
        expect("refine records the item it split (DoR R9)",
               item("--id", "WI-0003", "--type", "work-item", "--epic", "EP-001",
                    "--title", "The other half", "--status", "draft", "--actor", "refine",
                    "--arose-from", "WI-0001", "--reason", "WI-0001 was two items"),
               True)
        expect("implement may not create work for itself",
               item("--id", "WI-0004", "--type", "work-item", "--epic", "EP-001",
                    "--title", "While I was in there", "--status", "draft",
                    "--actor", "implement", "--arose-from", "WI-0001", "--reason", "noticed it"),
               False)

        # F-045: ending an engagement that nobody has been asked about.
        expect("an engagement may not end before the stakeholder is asked (F-045)",
               run("transition", "EP-001", "--to", "blocked", "--actor", "review-close",
                   "--resume-to", "open", "--reason", "impasse"),
               False)
        # ...and only review-close may end one at all (ADR-0006 §2).
        expect("only review-close ends an engagement",
               run("transition", "EP-001", "--to", "blocked", "--actor", "intake",
                   "--resume-to", "open", "--reason", "giving up"),
               False)
        # F-013: the move `intake`'s own instruction requires, which used to be refused. The
        # question has to exist first — the deferral cases below are about what happens to it.
        epic_questions = os.path.join(root, "tracker", "items", "EP-001", "questions")
        os.makedirs(epic_questions, exist_ok=True)
        epic_question = os.path.join(epic_questions, "Q-001.md")

        def write_epic_question(status: str) -> None:
            answered = ("answered-at: 2026-08-27T00:00:10Z\nanswered-by: human\n"
                        if status != "open" else "")
            body = ("I'll send you the sample later." if status != "open" else "")
            consequence = ("- `tracker/items/EP-001/item.md` — the engagement waits at open; "
                           "the sample would unblock it\n" if status != "open" else "")
            with open(epic_question, "w", encoding="utf-8") as handle:
                handle.write(f"---\nid: Q-001\nitem: EP-001\nfrom-skill: intake\n"
                             f"addressed-to: human\nblocking: true\nstatus: {status}\n"
                             f"created: 2026-08-27T00:00:00Z\n{answered}---\n\n"
                             f"## Context\n\nThe goal names an export nobody has seen.\n\n"
                             f"## Question\n\nCan you send a sample of the file?\n\n"
                             f"## Options considered\n\n- A\n- B\n\n"
                             f"## Answer\n\n{body}\n\n## Consequences\n\n{consequence}")

        write_epic_question("open")
        suspend = run("transition", "EP-001", "--to", "awaiting-answer", "--actor", "intake",
                      "--resume-to", "open", "--reason", "an epic-level question")
        if "EP-001 open → awaiting-answer" not in suspend.stdout:
            problems.append("an epic could not be suspended by a blocking question (F-013):\n"
                            "      " + (suspend.stdout + suspend.stderr).strip()[-300:])

        # F-050: the move 1e's architect would have made had they taken step 3a's second branch.
        # `blocked` on an epic is the impasse ENDING, not a parking space, and only review-close
        # reaches it — so the deferral may not park the engagement.
        expect("a deferral may not park an epic (F-050)",
               run("transition", "EP-001", "--to", "blocked", "--actor", "answer-questions",
                   "--resume-to", "open", "--reason", "the stakeholder deferred"),
               False)
        # ...and the branch that is legal has to actually be legal: the deferral is recorded, the
        # epic goes back to `open`, and the workspace validates. A rule nobody can satisfy is not
        # a rule, and that is the state F-050 was filed against.
        write_epic_question("deferred")
        resumed = run("transition", "EP-001", "--to", "open", "--actor", "answer-questions",
                      "--reason", "the stakeholder deferred; the engagement waits at open")
        if "EP-001 awaiting-answer → open" not in resumed.stdout:
            problems.append("a deferral could not return the epic to open (F-050):\n"
                            "      " + (resumed.stdout + resumed.stderr).strip()[-300:])
        deferred = run("validate-workspace")
        stranded = [line for line in (deferred.stdout + deferred.stderr).split("\n")
                    if "question.deferred.not-blocked" in line]
        if stranded:
            problems.append("an epic carrying a deferred blocking question is reported as "
                            "misplaced, and no legal move would repair it (F-050):\n      "
                            + "\n      ".join(stranded[:3]))

        # And the provenance rules must be satisfiable: nothing this sequence created may be
        # reported as missing or dangling. A rule nobody can satisfy is not a rule.
        validated = run("validate-workspace")
        stray = [line for line in (validated.stdout + validated.stderr).split("\n")
                 if "item.arose-from" in line]
        if stray:
            problems.append("provenance findings on items created through the tool:\n      "
                            + "\n      ".join(stray[:5]))

    if problems:
        runner.emit("the derived model, by execution", False,
                    detail="\n".join(f"  - {problem}" for problem in problems))
        return
    runner.emit("the derived model, by execution (14 cases)", True)


def contract_gate_names(skill: str) -> list:
    """The gate names `skill` declares, read out of its own contract.

    A body written for one of these tools has to answer for every gate the contract lists
    (F-080), so the fixture bodies below are generated from the contract rather than typed —
    a hand-typed list would go stale the next time a skill gains a gate, and the step would
    then fail for a reason that has nothing to do with what it checks.
    """
    sys.path.insert(0, os.path.join(SCRIPTS, "lib"))
    import miniyaml
    path = os.path.join(ROOT, "methodology", "skills", skill, "skill.yaml")
    if not os.path.isfile(path):
        return []
    contract = miniyaml.load_file(path) or {}
    return [gate["name"] for gate in (contract.get("quality_gates") or [])
            if isinstance(gate, dict) and gate.get("name")]


def journal_body(skill: str, item: str = "WI-0001", gates=None, result="done.") -> str:
    """A legal entry body for `skill`, with one `**Gates:**` line per contract gate."""
    lines = [f"- **Item:** {item}",
             "- **Trigger:** dispatched by next",
             "- **Inputs read:**",
             "  - item.md",
             "- **Decisions:**",
             "  - none",
             "- **Questions raised:** none",
             "- **Commands:**",
             "  - none",
             "- **Gates:**"]
    for name in (contract_gate_names(skill) if gates is None else gates):
        lines.append(f"  - {name} → **pass** (checked by hand)")
    lines += ["- **Artifacts:**",
              "  - item.md",
              f"- **Result:** {result}",
              ""]
    return "\n".join(lines)


JOURNAL_BODY = journal_body("refine", result="the item meets the Definition of Ready.")


def check_journal_body(runner: Runner) -> None:
    """The `**Status:**` bullet, tool against prose (F-049).

    Every `## Journaling` section says the transition writes this bullet from the move it made.
    It does — and `check_body` used to refuse the body first, so believing the prose cost a
    failed transition. Six of them, across five turns and four skills, in one run. So the prose
    is now true and this is what says so: a body with no `**Status:**` bullet goes through the
    transition and comes back carrying the move that was actually made.

    Two companions keep the relaxation honest. Standalone `journal-entry` still requires the
    bullet, because there nothing else would write it; and a body missing a bullet the tool does
    *not* write is still refused, so this is a scoped exemption rather than a weakened check.
    """
    import tempfile
    tools = {name: os.path.join(SCRIPTS, name)
             for name in ("workspace-init", "new-item", "transition", "journal-entry")}
    if not all(os.path.isfile(path) for path in tools.values()):
        runner.skip("a journal body needs no Status bullet (F-049)", "one of the scripts is absent")
        return

    problems = []
    with tempfile.TemporaryDirectory() as root:
        def tool(name, *args):
            return subprocess.run([sys.executable, tools[name], *args],
                                  capture_output=True, text=True, cwd=ROOT)

        tool("workspace-init", root)
        tool("new-item", "--root", root, "--id", "EP-001", "--type", "epic", "--title", "A goal",
             "--status", "open", "--actor", "intake", "--reason", "from the raw idea")
        tool("new-item", "--root", root, "--id", "WI-0001", "--type", "work-item",
             "--epic", "EP-001", "--title", "Do the thing", "--status", "draft",
             "--actor", "intake", "--reason", "refined from the idea")

        body = os.path.join(root, "body.md")
        with open(body, "w", encoding="utf-8") as handle:
            handle.write(JOURNAL_BODY)

        moved = tool("transition", "WI-0001", "--to", "ready", "--actor", "refine",
                     "--reason", "the Definition of Ready passes", "--journal-body-file", body,
                     "--root", root, "--force")
        if "not a legal entry" in (moved.stdout + moved.stderr):
            problems.append("the transition refused a body with no '**Status:**' bullet, which "
                            "is the bullet it writes itself (F-049):\n      "
                            + (moved.stdout + moved.stderr).strip()[-300:])
        else:
            journal = os.path.join(root, "tracker", "items", "WI-0001", "journal.md")
            written = ""
            if os.path.isfile(journal):
                with open(journal, "r", encoding="utf-8") as handle:
                    written = handle.read()
            if "- **Status:** `draft` → `ready`" not in written:
                problems.append("the entry does not carry the move the transition made; the "
                                "bullet the tool owns has to end up in the file")

        standalone = tool("journal-entry", "WI-0001", "--skill", "refine",
                          "--body-file", body, "--root", root)
        if (standalone.returncode == 0
                or "missing the '**Status:**' bullet" not in (standalone.stdout
                                                              + standalone.stderr)):
            problems.append("journal-entry accepted a body with no '**Status:**' bullet, or "
                            "refused it for some other reason; standalone there is nothing "
                            "else to write it")

        partial = os.path.join(root, "partial.md")
        plan_body = journal_body("plan", result="the plan is written.")
        with open(partial, "w", encoding="utf-8") as handle:
            handle.write("\n".join(line for line in plan_body.split("\n")
                                   if not line.startswith("- **Gates:**")))
        refused = tool("transition", "WI-0001", "--to", "planned", "--actor", "plan",
                       "--reason", "planned", "--journal-body-file", partial,
                       "--root", root, "--force")
        if refused.returncode == 0 or "not a legal entry" not in (refused.stdout + refused.stderr):
            problems.append("the transition accepted a body missing '**Gates:**' — the "
                            "exemption is for the bullet the tool writes, not for the schema")

    if problems:
        runner.emit("a journal body needs no Status bullet (F-049)", False,
                    detail="\n".join(f"  - {problem}" for problem in problems))
        return
    runner.emit("a journal body needs no Status bullet (F-049, 4 cases)", True)

def check_gate_verdicts(runner: Runner) -> None:
    """The `**Gates:**` bullet's verdicts belong to the program that ran the gates (F-091, F-080).

    `transition` ran the gates, printed a report and appended the body the caller had written
    before the run. Two entries in one engagement recorded a verdict the program had
    contradicted — `epic-sign-off` **pass** where the gate printed FAIL, and
    `tests-pass-on-the-merge-result` **skipped** where the runner printed PASS — and a third
    listed six gates where its sixteen siblings listed seven. Both were caught by unusually
    careful workers, which is the thing the format exists not to depend on.

    Ten cases, in one throwaway workspace, covering both directions of every rule that moved:
    the verdict is rewritten and the contradiction is named; the caller's evidence sentence
    survives; completeness comes from the contract rather than from the caller's memory; a gate
    the contract does not declare is refused and nothing is written; `pending` is written by the
    tool on the one move that earns it and refused by the validator everywhere else; a manual
    gate's verdict stays the caller's, because no program decided it; the validator's comparison
    reports each way the bullet can disagree with the contract; and an entry written under an
    older contract version is left alone, because it records an execution under that contract
    rather than under this one.
    """
    import tempfile
    tools = {name: os.path.join(SCRIPTS, name)
             for name in ("workspace-init", "new-item", "transition", "journal-entry",
                          "validate-workspace")}
    label = "the gate verdicts belong to the runner (F-091, F-080)"
    if not all(os.path.isfile(path) for path in tools.values()):
        runner.skip(label, "one of the scripts is absent")
        return

    problems = []
    observations = 0
    with tempfile.TemporaryDirectory() as root:
        def tool(name, *args):
            return subprocess.run([sys.executable, tools[name], *args],
                                  capture_output=True, text=True, cwd=ROOT)

        def note(ok, message):
            nonlocal observations
            observations += 1
            if not ok:
                problems.append(message)

        def body_file(name, text):
            path = os.path.join(root, name)
            write(path, text)
            return path

        def journal_of(item):
            path = os.path.join(root, "tracker", "items", item, "journal.md")
            return read(path) if os.path.isfile(path) else ""

        tool("workspace-init", root)
        tool("new-item", "--root", root, "--id", "EP-001", "--type", "epic", "--title", "A goal",
             "--status", "open", "--actor", "intake", "--reason", "from the raw idea")
        tool("new-item", "--root", root, "--id", "WI-0001", "--type", "work-item",
             "--epic", "EP-001", "--title", "Do the thing", "--status", "draft",
             "--actor", "intake", "--reason", "refined from the idea")
        tool("transition", "WI-0001", "--to", "ready", "--actor", "refine", "--force",
             "--reason", "the Definition of Ready passes", "--root", root,
             "--journal-body-file", body_file("refine.md", journal_body("refine")))
        tool("transition", "WI-0001", "--to", "planned", "--actor", "plan", "--force",
             "--reason", "plan.md written", "--root", root,
             "--journal-body-file", body_file("plan.md", journal_body("plan")))

        # 1-3. The opening `implement` move: every gate `pending`, because the same skill is
        # dispatched again at `in-progress` and decides them there. The caller wrote one gate;
        # the entry carries all nine, in contract order, and the caller's sentence survives.
        opening = journal_body("implement", gates=[], result="implementation has started.")
        opening = opening.replace("- **Gates:**",
                                  "- **Gates:**\n  - tests-pass → **pass** (I say so)")
        opened = tool("transition", "WI-0001", "--to", "in-progress", "--actor", "implement",
                      "--reason", "branch created", "--root", root, "--branch", "wi/WI-0001",
                      "--journal-body-file", body_file("open.md", opening))
        entry = journal_of("WI-0001")
        declared = contract_gate_names("implement")
        note(all(f"`{name}` → **pending**" in entry for name in declared),
             "the opening implement entry does not record every contract gate as 'pending'; "
             "that move is the one the fourth verdict exists for (F-080)")
        note(entry.count("→ **pending**") == len(declared),
             f"the opening entry lists {entry.count('→ **pending**')} pending gates where the "
             f"contract declares {len(declared)}; completeness is the tool's, not the caller's")
        note("I say so" in entry,
             "the caller's evidence sentence did not survive; the verdict is the runner's and "
             "the evidence is the worker's, not the other way round")
        note("dispatched again at `in-progress`" in entry,
             "a 'pending' line does not say where the gate is decided, so the record cannot be "
             "read without the contract beside it")
        note(opened.returncode in (0, 1) and "not a legal entry" not in opened.stdout,
             "the opening transition refused a body that omitted eight of nine gates; the tool "
             "writes those lines from the run it just did")

        # 4-5. A non-pending move: the runner's verdict replaces a contradicted one, and the
        # contradiction is named rather than silently corrected.
        suspend = journal_body("implement", gates=[], result="a question blocks the work.")
        suspend = suspend.replace(
            "- **Gates:**",
            "- **Gates:**\n"
            "  - workspace-valid → **pass** (I ran it and it was fine)\n"
            "  - every-criterion-has-a-test → **pass** (AC1 maps to test_one)\n"
            "  - no-unplanned-scope → **pass** (nothing beyond the plan)")
        moved = tool("transition", "WI-0001", "--to", "awaiting-answer", "--resume-to",
                     "in-progress", "--actor", "implement", "--reason", "Q-001 blocking",
                     "--root", root,
                     "--journal-body-file", body_file("suspend.md", suspend))
        entry = journal_of("WI-0001")
        note("`workspace-valid` → **fail**" in entry,
             "a verdict the run contradicted survived into the entry; the runner's verdict is "
             "the one the record keeps (F-091)")
        note("the body recorded 'workspace-valid' as 'pass'" in moved.stdout,
             "the contradiction was corrected silently; a worker who wrote the wrong verdict "
             "has to be told, or the correction is invisible")
        note("I ran it and it was fine" in entry,
             "the contradicted line dropped the caller's evidence; both halves belong in the "
             "record, which is what makes the disagreement readable")

        # 6. A gate the contract does not declare is refused, and nothing is written.
        bogus = journal_body("implement", gates=[], result="unknown gate.")
        bogus = bogus.replace("- **Gates:**",
                              "- **Gates:**\n  - tests-are-green → **pass** (a gate that is "
                              "not in the contract)")
        before = journal_of("WI-0001")
        refused = tool("transition", "WI-0001", "--to", "in-progress", "--actor",
                       "answer-questions", "--reason", "Q-001 answered", "--root", root,
                       "--journal-body-file", body_file("bogus.md", bogus))
        note(refused.returncode != 0
             and "does not declare" in (refused.stdout + refused.stderr),
             "a '**Gates:**' bullet naming a gate the contract does not have was accepted")
        note(journal_of("WI-0001") == before,
             "the refusal happened after something was written; the body is checked before a "
             "single byte lands (F-039)")

        # 7. A manual gate has no program behind it, so its verdict stays the caller's — and an
        # entry that leaves it out is refused rather than filled in with a guess.
        silent = journal_body("answer-questions", gates=[], result="resumed.")
        silent = silent.replace(
            "- **Gates:**",
            "- **Gates:**\n  - answer-is-propagated → **pass** (checked file by file)")
        manual = tool("transition", "WI-0001", "--to", "in-progress", "--actor",
                      "answer-questions", "--reason", "Q-001 answered", "--root", root,
                      "--journal-body-file", body_file("manual.md", silent))
        note(manual.returncode != 0
             and "answered-from-the-record" in (manual.stdout + manual.stderr),
             "a manual gate with no verdict was accepted; nothing ran, so there is no verdict "
             "for the tool to write and the caller still owes one")

        # 8-9. The validator's comparison, in each direction it can fail, at the installed
        # version — and silent one version back, because an entry records an execution under the
        # contract named in its own heading.
        item_dir = os.path.join(root, "tracker", "items", "WI-0001")
        keep = read(os.path.join(item_dir, "journal.md"))
        broken = ("\n## 2030-01-01T00:00:00Z — implement v{version} — developer\n\n"
                  "- **Item:** WI-0001\n"
                  "- **Trigger:** status `in-progress`, dispatched by `next`\n"
                  "- **Inputs read:** item.md\n"
                  "- **Decisions:** none\n"
                  "- **Questions raised:** none\n"
                  "- **Commands:** none\n"
                  "- **Gates:**\n"
                  "  - `tests-pass` → **not yet run** (a word outside the vocabulary)\n"
                  "  - `lint-clean` → **pending** (no later implement move follows this one)\n"
                  "  - `tests-are-green` → **pass** (not a gate this contract declares)\n"
                  "  - and the rest were fine\n"
                  "- **Artifacts:** none\n"
                  "- **Status:** `in-progress` → `in-progress` (unchanged)\n"
                  "- **Result:** every way the bullet can disagree with its own contract.\n")
        installed = contract_version("implement")
        write(os.path.join(item_dir, "journal.md"), keep + broken.format(version=installed))
        found = codes_from(tool("validate-workspace", root).stdout)
        for code in ("journal.gates.verdict", "journal.gates.pending", "journal.gates.unknown",
                     "journal.gates.unreadable", "journal.gates.missing"):
            note(code in found,
                 f"the validator did not report {code} for an entry whose '**Gates:**' bullet "
                 f"disagrees with the contract of the skill in its own heading (F-080)")
        write(os.path.join(item_dir, "journal.md"), keep + broken.format(version="0.0.1"))
        stale = codes_from(tool("validate-workspace", root).stdout)
        note(not [code for code in stale if code.startswith("journal.gates.")],
             "the same entry one contract version back was still compared to today's gate list; "
             "an entry records an execution under the contract named in its own heading")
        write(os.path.join(item_dir, "journal.md"), keep)

        # 10. Standalone `journal-entry` runs no gates, so the verdicts stay the caller's — but
        # the gate *names* come from the same contract either way. The F-049 division, one
        # bullet to the left.
        solo = journal_body("implement", gates=["tests-pass"], result="one gate only.")
        solo = solo.replace("- **Result:**",
                            "- **Status:** `in-progress` → `in-progress` (unchanged)\n"
                            "- **Result:**")
        standalone = tool("journal-entry", "WI-0001", "--skill", "implement", "--root", root,
                          "--body-file", body_file("solo.md", solo))
        note(standalone.returncode != 0
             and "does not report 'lint-clean'" in (standalone.stdout + standalone.stderr),
             "standalone journal-entry accepted a body that omits a contract gate; there is no "
             "run behind the entry, so the caller owes every line of it")

    if problems:
        runner.emit(label, False, detail="\n".join(f"  - {problem}" for problem in problems))
        return
    runner.emit(f"{label} ({observations} observations)", True)


def check_gate_subject(runner: Runner) -> None:
    """A gate's subject is its contract row's answer, not something each execution invents.

    `review-close` serves two subjects. It closes a work item, which has a branch, and it ends an
    engagement, whose subject is an epic, which has none — and three of its hard gates are
    defined over that branch or over a merge. Five epic-level executions in banked runs each
    wrote their own sentence for the same absence, between them `skipped`, `not applicable`,
    `skipped, deliberately`, `skipped as a gate, run as evidence` and `not applicable, and
    recorded rather than skipped silently`. One recorded `tests-pass-on-the-merge-result` as
    skipped because an ending merges nothing, while the runner ran the project's test command
    anyway and reported PASS, and the worker had to correct their own entry by appending to it
    (F-085).

    So: the epic side of every such row is read from the contract and asserted by execution — the
    gate is not run, the verdict is `skipped`, and the sentence in the record is the contract's.
    The work-item side is asserted too, because a scoping that skipped everywhere would pass
    every one of those assertions and check nothing: the same gate runs there, and the same word
    `skipped` reached by §1.4's null placeholder still carries the resolver's sentence rather than
    the contract's, so the two sources stay distinguishable in the record. Then the lint that
    keeps the pair honest, in each direction it can be got wrong.
    """
    import shutil
    import tempfile
    label = "a gate's subject comes from its contract row (F-085)"
    tools = {name: os.path.join(SCRIPTS, name)
             for name in ("workspace-init", "new-item", "run-gate", "transition", "lint-skills")}
    contract_path = os.path.join(ROOT, "methodology", "skills", "review-close", "skill.yaml")
    if not all(os.path.isfile(path) for path in tools.values()) \
            or not os.path.isfile(contract_path):
        runner.skip(label, "one of the scripts or review-close's contract is absent")
        return

    sys.path.insert(0, os.path.join(SCRIPTS, "lib"))
    import miniyaml
    contract = miniyaml.load_file(contract_path) or {}
    scoped = [gate for gate in (contract.get("quality_gates") or [])
              if isinstance(gate, dict) and gate.get("applies_to")]
    if not scoped:
        runner.emit(label, False,
                    detail="  - review-close declares no gate with an applies_to row, so this "
                           "step would assert nothing; the case, not the rule, is stale")
        return

    problems, observations = [], 0

    def note(ok, message):
        nonlocal observations
        observations += 1
        if not ok:
            problems.append(message)

    with tempfile.TemporaryDirectory() as base:
        root = os.path.join(base, "ws")
        os.makedirs(root)
        sentinel = os.path.join(base, "the-suite-ran")

        def tool(name, *args):
            return subprocess.run([sys.executable, tools[name], *args],
                                  capture_output=True, text=True, cwd=ROOT)

        tool("workspace-init", root)
        tool("new-item", "--root", root, "--id", "EP-001", "--type", "epic", "--title", "A goal",
             "--status", "open", "--actor", "intake", "--reason", "from the raw idea")
        tool("new-item", "--root", root, "--id", "WI-0001", "--type", "work-item",
             "--epic", "EP-001", "--title", "Do the thing", "--status", "draft",
             "--actor", "intake", "--reason", "refined from the idea")
        project = os.path.join(root, "tracker", "project.yaml")
        write(project, read(project).replace("  test: null",
                                             f'  test: "touch {sentinel}"', 1))

        epic = tool("run-gate", "--skill", "review-close", "--item", "EP-001", "--all",
                    "--root", root).stdout
        for gate in scoped:
            reason = gate["not_applicable"]
            block = _gate_block(epic, gate["name"])
            note(block.startswith("SKIP"),
                 f"on an epic, {gate['name']!r} reported {block.split()[0] if block else 'nothing'}"
                 f" where its contract row gives it no subject there")
            note(reason in block,
                 f"on an epic, {gate['name']!r} did not carry its own contract row's sentence — "
                 f"the record has to say why, or the worker writes a sentence of their own, "
                 f"which is the finding")
        note(not os.path.exists(sentinel),
             "the project's test command ran at an ending: `tests-pass-on-the-merge-result` has "
             "no merge to test there, and a gate that runs its command anyway is the PASS one "
             "execution had to correct by hand (F-085, F-091)")

        item = tool("run-gate", "--skill", "review-close", "--item", "WI-0001", "--all",
                    "--root", root).stdout
        note(os.path.exists(sentinel),
             "the project's test command did not run on a work item either, so the scoping is "
             "not a scoping — it skips everywhere and checks nothing")
        for gate in scoped:
            note("no subject on" not in _gate_block(item, gate["name"]),
                 f"on a work item, {gate['name']!r} was skipped for having no subject; the "
                 f"contract row names work-item, so the gate is owed a real verdict there")
        freshness = _gate_block(item, "verification-postdates-the-code")
        note("has no value in" in freshness,
             "a work item with no branch no longer skips for the reason it actually has — "
             "§1.4's unresolved placeholder — so the record can no longer tell the two sources "
             "of 'skipped' apart")

        body = os.path.join(base, "body.md")
        write(body, "- **Item:** EP-001\n"
                    "- **Trigger:** status `open`, dispatched by `next` step 6\n"
                    "- **Inputs read:**\n  - `tracker/items/EP-001/item.md`\n"
                    "- **Decisions:**\n  - none\n"
                    "- **Questions raised:** Q-001\n"
                    "- **Commands:**\n  - `scripts/engagement-state EP-001` → at-rest\n"
                    "- **Gates:**\n"
                    "  - `definition-of-done` → **pass** (DE1 to DE6 walked, dor-dod.md §4a)\n"
                    "  - `record-is-reconstructible` → **pass** (the record reads)\n"
                    "- **Artifacts:**\n  - `tracker/items/EP-001/questions/Q-001.md`\n"
                    "- **Result:** the sign-off is filed.\n")
        tool("transition", "EP-001", "--to", "awaiting-answer", "--resume-to", "open",
             "--actor", "review-close", "--reason", "Q-001 sign-off filed", "--root", root,
             "--journal-body-file", body)
        entry = read(os.path.join(root, "tracker", "items", "EP-001", "journal.md"))
        for gate in scoped:
            note(f"`{gate['name']}` → **skipped**" in entry
                 and gate["not_applicable"] in entry,
                 f"the composed entry does not record {gate['name']!r} as skipped with its "
                 f"contract row's own sentence; the whole point is that the ending stops "
                 f"improvising one")

        # The lint that keeps the pair honest. A copied tree, one injection at a time.
        tree = os.path.join(base, "tree")
        os.makedirs(tree)
        for name in ("methodology", "spec"):
            shutil.copytree(os.path.join(ROOT, name), os.path.join(tree, name))
        target = os.path.join(tree, "methodology", "skills", "review-close", "skill.yaml")
        original = read(target)
        clean = tool("lint-skills", tree)
        note(clean.returncode == 0,
             "the unmodified tree does not lint clean, so every injection below would fail for "
             "a reason that has nothing to do with the rule")
        first = scoped[0]
        injections = [
            ("an item type pipeline.yaml does not have",
             f"applies_to: [{', '.join(first['applies_to'])}]",
             "applies_to: [work-item, gnome]", "gate.applies_to.unknown"),
            ("a scoping that covers every type the skill dispatches on",
             f"applies_to: [{', '.join(first['applies_to'])}]",
             "applies_to: [work-item, bug, epic]", "gate.applies_to"),
            ("applies_to with no sentence to print in place of a verdict",
             f"    not_applicable: {first['not_applicable']}\n", "", "gate.not_applicable"),
            ("a sentence with no scoping to explain",
             "  - name: workspace-valid\n",
             "  - name: workspace-valid\n    not_applicable: an epic has nothing to validate\n",
             "gate.not_applicable"),
        ]
        for what, find, replace, code in injections:
            if find not in original:
                note(False, f"{what}: the text this injection edits is no longer in the "
                            f"contract — the case, not the rule, is stale")
                continue
            write(target, original.replace(find, replace, 1))
            result = tool("lint-skills", tree)
            note(result.returncode != 0 and f"[{code}]" in result.stdout,
                 f"lint-skills accepted {what}; expected [{code}]")
        write(target, original)

    if problems:
        runner.emit(label, False, detail="\n".join(f"  - {problem}" for problem in problems))
        return
    runner.emit(f"{label} ({observations} observations)", True)


def _gate_block(report: str, name: str) -> str:
    """One gate's outcome line and its detail, out of a `run-gate` report."""
    collected, collecting = [], False
    for line in report.split("\n"):
        if re.match(r"^(PASS|FAIL|SKIP|MANUAL)\s", line):
            collecting = line.split()[1] == name
            if collecting:
                collected.append(line)
            continue
        if collecting:
            collected.append(line)
    return "\n".join(collected)


def contract_version(skill: str) -> str:
    sys.path.insert(0, os.path.join(SCRIPTS, "lib"))
    import miniyaml
    path = os.path.join(ROOT, "methodology", "skills", skill, "skill.yaml")
    contract = miniyaml.load_file(path) or {}
    return str(contract.get("version", ""))


def trial_merge_commands() -> list:
    """The trial-merge sequence, read out of `review-close`'s own procedure.

    Extracting it is what makes the step below a gate rather than a demonstration: edit the
    contract to drop `--detach` and this fails, which is exactly the edit that cost a real run
    its trunk (F-055).
    """
    path = os.path.join(ROOT, "methodology", "skills", "review-close", "process.md")
    if not os.path.isfile(path):
        return []
    with open(path, "r", encoding="utf-8") as handle:
        lines = handle.read().split("\n")
    block, inside = [], False
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("```"):
            if inside:
                break
            continue
        if stripped.startswith("git worktree add"):
            inside = True
        if inside and stripped:
            block.append(stripped)
    return block


def check_trial_merge(runner: Runner) -> None:
    """A trial merge must not move the trunk, and the contract must say how (F-055).

    The only finding in iteration 1e that caused real damage: step 8 said to merge into "a
    throwaway copy of the trunk" and left the mechanism to the reader, so a review ran
    `git worktree add <path> main` — which checks out the real branch — and the trial merge
    fast-forwarded the real `main`.

    Both halves are asserted, because either alone proves nothing. The sequence the contract now
    prints leaves the trunk where it was; the same sequence with `--detach` removed moves it. A
    guard that would pass whatever the procedure said is not a guard.
    """
    import shutil
    import tempfile
    if shutil.which("git") is None:
        runner.skip("a trial merge leaves the trunk alone (F-055)", "git is not on PATH")
        return
    commands = trial_merge_commands()
    if not any("worktree add" in line for line in commands):
        runner.emit("a trial merge leaves the trunk alone (F-055)", False,
                    detail="  - review-close's procedure no longer prints a trial-merge command "
                           "block; the case, not the rule, is stale")
        return
    if not any("--detach" in line for line in commands):
        runner.emit("a trial merge leaves the trunk alone (F-055)", False,
                    detail="  - the trial-merge block in review-close's procedure does not name "
                           "--detach, so it tells a skill to check out the real trunk (F-055)")
        return

    def trunk_moved(detached: bool) -> str:
        """Run the contract's sequence in a throwaway repository; report the trunk's movement."""
        with tempfile.TemporaryDirectory() as base:
            repo = os.path.join(base, "repo")
            os.makedirs(repo)

            def git(*args, cwd=repo):
                return subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)

            git("init", "--initial-branch=main")
            git("config", "user.email", "check@example.invalid")
            git("config", "user.name", "check")
            with open(os.path.join(repo, "a.txt"), "w", encoding="utf-8") as handle:
                handle.write("one\n")
            git("add", "-A")
            git("commit", "-m", "base")
            git("checkout", "-b", "wi/WI-0001")
            with open(os.path.join(repo, "b.txt"), "w", encoding="utf-8") as handle:
                handle.write("two\n")
            git("add", "-A")
            git("commit", "-m", "the change")
            # The item branch stays checked out, which is where `review-close` runs: `main` is
            # free, so `git worktree add <trial> main` will happily take it. That is the whole
            # trap — it reads like a copy and it is a checkout.

            before = git("rev-parse", "main").stdout.strip()
            trial = os.path.join(base, "trial")
            for line in commands:
                argv = line.split("#", 1)[0].split()
                if not argv or argv[0] != "git":
                    continue
                argv = [("main" if token == "{{trunk}}" else
                         trial if token == "<trial>" else
                         "wi/WI-0001" if token == "<branch>" else token)
                        for token in argv]
                if not detached:
                    argv = [token for token in argv if token != "--detach"]
                subprocess.run(argv, cwd=repo, capture_output=True, text=True)
            after = git("rev-parse", "main").stdout.strip()
            return "moved" if before != after else "unchanged"

    problems = []
    if trunk_moved(detached=True) != "unchanged":
        problems.append("the procedure as written moved the trunk — the trial merge is not a "
                        "trial")
    if trunk_moved(detached=False) != "moved":
        problems.append("the procedure with --detach removed left the trunk alone, so this "
                        "case would pass whatever the contract said; git's behaviour, or the "
                        "extraction, has changed")
    if problems:
        runner.emit("a trial merge leaves the trunk alone (F-055)", False,
                    detail="\n".join(f"  - {problem}" for problem in problems))
        return
    runner.emit("a trial merge leaves the trunk alone (F-055, 2 cases)", True)

def check_record_catches_up(runner: Runner) -> None:
    """Three fields the record could not hold at the moment it was written.

    **F-081 — the merge sha.** `review-close` must close before merging, because
    `commits-reference-the-item` reads the commits not yet on the trunk and merging empties that
    range. So the closing entry is appended before the merge commit exists and cannot name it,
    and six real closes invented three different homes for the sha, three of them by rewriting a
    stamped entry. The sha now lives in `item.md`'s `merge-commit`, written afterwards by
    `scripts/record-merge`. What makes that a record rather than an assertion is that **nothing
    is written which git has not confirmed** — so the cases below are mostly refusals, and the
    refusals are the point: a recorded merge that never happened is worse than an unrecorded one
    (F-035).

    **F-083 — the outcome.** The procedure read as "set `status: done` and `outcome: delivered`",
    then transition. Executed that way it produces a workspace `item.outcome.premature` refuses,
    on the very move that would make the outcome true. The fix is the **order**, not the gate:
    `--outcome` on the closing transition writes both fields in one act, after the gates have
    run. Both halves are asserted — the tool refuses the illegal order, and the pending move
    does **not** downgrade the finding, because that intermediate state is avoidable rather than
    forced (contrast F-014, where it is forced and the downgrade is right).

    **F-084 — the version row.** A change-log row claims a clock, a skill and an item, which are
    the three fields real runs invented. It is now matched against the journal of the item it
    names. The last case is the boundary, and it must fail if the boundary moves: the same
    offending row on a **closed** item is not reported, because a row on a closed item is
    history and demanding its repair is a demand to rewrite a record.
    """
    import shutil
    import tempfile
    label = "the record catches up: merge sha, close order, version row (F-081, F-083, F-084)"
    if shutil.which("git") is None:
        runner.skip(label, "git is not on PATH")
        return
    tools = {name: os.path.join(SCRIPTS, name)
             for name in ("workspace-init", "new-item", "transition", "validate-workspace",
                          "record-merge")}
    if not all(os.path.isfile(path) for path in tools.values()):
        runner.skip(label, "one of the workspace tools is absent")
        return

    problems, observations = [], 0

    def note(condition: bool, complaint: str) -> None:
        nonlocal observations
        observations += 1
        if not condition:
            problems.append(complaint)

    import re
    with tempfile.TemporaryDirectory() as root:
        def git(*args, cwd=root):
            return subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)

        def tool(name, *args):
            return subprocess.run([sys.executable, tools[name], *args, "--root", root],
                                  capture_output=True, text=True, cwd=ROOT)

        def codes(result) -> set:
            return codes_from(result.stdout + result.stderr)

        def fields_of(item_id: str) -> str:
            with open(os.path.join(root, "tracker", "items", item_id, "item.md"),
                      "r", encoding="utf-8") as handle:
                return handle.read()

        def set_fields(item_id: str, **values) -> None:
            """Write frontmatter fields straight into item.md.

            Deliberately not through `transition`: these cases are about what the *field* says,
            including what it says when somebody typed it, which is the case the validator has
            to catch.
            """
            path = os.path.join(root, "tracker", "items", item_id, "item.md")
            with open(path, "r", encoding="utf-8") as handle:
                text = handle.read()
            head, _, body = text.partition("\n---\n")
            lines = [line for line in head.split("\n")
                     if not any(line.startswith(f"{key}:") for key in values)]
            lines += [f"{key}: {value}" for key, value in values.items() if value is not None]
            with open(path, "w", encoding="utf-8") as handle:
                handle.write("\n".join(lines) + "\n---\n" + body)

        git("init", "--initial-branch=main")
        git("config", "user.email", "check@example.invalid")
        git("config", "user.name", "check")
        subprocess.run([sys.executable, tools["workspace-init"], root],
                       capture_output=True, text=True, cwd=ROOT)
        for identifier, kind, extra in (("EP-001", "epic", ["--status", "open"]),
                                        ("WI-0001", "work-item",
                                         ["--status", "draft", "--epic", "EP-001"]),
                                        ("WI-0002", "work-item",
                                         ["--status", "draft", "--epic", "EP-001"]),
                                        ("WI-0003", "work-item",
                                         ["--status", "draft", "--epic", "EP-001"])):
            subprocess.run([sys.executable, tools["new-item"], "--root", root,
                            "--id", identifier, "--type", kind, "--title", f"Item {identifier}",
                            "--actor", "intake", "--reason", "created for this case", *extra],
                           capture_output=True, text=True, cwd=ROOT)
        with open(os.path.join(root, "seed.txt"), "w", encoding="utf-8") as handle:
            handle.write("base\n")
        git("add", "-A")
        git("commit", "-m", "base")

        # ---- F-081: the merge sha ------------------------------------------------------
        git("checkout", "-b", "wi/WI-0001")
        with open(os.path.join(root, "delivered.txt"), "w", encoding="utf-8") as handle:
            handle.write("the work\n")
        git("add", "-A")
        git("commit", "-m", "the change (refs WI-0001)")
        branch_head = git("rev-parse", "HEAD").stdout.strip()
        git("checkout", "-b", "wi/WI-0002", "main")
        with open(os.path.join(root, "other.txt"), "w", encoding="utf-8") as handle:
            handle.write("other work\n")
        git("add", "-A")
        git("commit", "-m", "other change (refs WI-0002)")
        git("checkout", "main")
        git("merge", "--no-ff", "-m", "merge WI-0002", "wi/WI-0002")
        other_merge = git("rev-parse", "HEAD").stdout.strip()
        base_commit = git("rev-parse", "main~1").stdout.strip()

        # An item that is not delivered has nothing to point at.
        note(tool("record-merge", "WI-0001", "--merge", other_merge).returncode != 0,
             "record-merge accepted a merge for an item that is not done and delivered")
        note(tool("record-merge", "EP-001", "--merge", other_merge).returncode != 0,
             "record-merge accepted a merge for an epic, which has no branch (F-081)")

        set_fields("WI-0001", status="done", outcome="delivered", branch="wi/WI-0001")
        for case, argument, expected in (
                ("a sha that resolves to nothing", "0badc0de0badc0de", "unresolved"),
                ("a commit with one parent", base_commit, "not-a-merge"),
                ("a merge of somebody else's branch", other_merge, "other-branch")):
            result = tool("record-merge", "WI-0001", "--merge", argument)
            note(result.returncode != 0 and f"item.merge.{expected}" in (result.stdout
                                                                         + result.stderr),
                 f"record-merge did not refuse {case} with item.merge.{expected}")
            note("merge-commit" not in fields_of("WI-0001"),
                 f"record-merge wrote a field after refusing {case}; it must write nothing "
                 f"it could not confirm (F-035)")

        # A real merge that is NOT on the trunk: a merge commit is not enough on its own.
        git("checkout", "-b", "sidetrack", "main")
        git("merge", "--no-ff", "-m", "merge WI-0001 off the trunk", "wi/WI-0001")
        off_trunk = git("rev-parse", "HEAD").stdout.strip()
        git("checkout", "main")
        result = tool("record-merge", "WI-0001", "--merge", off_trunk)
        note(result.returncode != 0
             and "item.merge.unmerged" in (result.stdout + result.stderr),
             "record-merge accepted a merge commit that is not an ancestor of the trunk")

        git("merge", "--no-ff", "-m", "merge WI-0001 (refs WI-0001)", "wi/WI-0001")
        real_merge = git("rev-parse", "HEAD").stdout.strip()
        accepted = tool("record-merge", "WI-0001", "--merge", real_merge)
        note(accepted.returncode == 0 and real_merge in fields_of("WI-0001"),
             "record-merge refused the real merge of the item's branch onto the trunk:\n      "
             + (accepted.stdout + accepted.stderr).strip()[-300:])
        note(branch_head in git("rev-list", "--parents", "-n", "1", real_merge).stdout,
             "the case's own merge does not contain the branch head; the fixture is wrong")
        note(not {code for code in codes(tool("validate-workspace"))
                  if code.startswith("item.merge.")},
             "the validator reported a merge finding against a merge it should accept")

        # The validator asks the same four questions again, so a typed field is caught too.
        set_fields("WI-0001", **{"merge-commit": "0badc0de"})
        note("item.merge.unresolved" in codes(tool("validate-workspace")),
             "a hand-edited merge-commit that names no commit was not reported (F-035)")
        set_fields("WI-0001", **{"merge-commit": base_commit})
        note("item.merge.not-a-merge" in codes(tool("validate-workspace")),
             "a hand-edited merge-commit naming an ordinary commit was not reported")
        # ...and the other direction: a merge that happened and nothing recorded.
        set_fields("WI-0001", **{"merge-commit": None})
        note("item.merge.missing" in codes(tool("validate-workspace")),
             "a branch merged into the trunk with no merge-commit recorded was not reported "
             "(F-081)")
        tool("record-merge", "WI-0001", "--merge", real_merge)

        # ---- F-083: the close order ----------------------------------------------------
        # Walk WI-0003 to `in-review` through the tool, gates forced. The gates are not what is
        # under test — the order of the two fields is — and a refusal that came from a gate
        # would make every assertion below vacuous, which is exactly what the first draft of
        # this case did.
        for to_status, actor in (("ready", "refine"), ("planned", "plan"),
                                 ("in-progress", "implement"), ("verifying", "implement"),
                                 ("in-review", "verify")):
            tool("transition", "WI-0003", "--to", to_status, "--actor", actor,
                 "--reason", "walking the item to the close", "--force")
        note("status: in-review" in fields_of("WI-0003"),
             "the case could not walk WI-0003 to in-review, so nothing below tested the order")

        # The illegal order, executed: the outcome written first, then the move that would
        # justify it. Both halves matter — the finding is reported, and the pending move does
        # not forgive it.
        set_fields("WI-0003", outcome="delivered")
        note("item.outcome.premature" in codes(tool("validate-workspace")),
             "an outcome set before the item is done was not reported")
        pending = tool("validate-workspace", "--resolving", "WI-0003:in-review->done")
        premature = [line for line in (pending.stdout + pending.stderr).split("\n")
                     if "item.outcome.premature" in line]
        note(any("ERROR" in line for line in premature),
             "the pending move downgraded item.outcome.premature. That would make the illegal "
             "order legal, and it is the fix F-083 explicitly did not take: the state is "
             "avoidable, not forced (contrast F-014, where it is forced)")
        set_fields("WI-0003", outcome=None)

        # ...and the tool refuses to be used that way at all. Each refusal is read for the
        # reason it gives: a refusal that came from somewhere else would prove nothing.
        history = os.path.join(root, "tracker", "items", "WI-0003", "history.md")
        with open(history, "r", encoding="utf-8") as handle:
            before = handle.read()
        refused = tool("transition", "WI-0003", "--to", "in-progress", "--actor",
                       "review-close", "--reason", "rejected, with reasons in review.md",
                       "--outcome", "delivered", "--force")
        note(refused.returncode != 0
             and "--outcome is only legal on a move to 'done'" in refused.stderr,
             "transition accepted --outcome on a legal move that does not end at done, or "
             "refused it for some other reason (F-083)")
        with open(history, "r", encoding="utf-8") as handle:
            note(handle.read() == before,
                 "transition wrote a history row for a move it refused")
        undone = tool("transition", "WI-0003", "--to", "done", "--actor", "review-close",
                      "--reason", "closing", "--force")
        note(undone.returncode != 0 and "must pass --outcome" in undone.stderr,
             "transition accepted a move to done carrying no outcome; the two fields are "
             "written by one act, or the workspace is invalid between them (F-083)")

        # The legal order, end to end: one command writes both fields, and the workspace it
        # produces does not carry the finding.
        closed = tool("transition", "WI-0003", "--to", "done", "--actor", "review-close",
                      "--outcome", "delivered", "--reason", "accepted; merging", "--force")
        note("status: done" in fields_of("WI-0003") and "outcome: delivered" in
             fields_of("WI-0003"),
             "the closing transition did not write the status and the outcome together:\n      "
             + (closed.stdout + closed.stderr).strip()[-300:])
        note("item.outcome.premature" not in codes(tool("validate-workspace")),
             "the legal order still produces item.outcome.premature")

        # ---- F-084: the version row ----------------------------------------------------
        journal = os.path.join(root, "tracker", "items", "WI-0002", "journal.md")
        # `new-item` writes the history row and no entry (F-036), so the item has no execution
        # for a version row to fall inside until one is written. Write it the only sanctioned
        # way — the tool stamps the heading from the clock and the contract (§0).
        subprocess.run([sys.executable, os.path.join(SCRIPTS, "journal-entry"), "WI-0002",
                        "--skill", "intake", "--root", root, "--body-file", "-",
                        "--status", "`draft` → `draft` (unchanged)"],
                       input=journal_body("intake", item="WI-0002",
                                          result="the item exists."),
                       capture_output=True, text=True, cwd=ROOT)
        with open(journal, "r", encoding="utf-8") as handle:
            entries = handle.read()
        stamps = re.findall(r"^## (\S+) — (\S+) ", entries, re.M)
        note(bool(stamps), "WI-0002 has no journal entry to match a version row against")
        during = stamps[-1][0] if stamps else "2026-01-01T00:00:00Z"
        actor = stamps[-1][1] if stamps else "intake"
        document = os.path.join(root, "docs", "architecture", "overview.md")

        def write_doc(when, by, made_for, header=None) -> None:
            head = header or (when, by, made_for)
            with open(document, "w", encoding="utf-8") as handle:
                handle.write(
                    f"---\ntitle: Overview\nversion: 1\nstatus: current\n"
                    f"updated: {head[0]}\nupdated-by: {head[1]}\nupdated-for: {head[2]}\n"
                    f"---\n\n# Overview\n\nThe shape of the system.\n\n## Change log\n\n"
                    f"| version | when | by | for | what changed |\n"
                    f"|---------|------|----|-----|--------------|\n"
                    f"| 1 | {when} | {by} | {made_for} | First version |\n")

        write_doc(during, actor, "WI-0002")
        note(not {code for code in codes(tool("validate-workspace"))
                  if code.startswith("doc.changelog.")},
             "a version row inside an execution of the skill and item it names was reported")
        write_doc("2029-01-01T00:00:00Z", actor, "WI-0002")
        note("doc.changelog.no-execution" in codes(tool("validate-workspace")),
             "a version row naming a time at which that skill was not executing on that item "
             "was not reported (F-084)")
        write_doc(during, actor, "WI-0002", header=("2029-01-01T00:00:00Z", actor, "WI-0002"))
        note("doc.changelog.header" in codes(tool("validate-workspace")),
             "a header that disagrees with its own top change-log row was not reported")
        write_doc(during, "the-architect", "WI-0002")
        note("doc.changelog.actor" in codes(tool("validate-workspace")),
             "a version row whose `by` is not a skill this pipeline has was not reported")
        write_doc(during, actor, "WI-9999")
        note("doc.changelog.for" in codes(tool("validate-workspace")),
             "a version row naming an item that does not exist was not reported")

        # The boundary, stated in spec/doc-header.md §3 and asserted here so that moving it
        # fails loudly: the same offending row against a CLOSED item is history, not a defect.
        write_doc("2029-01-01T00:00:00Z", actor, "WI-0001")
        note("doc.changelog.no-execution" not in codes(tool("validate-workspace")),
             "the execution match now fires on a row naming a done item. That may be an "
             "improvement, but it is a demand to repair a closed record: change "
             "spec/doc-header.md §3 and this case together, or not at all")

    if problems:
        runner.emit(label, False,
                    detail="\n".join(f"  - {problem}" for problem in problems))
        return
    runner.emit(f"{label} ({observations} observations)", True)


def check_silence_threshold(runner: Runner) -> None:
    """One threshold, three consumers — proved by moving it and watching all three move.

    `termination.silence.threshold_rounds` decides when a stakeholder who has not answered
    becomes a stakeholder who is gone, and three programs act on it: `record-halt` (which `next`
    runs at the halt, and which prints the count against it), `engagement-state` (which reaches
    the `abandoned` verdict) and `check-epic-signoff` (which accepts an ending because of it).
    Any two of them disagreeing about whether it is met is F-045's mechanism exactly — a gate and
    an orchestrator holding two readings of one rule — so a test that reads the default proves
    nothing. This one **changes the value** and requires each of the three to change its mind
    with it, over one unchanged workspace.

    It also proves the two properties the model rests on that no reading can show:

      * **the reader never writes.** `engagement-state` and `check-epic-signoff` are run over the
        log and it must come back byte-identical. Were a reader to record, the gate would advance
        the clock by being consulted (ADR-0011 §1.2);
      * **any inbound change resets the count.** An answer written into a `## Answer` moves the
        digest, so the trailing run restarts at 1 while the halt goes on — and nothing a skill
        writes does that, because nothing a skill writes is inbound (§1.3).
    """
    import tempfile
    tools = {name: os.path.join(SCRIPTS, name)
             for name in ("workspace-init", "new-item", "record-halt", "engagement-state",
                          "check-epic-signoff")}
    pipeline = os.path.join(ROOT, "methodology", "pipeline.yaml")
    label = "one silence threshold, three consumers (by execution)"
    if not all(os.path.isfile(path) for path in tools.values()) or not os.path.isfile(pipeline):
        runner.skip(label, "one of the silence scripts or pipeline.yaml is absent")
        return

    def elicitation(status):
        return ("---\nid: Q-001\nitem: WI-0001\nfrom-skill: refine\naddressed-to: human\n"
                "blocking: false\nkind: elicitation\n"
                f"status: {status}\ncreated: 2026-09-10T09:00:00Z\n---\n\n"
                "## Context\n\nThe first refinement round.\n\n"
                "## Question\n\nWhat else matters here that we have not asked about?\n\n"
                "## Answer\n\n\n## Consequences\n\n"
                "Closed unanswered at E4 by silence.\n")

    def decision(status, answer=""):
        return ("---\nid: Q-002\nitem: WI-0001\nfrom-skill: refine\naddressed-to: human\n"
                "blocking: true\nkind: decision\n"
                f"status: {status}\ncreated: 2026-09-10T09:05:00Z\n"
                + ("answered-at: 2026-09-10T10:00:00Z\nanswered-by: human\n"
                   if status == "answered" else "")
                + "---\n\n## Context\n\nTwo readings of the requirement.\n\n"
                "## Question\n\nWhich of these did you mean?\n\n"
                "## Options considered\n\n- **A** one\n- **B** the other\n\n"
                f"## Answer\n\n{answer}\n\n## Consequences\n\nNone yet.\n")

    def second_decision(status):
        return ("---\nid: Q-003\nitem: WI-0001\nfrom-skill: refine\naddressed-to: human\n"
                "blocking: true\nkind: decision\n"
                f"status: {status}\ncreated: 2026-09-10T09:06:00Z\n---\n\n"
                "## Context\n\nA second thing only they can settle.\n\n"
                "## Question\n\nAnd which of these?\n\n"
                "## Options considered\n\n- **A** one\n- **B** the other\n\n"
                "## Answer\n\n\n## Consequences\n\nNone yet.\n")

    observations, problems = 0, []
    with tempfile.TemporaryDirectory() as root:
        def run(script, *args, pipeline_path=None):
            command = [sys.executable, tools[script], *args, "--root", root]
            if pipeline_path:
                command += ["--pipeline", pipeline_path]
            return subprocess.run(command, capture_output=True, text=True, cwd=ROOT)

        def verdict(pipeline_path=None):
            result = run("engagement-state", "EP-001", pipeline_path=pipeline_path)
            first = (result.stdout + result.stderr).strip().split("\n")[0]
            return first.split()[-1] if first else ""

        def halt(pipeline_path=None):
            result = run("record-halt", pipeline_path=pipeline_path)
            return (result.stdout + result.stderr).strip()

        def gate(pipeline_path=None):
            return run("check-epic-signoff", "EP-001", pipeline_path=pipeline_path).returncode

        def observe(condition, complaint):
            nonlocal observations
            observations += 1
            if not condition:
                problems.append(complaint)

        subprocess.run([sys.executable, tools["workspace-init"], root],
                       capture_output=True, text=True, cwd=ROOT)
        for args in (("--id", "EP-001", "--type", "epic", "--title", "A goal", "--status",
                      "open", "--actor", "intake", "--reason", "from the raw idea"),
                     ("--id", "WI-0001", "--type", "work-item", "--epic", "EP-001", "--title",
                      "Do the thing", "--status", "draft", "--actor", "intake", "--reason",
                      "refined from the idea")):
            subprocess.run([sys.executable, tools["new-item"], "--root", root, *args],
                           capture_output=True, text=True, cwd=ROOT)
        questions = os.path.join(root, "tracker", "items", "WI-0001", "questions")
        write(os.path.join(questions, "Q-001.md"), elicitation("open"))
        write(os.path.join(questions, "Q-002.md"), decision("open"))

        log = os.path.join(root, "tracker", "waiting", "EP-001.md")
        with open(pipeline, "r", encoding="utf-8") as handle:
            original = handle.read()
        find = "    threshold_rounds: 3\n"
        if find not in original:
            runner.emit(label, False,
                        detail="  - termination.silence.threshold_rounds is no longer 3 in "
                               "pipeline.yaml; the case, not the rule, is stale")
            return
        raised = os.path.join(root, "raised.yaml")
        write(raised, original.replace(find, "    threshold_rounds: 5\n", 1))

        # --- the writer and the verdict, over one unchanged workspace -----------------------
        for expected in (1, 2):
            line = halt()
            observe(f"round {expected} of 3" in line,
                    f"record-halt at round {expected}: expected 'round {expected} of 3', got "
                    f"{line.splitlines()[0]!r}")
            observe(verdict() != "abandoned",
                    f"engagement-state called EP-001 abandoned at round {expected} of 3")
        line = halt()
        observe("round 3 of 3" in line and "threshold is reached" in line,
                f"record-halt at round 3: expected 'round 3 of 3' and the threshold reached, got "
                f"{line!r}")
        observe(verdict() == "abandoned",
                f"engagement-state at 3 rounds against a threshold of 3: expected 'abandoned', "
                f"got {verdict()!r}")
        # The move. Same workspace, same three rows, one different number in pipeline.yaml.
        observe(verdict(pipeline_path=raised) != "abandoned",
                "engagement-state still called EP-001 abandoned at 3 rounds against a threshold "
                "of 5 — it is not reading pipeline.yaml")
        line = halt(pipeline_path=raised)
        observe("round 4 of 5" in line and "threshold is reached" not in line,
                f"record-halt against a threshold of 5: expected 'round 4 of 5' and no "
                f"declaration, got {line!r}")
        line = halt(pipeline_path=raised)
        observe("round 5 of 5" in line and "threshold is reached" in line,
                f"record-halt at round 5 of 5: expected the threshold reached, got {line!r}")
        observe(verdict(pipeline_path=raised) == "abandoned",
                "engagement-state did not reach 'abandoned' at 5 rounds against a threshold of 5")

        # --- the reader never writes ---------------------------------------------------------
        before = read(log)
        verdict()
        verdict(pipeline_path=raised)
        gate()
        observe(read(log) == before,
                "the waiting log changed while it was only being read — a counting reader "
                "advances the clock by being consulted (ADR-0011 §1.2)")

        # --- the gate, across the same boundary ----------------------------------------------
        observe(gate() != 0,
                "check-epic-signoff passed EP-001 with no '## Ending statement' in review.md")
        write(os.path.join(questions, "Q-001.md"), elicitation("abandoned"))
        write(os.path.join(questions, "Q-002.md"), decision("abandoned"))
        write(os.path.join(root, "tracker", "items", "EP-001", "artifacts", "review.md"),
              "# Review — EP-001\n\n## Ending statement\n\nThe goal was to do the thing.\n\n"
              "WI-0001 — orphaned, never started.\n\nFive silent rounds; nothing came back.\n")
        observe(gate() == 0,
                "check-epic-signoff refused an E4 ending that meets every requirement: the "
                "threshold reached, an ask that stood unanswered, an ending statement naming "
                "every child")
        # Rewind the log to three rows: enough at a threshold of 3, not enough at 5.
        rows = read(log).rstrip("\n").split("\n")
        write(log, "\n".join(rows[:-2]) + "\n")
        observe(gate() == 0, "check-epic-signoff refused the ending at 3 rounds against a "
                             "threshold of 3")
        observe(gate(pipeline_path=raised) != 0,
                "check-epic-signoff accepted the ending at 3 rounds against a threshold of 5 — "
                "it is not reading pipeline.yaml")

        # --- any inbound change resets the count ---------------------------------------------
        # A **partial** answer, which is the row of ADR-0011 §1.3's table that carries the whole
        # argument: the count measures presence, not compliance. Q-003 stays outstanding across
        # the reply, so the halt goes on and the reset is visible in the count rather than in the
        # halt disappearing. Answering the last outstanding ask would end the halt instead, which
        # is a different (and correct) behaviour and proves nothing about the digest.
        write(os.path.join(questions, "Q-001.md"), elicitation("open"))
        write(os.path.join(questions, "Q-002.md"), decision("open"))
        write(os.path.join(questions, "Q-003.md"), second_decision("open"))
        halt()
        line = halt()
        observe("round 2 of 3" in line,
                f"a halt with nothing changed should have continued the run, got {line!r}")
        write(os.path.join(questions, "Q-002.md"),
              decision("answered", "B — and the second case matters too."))
        line = halt()
        observe("round 1 of 3" in line,
                f"a partial answer did not reset the count: expected 'round 1 of 3', got "
                f"{line!r}")
        observe(verdict() != "abandoned",
                "engagement-state called an engagement abandoned one round after the "
                "stakeholder answered")

    if problems:
        runner.emit(label, False, detail="\n".join(f"  - {problem}" for problem in problems))
        return
    runner.emit(f"{label} ({observations} observations)", True)


def check_halt_is_last(runner: Runner) -> None:
    """Which questions stop the loop, and where the halt belongs (F-097, F-104, F-109).

    ADR-0012 says one thing three programs have to agree on: the orchestrator stops on the human
    when, and only when, an **outstanding ask** exists — `addressed-to: human`, `open`,
    `blocking: true`, `## Answer` empty — and it stops there **last**, once nothing else is
    dispatchable. Three shipped rules disagreed with that, and each had a cost the record already
    carries:

      * a **standing ask** — `blocking: false`, the elicitation every engagement files at intake
        — halted the workspace and held rest, so an unanswered one put every ending out of reach,
        E1 included (F-104);
      * the halt sat above dispatch, so the first human question stopped every other item from
        stating its own, and a real run stepped outside the orchestrator to get past it (F-097);
      * a reply the stakeholder had already written was still a reason to stop and show it to
        them again (F-011's unfixed half, F-109).

    Prose cannot be tested, so what is tested is the three programs the prose moves:
    `engagement-state`'s rest, `record-halt`'s idea of a halt, and `check-epic-signoff`'s DE8.
    The scratch workspaces are built rather than banked because every case is a **transition**
    between two states of one engagement, and a fixture tree can hold only one of them.

    Both directions, every time. The must-fail half is not a stub here: it is the same workspace
    with one fact changed — a runnable item present, an outstanding ask still open, an
    elicitation the log never surfaced — and each must produce the opposite verdict.
    """
    import tempfile
    sys.path.insert(0, os.path.join(SCRIPTS, "lib"))
    label = "the halt is the last resort, and only an outstanding ask causes one (F-097, F-104)"
    try:
        import engagement as engagement_lib
        from workspace import Workspace
    except ImportError as exc:                       # pragma: no cover - the library is step 1
        runner.skip(label, f"scripts/lib is unusable: {exc}")
        return
    tools = {name: os.path.join(SCRIPTS, name)
             for name in ("workspace-init", "new-item", "record-halt", "engagement-state",
                          "check-epic-signoff")}
    signed = os.path.join(ROOT, "fixtures", "signed-off-epic")
    if not all(os.path.isfile(path) for path in tools.values()) or not os.path.isdir(signed):
        runner.skip(label, "one of the orchestrator scripts or fixtures/signed-off-epic is absent")
        return

    def question(identifier, item, blocking, status, kind=None, answer="", created="09:00:00"):
        return ("---\n"
                f"id: {identifier}\nitem: {item}\nfrom-skill: refine\naddressed-to: human\n"
                f"blocking: {'true' if blocking else 'false'}\n"
                + (f"kind: {kind}\n" if kind else "")
                + f"status: {status}\ncreated: 2026-09-10T{created}Z\n"
                + ("answered-at: 2026-09-10T12:00:00Z\nanswered-by: human\n"
                   if status in ("answered", "deferred") and kind != "elicitation" else "")
                + "---\n\n## Context\n\nThe first refinement round.\n\n"
                "## Question\n\nWhich of these did you mean?\n\n"
                "## Options considered\n\n- **A** one\n- **B** the other\n\n"
                # Filed empty means the placeholder comment, which is what `refine` writes and
                # what F-032 requires to be there. It is not a reply, and a predicate that read
                # it as one would call every freshly filed question answered.
                + f"## Answer\n\n{answer or '<!-- filled in by answer-questions -->'}\n\n"
                "## Consequences\n\nNone yet.\n")

    observations, problems = 0, []

    def observe(condition, complaint):
        nonlocal observations
        observations += 1
        if not condition:
            problems.append(complaint)

    with tempfile.TemporaryDirectory() as root:
        def run(script, *args):
            return subprocess.run([sys.executable, tools[script], *args, "--root", root],
                                  capture_output=True, text=True, cwd=ROOT)

        def halt():
            result = run("record-halt")
            return (result.stdout + result.stderr).strip()

        def verdict():
            result = run("engagement-state", "EP-001")
            return (result.stdout + result.stderr).strip()

        subprocess.run([sys.executable, tools["workspace-init"], root],
                       capture_output=True, text=True, cwd=ROOT)
        for args in (("--id", "EP-001", "--type", "epic", "--title", "A goal", "--status",
                      "open", "--actor", "intake", "--reason", "from the raw idea"),
                     ("--id", "WI-0001", "--type", "work-item", "--epic", "EP-001", "--title",
                      "Do the thing", "--status", "draft", "--actor", "intake", "--reason",
                      "refined from the idea"),
                     ("--id", "WI-0002", "--type", "work-item", "--epic", "EP-001", "--title",
                      "Do the other thing", "--status", "draft", "--actor", "intake", "--reason",
                      "refined from the idea")):
            subprocess.run([sys.executable, tools["new-item"], "--root", root, *args],
                           capture_output=True, text=True, cwd=ROOT)
        questions = os.path.join(root, "tracker", "items", "WI-0001", "questions")
        log = os.path.join(root, "tracker", "waiting", "EP-001.md")
        elicitation = os.path.join(questions, "Q-001.md")
        write(elicitation, question("Q-001", "WI-0001", False, "open", kind="elicitation"))
        write(os.path.join(questions, "Q-002.md"),
              question("Q-002", "WI-0001", True, "open", created="09:05:00"))

        # --- the four classes, read off the record ------------------------------------------
        # Q-002 is filed with `## Answer` holding the placeholder comment F-032 requires. It is
        # an outstanding ask, not a reply, and nothing below would notice if that were wrong.
        workspace = Workspace(root).load()
        epic = workspace.items["EP-001"]
        observe(engagement_lib.outstanding_asks(workspace, epic) == ["WI-0001/Q-002"],
                f"the outstanding ask is the blocking, unanswered, human-addressed one and "
                f"nothing else; got "
                f"{engagement_lib.outstanding_asks(workspace, epic)}")
        observe(engagement_lib.standing_asks(workspace, epic) == ["WI-0001/Q-001"],
                f"the elicitation is a standing ask; got "
                f"{engagement_lib.standing_asks(workspace, epic)}")

        # --- the stakeholder speaking outranks everything, the halt included ----------------
        request = os.path.join(root, "tracker", "requests", "R-001.md")
        write(request, "---\nid: R-001\nfrom: human\nstatus: open\n"
                       "created: 2026-09-10T09:10:00Z\n---\n\n"
                       "## Request\n\nCan it also do the other thing?\n\n"
                       "## Response\n\n\n## Consequences\n\n\n")
        line = halt()
        # The whole message is matched, not the ID: every one of these lines cites `ADR-0012`,
        # and "R-001" is a substring of it. The first draft of this case passed with the request
        # branch stubbed out entirely for exactly that reason.
        observe("has not halted" in line
                and "an open stakeholder request: R-001" in line,
                f"an open request is step 2 and outranks the halt: the stakeholder has spoken "
                f"and the pass has somewhere to go. record-halt should have recorded nothing "
                f"and named it; got {line!r}")
        write(request, read(request).replace("status: open", "status: accepted"))

        # --- F-097: a pass with work to do is not a halt ------------------------------------
        line = halt()
        observe("has not halted" in line and "WI-0002" in line,
                f"WI-0002 is runnable, so this pass had somewhere to go and is not a silent "
                f"round. record-halt should have recorded nothing and named it; got {line!r}")
        observe(not os.path.isfile(log),
                "a waiting row was written on a pass that had a runnable item — the count an "
                "ending rests on, inflated by the pipeline's own busyness (ADR-0012 §2.1)")

        # The must-fail direction of the same case: take the work away and the halt is real.
        write(os.path.join(root, "tracker", "items", "WI-0002", "item.md"),
              read(os.path.join(root, "tracker", "items", "WI-0002", "item.md"))
              .replace("status: draft", "status: done") + "")
        item_path = os.path.join(root, "tracker", "items", "WI-0002", "item.md")
        write(item_path, read(item_path).replace("\npriority:", "\noutcome: delivered\npriority:"))
        line = halt()
        observe("round 1 of 3" in line,
                f"with nothing runnable and an outstanding ask open, this pass IS the halt; got "
                f"{line!r}")
        observe("WI-0001/Q-001" in line and "WI-0001/Q-002" in line,
                f"a halt surfaces every open human-addressed question, the standing ask "
                f"included — it stops nothing and is still shown; got {line!r}")

        # --- F-109: a reply is answerable, not a reason to stop ------------------------------
        write(os.path.join(questions, "Q-003.md"),
              question("Q-003", "WI-0001", True, "open", created="09:06:00"))
        write(os.path.join(questions, "Q-002.md"),
              question("Q-002", "WI-0001", True, "open", answer="B, the second one.",
                       created="09:05:00"))
        rows_before = len(engagement_lib.read_waiting_log(root, "EP-001"))
        line = halt()
        observe("has not halted" in line and "WI-0001/Q-002" in line,
                f"a human-addressed question carrying a reply is ours to propagate, not a "
                f"reason to stop and show them the answer they just wrote (F-011, F-109); got "
                f"{line!r}")
        observe(len(engagement_lib.read_waiting_log(root, "EP-001")) == rows_before,
                "a waiting row was written on a pass whose only news was the stakeholder's own "
                "reply")

        # --- F-104: rest, with a standing ask and without --------------------------------
        write(os.path.join(questions, "Q-002.md"),
              question("Q-002", "WI-0001", True, "answered", answer="B, the second one.",
                       created="09:05:00"))
        observe("EP-001 active" in verdict(),
                "an outstanding ask (Q-003) is still open, so the engagement is not at rest — "
                "rest ignores a standing ask and nothing else")
        write(os.path.join(questions, "Q-003.md"),
              question("Q-003", "WI-0001", True, "answered", answer="A, this time.",
                       created="09:06:00"))
        write(item_path.replace("WI-0002", "WI-0001"),
              read(item_path.replace("WI-0002", "WI-0001"))
              .replace("status: draft", "status: done")
              .replace("\npriority:", "\noutcome: delivered\npriority:"))
        state = verdict()
        observe("EP-001 at-rest" in state,
                f"every child has stopped and the only open question is a standing ask, so the "
                f"engagement is at rest and review-close is due. Before ADR-0012 this workspace "
                f"reported 'active' for ever and no ending — E1 included — was reachable "
                f"(F-104). Got:\n      " + state.replace("\n", "\n      "))
        observe("WI-0001/Q-001" in state,
                f"the at-rest verdict must name the standing ask it passed over, or a reader "
                f"cannot tell an engagement with nothing open from one carrying an ask nobody "
                f"answered. Got:\n      " + state.replace("\n", "\n      "))
        line = halt()
        observe("no epic is halted" in line,
                f"a standing ask must never produce a silent round: it stops nothing, so an "
                f"engagement holding one is never declared abandoned over it (ADR-0012 §3); got "
                f"{line!r}")

    # --- DE8 at an ordinary ending: abandoned, and the evidence it was ever asked -----------
    import shutil
    with tempfile.TemporaryDirectory() as base:
        root = os.path.join(base, "ws")
        shutil.copytree(signed, root)
        gate = os.path.join(SCRIPTS, "check-epic-signoff")

        def signoff_gate():
            result = subprocess.run([sys.executable, gate, "EP-001", "--root", root],
                                    capture_output=True, text=True, cwd=ROOT)
            return result.returncode, (result.stdout + result.stderr).strip()

        code, _ = signoff_gate()
        observe(code == 0, "fixtures/signed-off-epic no longer passes the termination gate; "
                           "this case builds on it and proves nothing without it")
        target = os.path.join(root, "tracker", "items", "EP-001", "questions", "Q-002.md")
        body = read(target)
        abandoned = (body.split("## Answer")[0]
                     .replace("status: answered", "status: abandoned")
                     .replace("answered-at: ", "x-answered-at: ")
                     .replace("answered-by: ", "x-answered-by: ")
                     + "## Answer\n\n\n## Consequences\n\n"
                       "Closed unanswered at the ending; `artifacts/review.md` records it.\n")
        abandoned = "\n".join(line for line in abandoned.split("\n")
                               if not line.startswith("x-answered-"))
        write(target, abandoned)
        code, output = signoff_gate()
        observe(code != 0 and "never surfaced it" in output,
                f"an elicitation closed as 'abandoned' outside E4, with no waiting log at all, "
                f"claims nobody replied to a question the record cannot show anybody was ever "
                f"asked. The gate must refuse it; it exited {code} saying "
                f"{output.splitlines()[0] if output else '(nothing)'!r}")
        waiting = os.path.join(root, "tracker", "waiting", "EP-001.md")
        rows = ("| round | observed | inbound | surfaced |\n"
                "|-------|----------|---------|----------|\n"
                "| 1 | 2026-08-22T01:10:00Z | deadbeef | EP-001/Q-001 |\n")
        write(waiting, f"# Waiting log — EP-001\n\nAppend-only.\n\n{rows}")
        code, output = signoff_gate()
        observe(code != 0 and "never surfaced it" in output,
                f"a halt that surfaced the sign-off and not the elicitation is not evidence "
                f"that the elicitation reached anybody; the gate exited {code}")
        write(waiting, f"# Waiting log — EP-001\n\nAppend-only.\n\n{rows}"
                       "| 2 | 2026-08-22T01:20:00Z | deadbeef | EP-001/Q-001, EP-001/Q-002 |\n")
        code, output = signoff_gate()
        observe(code == 0,
                f"the log now shows the elicitation in front of the person at a halt, which is "
                f"what DE8 asks for where no reply ever came (ADR-0012 §4.1). The gate exited "
                f"{code}: {output.splitlines()[0] if output else '(nothing)'}")

    if problems:
        runner.emit(label, False, detail="\n".join(f"  - {problem}" for problem in problems))
        return
    runner.emit(f"{label} ({observations} observations)", True)


def check_process_gate_names(runner: Runner) -> None:
    """A gate the procedure names must exist in the contract (F-059).

    Injected rather than staged: the repository is copied, one skill's `process.md` is told to run
    a gate its `skill.yaml` does not declare, and `lint-skills` must report `process.gate.unknown`.
    F-049 and F-059 are the same class — prose and contract drifting apart with nothing reading
    both — and this is the first check that reads both.
    """
    import shutil
    import tempfile
    label = "a gate named in a procedure exists in its contract (F-059)"
    with tempfile.TemporaryDirectory() as base:
        copy = os.path.join(base, "repo")
        os.makedirs(copy)
        shutil.copytree(os.path.join(ROOT, "methodology"), os.path.join(copy, "methodology"))
        shutil.copytree(os.path.join(ROOT, "spec"), os.path.join(copy, "spec"))
        process = os.path.join(copy, "methodology", "skills", "verify", "process.md")
        with open(process, "r", encoding="utf-8") as handle:
            text = handle.read()
        write(process, text.replace(
            "## Self-check",
            "Run the `tests-are-green` gate before you finish.\n\n## Self-check", 1))
        result = subprocess.run([sys.executable, os.path.join(SCRIPTS, "lint-skills"), copy],
                                capture_output=True, text=True, cwd=ROOT)
        ok = (result.returncode != 0
              and "process.gate.unknown" in codes_from(result.stdout + result.stderr))
    runner.emit(label, ok, None if ok else result,
                detail="" if ok else "  a procedure may name a gate that does not exist, and "
                                     "nothing reads the prose against the contract")


def check_shipped_scripts(runner: Runner) -> None:
    """Every shipped script runs from the shipped tree, with only the shipped library beside it.

    F-072. `render.py` ships an explicit list of library modules, and the render check only proves
    the copy matches the source — not that the list is *complete*. Adding `scripts/lib/textio.py`
    and forgetting to ship it left `./scripts/check` entirely green while every consumer install
    would have died on `ImportError` at the first gate. That is the packaging break that no gate
    over the source tree can see, and the cheapest thing that sees it is running what ships.

    Each script is *imported*, not run: `runpy` with `run_name` left alone executes the module
    body — which is where the imports are — while the `if __name__ == "__main__"` guard keeps
    `main()` out of it. That tests exactly the thing that breaks and touches no workspace.
    """
    dist = os.path.join(ROOT, "adapters", "claude-code", "dist", "agile-skills", "scripts")
    if not os.path.isdir(dist):
        runner.skip("every shipped script imports", "there is no rendered dist yet")
        return
    broken = []
    names = sorted(name for name in os.listdir(dist)
                   if os.path.isfile(os.path.join(dist, name)) and not name.endswith((".yaml",
                                                                                     ".pyc")))
    program = ("import runpy, sys; sys.path.insert(0, sys.argv[2]); "
               "runpy.run_path(sys.argv[1], run_name='imported')")
    for name in names:
        result = subprocess.run(
            [sys.executable, "-c", program, os.path.join(dist, name),
             os.path.join(dist, "lib")], capture_output=True, text=True, cwd=dist)
        if result.returncode != 0:
            tail = (result.stdout + result.stderr).strip().split("\n")[-3:]
            broken.append(f"  - {name}: exit {result.returncode}\n" +
                          "\n".join(f"      {line}" for line in tail))
    if broken:
        runner.emit("every shipped script imports", False, detail="\n".join(broken))
    else:
        runner.emit(f"every shipped script imports ({len(names)} scripts, from dist/)", True)


def check_guard(runner: Runner) -> None:
    tests = os.path.join(ROOT, "adapters", "claude-code", "hooks", "test_guard.py")
    if not os.path.isfile(tests):
        runner.skip("write-guard self-test",
                    "adapters/claude-code/hooks/test_guard.py does not exist yet")
        return
    runner.run("write-guard self-test", [sys.executable, tests])


# Shas that legitimately belong to a *throwaway project's* repository rather than to this one.
# F-019 cites one; a finding may cite more. Anything not listed here must resolve in this repo.
FOREIGN_SHAS = {"234f170"}


def check_findings_citations(runner: Runner) -> None:
    """F-024: a citation that looks valid and is not is the failure F-001 is about.

    All ten commit citations written during builder session two pointed at orphaned pre-amend
    commits: the unit cycle was commit, read the sha, edit the ledger, `--amend`, so the sha
    recorded was always the one the amend replaced. They survived locally through the reflog, so
    every spot-check passed. `git merge-base --is-ancestor` is the check that fails.
    """
    ledger = os.path.join(ROOT, "meta", "findings", "FINDINGS.md")
    if not os.path.isfile(ledger):
        runner.skip("findings citations resolve", f"{ledger} does not exist")
        return
    with open(ledger, "r", encoding="utf-8") as handle:
        text = handle.read()
    import re
    # `commit <sha>` and `commits <sha>, <sha>, <sha>` — a fix that spans a session's worth of
    # units cites several, and the plural form went unchecked when this step only knew the
    # singular. A citation nobody verifies is the whole of F-024.
    shas = set()
    for group in re.findall(r"commits? ((?:[0-9a-f]{7,40})(?:\s*,\s*[0-9a-f]{7,40})*)", text):
        shas.update(part.strip() for part in group.split(","))
    cited = sorted(shas - FOREIGN_SHAS)
    if not cited:
        runner.skip("findings citations resolve", "the ledger cites no commits")
        return
    dangling = []
    for sha in cited:
        result = subprocess.run(["git", "merge-base", "--is-ancestor", sha, "HEAD"],
                                capture_output=True, text=True, cwd=ROOT)
        if result.returncode != 0:
            dangling.append(sha)
    if dangling:
        detail = ["these shas are cited in FINDINGS.md and are not in this repository's history:"]
        detail += [f"  - {sha}" for sha in dangling]
        detail.append("a commit recorded by amending the commit being cited is always orphaned;")
        detail.append("record the sha in a follow-up commit instead (F-024).")
        runner.emit("findings citations resolve", False, detail="\n".join(detail))
        return
    runner.emit(f"findings citations resolve ({len(cited)} cited)", True)


LEDGER = os.path.join("meta", "findings", "FINDINGS.md")

# The ledger's own numbering form. Every finding in meta/findings/FINDINGS.md is filed under a
# `## F-###` or `## H-###` heading and every citation in this repository is written the same way:
# `git ls-files -z | xargs -0 grep -ohE '\b[FH]-[0-9]{1,5}\b' | sort -u` returns three-digit
# forms and nothing else (measured 2026-09-10 over 8bd792a, 3276 occurrences). A citation
# written some other way — `F-71`, `F-0071` — is not one this sweep recognises, and none exists.
FINDING_REF = re.compile(r"\b([FH]-[0-9]{3})\b")
FINDING_HEADING = re.compile(r"^## ([FH]-[0-9]{3})\b")


def sweep_finding_refs(root: str, ledger_text=None, tracked=None) -> dict:
    """Resolve every `F-###` / `H-###` cited anywhere in the tree against the ledger (F-099).

    The opposite direction to `check_findings_citations`. That step resolves what the ledger
    cites *out* (commit shas); nothing resolved what the repository cites *in*. F-071 is the
    tombstone that proves the class: `meta/harness/evidence/iteration-3b/README.md:27` names a
    number that was never filed, and it named it for two months in a file nobody may edit.

    Scope, decided rather than inherited:

    * **Every git-tracked file**, no path excluded. Not `meta/**` only: a phantom shipped in
      `adapters/claude-code/dist/` reaches a user, a phantom in `fixtures/` is a fixture that
      teaches a wrong number, a phantom in `harness/` is in the instrument. Untracked files are
      not the record and are not read.
    * **`meta/harness/evidence/**` is read-only history and is swept anyway.** This function
      only reads; it reports `path:line` and never opens the file for writing. That is the whole
      requirement: the correction for a phantom banked in evidence is a **tombstone entry in the
      ledger** — which makes the standing citation resolve without the evidence being touched —
      exactly as F-071 was corrected. A tombstone therefore counts as filed, by construction:
      it is a `## ` heading like any other.
    * **A `## ` heading in the ledger files a number; it does not cite one.** Heading lines are
      skipped so the count is citations, not definitions. Every other occurrence inside
      FINDINGS.md is a citation and is resolved — including a finding that names itself, which
      resolves through its own heading, and including the quoted `"F-071"` inside F-071's own
      tombstone and inside F-099. That last is the shape worth naming: **the report of a phantom
      has to quote the phantom**, so a sweep with no tombstone mechanism would fail on the
      sentence that reports the failure. The tombstone is what makes reporting possible.
    * **There is no allowlist.** `FOREIGN_SHAS` exists above because a finding legitimately cites
      a throwaway repository's commit; nothing here legitimately cites a number that was never
      filed. `fixtures/` was searched for a deliberately-wrong finding citation before this was
      written and holds none — its wrong citations name items, files and questions, not findings.
      A fixture that one day needs one is a reason to add a named constant here, not a reason to
      exclude a directory now.
    * **A tracked path that is not readable text is named, never passed over.** One exists:
      `meta/harness/evidence/iteration-1-full/project` is a gitlink (mode 160000, an embedded
      repository), so its 129 files are outside `git ls-files` here. Checked by hand: they cite
      no finding number at all. H-016 is the reminder that a walker meeting a file it cannot
      decode must say so rather than crash or shrug.

    What it does not do: resolve a number that is only implied. `F-080..F-098` cites two numbers,
    not nineteen, and the seventeen in between are not checked because they are not written.
    """
    if ledger_text is None:
        with open(os.path.join(root, LEDGER), "r", encoding="utf-8") as handle:
            ledger_text = handle.read()
    filed = {match.group(1) for match in
             (FINDING_HEADING.match(line) for line in ledger_text.split("\n")) if match}
    if tracked is None:
        listing = subprocess.run(["git", "ls-files", "-z"], cwd=root,
                                 capture_output=True, text=True)
        tracked = [name for name in listing.stdout.split("\0") if name]
    citations = 0
    numbers = set()
    phantoms = {}
    unread = []
    for relative in tracked:
        try:
            with open(os.path.join(root, relative), "r", encoding="utf-8") as handle:
                lines = handle.read().split("\n")
        except (OSError, UnicodeDecodeError) as error:
            unread.append(f"{relative} — {type(error).__name__}")
            continue
        is_ledger = relative.replace(os.sep, "/") == LEDGER.replace(os.sep, "/")
        for number, line in enumerate(lines, 1):
            if is_ledger and FINDING_HEADING.match(line):
                continue
            for cited_number in FINDING_REF.findall(line):
                citations += 1
                numbers.add(cited_number)
                if cited_number not in filed:
                    phantoms.setdefault(cited_number, []).append(f"{relative}:{number}")
    return {"citations": citations, "numbers": numbers, "filed": filed,
            "phantoms": phantoms, "unread": unread, "files": len(tracked)}


def check_finding_refs(runner: Runner) -> None:
    """F-099, the other direction: a number cited into the ledger must be in the ledger."""
    label = "finding numbers cited resolve"
    if not os.path.isfile(os.path.join(ROOT, LEDGER)):
        runner.skip(label, f"{LEDGER} does not exist")
        return
    swept = sweep_finding_refs(ROOT)
    if not swept["citations"]:
        runner.skip(label, "no file in this repository cites a finding number")
        return
    if swept["phantoms"]:
        detail = ["these finding numbers are cited and match no `## ` heading in "
                  f"{LEDGER}:"]
        for cited_number in sorted(swept["phantoms"]):
            detail.append(f"  - {cited_number}, cited at:")
            detail += [f"      {site}" for site in swept["phantoms"][cited_number]]
        detail.append("a number that was never filed is corrected by a tombstone entry in the")
        detail.append("ledger, not by editing the file that cites it — meta/harness/evidence/**")
        detail.append("is read-only history (F-071's precedent; the class is F-099).")
        runner.emit(label, False, detail="\n".join(detail))
        return
    runner.emit(f"{label} ({swept['citations']} citations, {len(swept['numbers'])} numbers, "
                f"{len(swept['filed'])} filed, over {swept['files']} tracked files)", True)
    for entry in swept["unread"]:
        print(f"      not read as text, and checked by hand instead: {entry}")


STATUS_LINE = re.compile(r"^(\s*[-*]\s+|#{3,6}\s+)\**\s*Status\b", re.IGNORECASE)
SECTION = re.compile(r"^#{1,2} ")
READING_RULE = "The last status line in an entry is the current one."


def finding_statuses(text: str) -> list:
    """[(finding, [status lines])] in file order — the ledger read the way it must be read.

    F-112. The ledger is append-only, so a resolved finding keeps its original `Status:` line and
    the new one is appended below it: the LAST status line in an entry is the current one, and
    `grep 'Status: open'` names entries that were closed months ago. Two forms are recognised
    because two exist — a bullet, and the `### Status update ...` heading F-061's resolution is
    written as. A `#`/`##` heading that is not a finding closes the entry it follows, so the
    status lines under a section heading like `## Cluster 2 status` belong to nobody.
    """
    entries = []
    current = None
    for line in text.split("\n"):
        heading = FINDING_HEADING.match(line)
        if heading:
            current = (heading.group(1), [])
            entries.append(current)
        elif SECTION.match(line):
            current = None
        elif current is not None and STATUS_LINE.match(line):
            current[1].append(line.strip())
    return entries


def check_finding_statuses(runner: Runner) -> None:
    """F-112: every finding carries a status, and the file says which one is current."""
    label = "every finding's status is readable"
    path = os.path.join(ROOT, LEDGER)
    if not os.path.isfile(path):
        runner.skip(label, f"{LEDGER} does not exist")
        return
    with open(path, "r", encoding="utf-8") as handle:
        text = handle.read()

    # Non-vacuity, checked here rather than assumed: a reader that stopped seeing a missing
    # status would let this step pass on any input, so the step proves on a synthetic ledger
    # that it still sees one. The probe also carries both status forms and a section heading.
    # The probe's finding numbers are assembled rather than written, so that this file does not
    # cite three numbers the ledger has never filed — which is the sweep in step 17b (F-099).
    one, two, three = ("F-" + number for number in ("901", "902", "903"))
    probe = (f"## {one} — an entry nobody gave a status\n"
             "- Severity: none\n"
             "\n"
             f"## {two} — an entry with a bullet status\n"
             "- Status: open\n"
             "\n"
             f"## {three} — an entry resolved under a heading\n"
             "- Status: open\n"
             "### Status update — fixed\n"
             "\n"
             "## Cluster 9 status — a section heading, not a finding\n"
             "- Status: this belongs to no entry\n")
    seen = finding_statuses(probe)
    expected = [(one, 0), (two, 1), (three, 2)]
    if [(name, len(rows)) for name, rows in seen] != expected:
        runner.emit(label, False, detail=(
            "the ledger reader does not see what it must see on its own probe:\n"
            f"  expected {expected}\n"
            f"  got      {[(name, len(rows)) for name, rows in seen]}\n"
            "this step can only report a missing status if it can find one (F-112)."))
        return

    entries = finding_statuses(text)
    if not entries:
        runner.skip(label, f"{LEDGER} files no findings")
        return
    missing = [name for name, rows in entries if not rows]
    if missing:
        detail = ["these entries carry no status line at all, so a reader cannot tell a "
                  "tombstone from a finding nobody triaged:"]
        detail += [f"  - {name}" for name in missing]
        detail.append("every `## F-###`/`## H-###` entry carries one; a tombstone says it is a")
        detail.append("tombstone (F-112). The ledger is append-only: append, never rewrite.")
        runner.emit(label, False, detail="\n".join(detail))
        return
    if READING_RULE not in text:
        runner.emit(label, False, detail=(
            f"{LEDGER} does not state how to read a status. The file is append-only, so the\n"
            "LAST status line in an entry is the current one; without that sentence in the\n"
            f"header the obvious command reads the file wrongly (F-112). Expected: {READING_RULE!r}"))
        return
    appended = sum(1 for _, rows in entries if len(rows) > 1)
    runner.emit(f"{label} ({len(entries)} entries, every one with a status; "
                f"{appended} re-triaged at least once)", True)


def check_export(runner: Runner) -> None:
    """F-007 both ways: the product profile ships no workspace, and the guard can refuse."""
    import tempfile
    exporter = os.path.join(SCRIPTS, "export")
    example = os.path.join(ROOT, "examples", "toy-project")
    if not os.path.isfile(exporter) or not os.path.isdir(os.path.join(example, "tracker")):
        runner.skip("export profiles", "scripts/export or examples/toy-project is absent")
        return
    with tempfile.TemporaryDirectory() as base:
        destination = os.path.join(base, "exported")
        result = subprocess.run(
            [sys.executable, exporter, destination, "--root", example, "--profile", "product"],
            capture_output=True, text=True, cwd=ROOT)
        if result.returncode != 0:
            runner.emit("export profiles", False, result)
            return
        strays = []
        for walk_base, dirs, files in os.walk(destination):
            dirs[:] = [entry for entry in dirs if entry != ".git"]
            for name in files:
                relative = os.path.relpath(os.path.join(walk_base, name), destination)
                if relative.split(os.sep)[0] in ("tracker", "docs", ".claude"):
                    strays.append(relative)
        if strays:
            runner.emit("export profiles", False,
                        detail="the product profile exported workspace files:\n"
                               + "\n".join(f"  - {name}" for name in strays[:10]))
            return
        # And the destination must be a repository with exactly one commit and no ancestry.
        log = subprocess.run(["git", "log", "--oneline"], cwd=destination,
                             capture_output=True, text=True)
        if log.returncode != 0 or len(log.stdout.strip().split("\n")) != 1:
            runner.emit("export profiles", False, log,
                        detail="the export should be a fresh repository with one commit")
            return
        # Refusing to overwrite is part of "non-destructive"; prove it can say no.
        again = subprocess.run(
            [sys.executable, exporter, destination, "--root", example, "--profile", "product"],
            capture_output=True, text=True, cwd=ROOT)
        if again.returncode == 0:
            runner.emit("export profiles", False, again,
                        detail="exporting over an existing directory should refuse without "
                               "--force")
            return
    runner.emit("export profiles", True)


def check_harness(runner: Runner) -> None:
    tests = os.path.join(ROOT, "harness", "tests", "test_harness.py")
    if not os.path.isfile(tests):
        runner.skip("harness self-test", "harness/tests/test_harness.py does not exist yet")
        return
    runner.run("harness self-test", [sys.executable, tests])


def check_criterion_identity(runner: Runner) -> None:
    """A citation that keeps resolving, and a tick that hides what settled it (F-094, F-096).

    One throwaway workspace, both findings, both directions of every rule that moved.

    **F-094.** `ITEM ACn` is a position in a list. The list is renumbered here, under two
    standing citations, and the point of the block is the pair: the bare number goes on
    resolving against a criterion nobody meant, and the anchored one fails. The refusal window —
    `draft` and `ready`, where `work-item.md` §2 still permits the rewrite — is exercised at its
    two edges, because a rule scoped to a status is a rule that stops at the next one.

    **F-096.** The `- [~]` mark and the two rules that hold it up. The shape follows
    `scripts/lib/scope.py`'s out-of-scope-by-construction: a pass that is not an ordinary pass
    **exits 0 and says so in its own words**. So the cases assert both halves — that a done item
    settled entirely by substitution does **not** report `item.criteria.unticked` (D1 holds, and
    the same item with the box unticked does report it), and that the warning is there saying
    what settled it.
    """
    import tempfile
    tools = {name: os.path.join(SCRIPTS, name)
             for name in ("workspace-init", "validate-workspace")}
    if not all(os.path.isfile(path) for path in tools.values()):
        runner.skip("a criterion's identity (F-094, F-096)", "one of the scripts is absent")
        return

    settled = ("- [ ] AC1 — the tool prints one row per regular file\n"
               "- [ ] AC2 — rows are sorted by descending line count, ties broken by\n"
               "  filename ascending\n")
    renumbered = ("- [ ] AC1 — a path that does not exist prints an error and exits 2\n"
                  "- [ ] AC2 — the tool prints one row per regular file\n"
                  "- [ ] AC3 — rows are sorted by descending line count, ties broken by\n"
                  "  filename ascending\n")

    def item_text(identifier, status, criteria, outcome=None):
        return ("---\n"
                f"id: {identifier}\ntype: work-item\ntitle: An item under citation\n"
                f"status: {status}\npriority: high\nepic: EP-001\n"
                "created: 2026-08-16T09:00:00Z\nupdated: 2026-08-16T09:00:00Z\n"
                + (f"outcome: {outcome}\n" if outcome else "")
                + "---\n\n## Story\n\nAs a reader, I want rows, so that I can see them.\n\n"
                "## Acceptance criteria\n\n" + criteria
                + "\n## Out of scope\n\n- Everything else.\n")

    question = ("---\nid: Q-004\nitem: WI-0001\nfrom-skill: verify\n"
                "addressed-to: stakeholder\nblocking: false\nstatus: open\n"
                "created: 2026-08-16T09:00:00Z\n---\n\n## Context\n\nAC2 names a restart.\n\n"
                "## Question\n\nDoes the syscall trace settle it, or should AC2 be reworded?\n\n"
                "## Options considered\n\n- **A —** reword. Consequence: a round trip.\n"
                "- **Recommendation:** none, insufficient basis.\n\n## Answer\n\n"
                "## Consequences\n\n")

    problems, observations = [], 0

    with tempfile.TemporaryDirectory() as root:
        subprocess.run([sys.executable, tools["workspace-init"], root],
                       capture_output=True, text=True, cwd=ROOT)

        def note(ok, message):
            nonlocal observations
            observations += 1
            if not ok:
                problems.append(message)

        def validate():
            result = subprocess.run([sys.executable, tools["validate-workspace"], root],
                                    capture_output=True, text=True, cwd=ROOT)
            return result.stdout + result.stderr

        def lines_for(output, code):
            return [line for line in output.split("\n") if f"[{code}]" in line]

        def put(identifier, status, criteria, outcome=None):
            path = os.path.join(root, "tracker", "items", identifier)
            os.makedirs(path, exist_ok=True)
            write(os.path.join(path, "item.md"),
                  item_text(identifier, status, criteria, outcome))

        def cite(*citations):
            body = "# Notes\n\n"
            for index, citation in enumerate(citations, start=1):
                body += f"Sentence {index} is only ever true [src: {citation}].\n\n"
            write(os.path.join(root, "docs", "product", "notes.md"), body)

        # ---- F-094 -----------------------------------------------------------------
        put("WI-0002", "draft", settled)
        cite("WI-0002 AC2")
        output = validate()
        refusals = lines_for(output, "claim.citation.unresolved")
        note(len(refusals) == 1 and "may still be renumbered" in refusals[0],
             "a bare ACn citation to an item at draft should be refused, and say why; got: "
             + "; ".join(refusals or ["nothing"]))
        note(any("sorted by descending" in line for line in refusals),
             "the refusal should quote the criterion's words back so the anchor can be pasted in")

        # The anchor quotes the criterion's *second* line: a criterion long enough to be worth
        # citing is usually long enough to wrap, and a rule that read only the first line would
        # be satisfied or defeated by where the author pressed return.
        cite('WI-0002 AC2 "ties broken by filename ascending"')
        note(not lines_for(validate(), "claim.citation.unresolved"),
             "an anchored citation should resolve at draft, where a bare number may not — and "
             "the anchor may quote any part of the criterion, wrap included")

        put("WI-0002", "ready", settled)
        cite("WI-0002 AC2")
        note(len(lines_for(validate(), "claim.citation.unresolved")) == 1,
             "`ready` is inside the window: the criteria may still be rewritten there")

        put("WI-0002", "verifying", settled)
        cite("WI-0002 AC2")
        note(not lines_for(validate(), "claim.citation.unresolved"),
             "past `ready` a bare number resolves; requiring an anchor everywhere would "
             "invalidate 84 standing citations, and §4a forbids that")

        # The finding itself: one insertion at the top of the list, two standing citations.
        cite("WI-0002 AC2", 'WI-0002 AC2 "ties broken by filename ascending"')
        note(not lines_for(validate(), "claim.citation.unresolved"),
             "both citations should resolve before the renumbering")
        put("WI-0002", "verifying", renumbered)
        broken = lines_for(validate(), "claim.citation.unresolved")
        note(len(broken) == 1 and "does not say" in broken[0],
             "after the renumbering exactly one of the two should fail — the anchored one; got: "
             + "; ".join(broken or ["nothing"]))
        note(all("Sentence 1" not in line for line in broken)
             and any(":5:" in line or line.strip().startswith("docs/") for line in broken),
             "the bare number is the one that silently follows the renumbering")

        # ---- F-096 -----------------------------------------------------------------
        cite("WI-0002 AC1")
        os.makedirs(os.path.join(root, "tracker", "items", "WI-0001", "questions"),
                    exist_ok=True)
        write(os.path.join(root, "tracker", "items", "WI-0001", "questions", "Q-004.md"),
              question)

        # The question is cited on the criterion's continuation line — where a real one lands.
        unasked = ("- [x] AC1 — the tool prints one row per regular file\n"
                   "- [~] AC2 — the machine has been restarted and the deck\n"
                   "  survives\n")
        put("WI-0001", "in-review", unasked)
        output = validate()
        note(len(lines_for(output, "item.criteria.substitution.unasked")) == 1,
             "a substituted tick naming no question should be refused")
        note(not lines_for(output, "item.criteria.substituted"),
             "the warning is the mark on a legal substitution, not on an unasked one")

        elsewhere = unasked.replace("  survives\n", "  survives [src: WI-0002/Q-004]\n")
        put("WI-0001", "in-review", elsewhere)
        output = validate()
        note(len(lines_for(output, "item.criteria.substitution.unasked")) == 1,
             "a question on another item is not this criterion's wording going back")

        absent = unasked.replace("  survives\n", "  survives [src: WI-0001/Q-009]\n")
        put("WI-0001", "in-review", absent)
        output = validate()
        note(not lines_for(output, "item.criteria.substitution.unasked")
             and any("Q-009" in line
                     for line in lines_for(output, "claim.citation.unresolved")),
             "a named question that does not exist is the citation rule's finding, not a "
             "second copy of it here")

        legal = unasked.replace("  survives\n", "  survives [src: WI-0001/Q-004]\n")
        put("WI-0001", "in-review", legal)
        output = validate()
        marks = lines_for(output, "item.criteria.substituted")
        note(not lines_for(output, "item.criteria.substitution.unasked")
             and len(marks) == 1,
             "a substitution that names a question on this item is legal, and marked")
        note("WARNING" in (marks[0] if marks else "")
             and "not by the observation it names" in (marks[0] if marks else ""),
             "the mark is a warning in its own words — a pass that is not an ordinary pass may "
             "not be spelled the same as one (scope.py's precedent)")

        # D1 holds on a substitution, and only on a substitution.
        put("WI-0001", "done", legal, outcome="delivered")
        note(not lines_for(validate(), "item.criteria.unticked"),
             "a substituted criterion is settled: D1 must close on it")
        put("WI-0001", "done", legal.replace("- [~] AC2", "- [ ] AC2"), outcome="delivered")
        note(len(lines_for(validate(), "item.criteria.unticked")) == 1,
             "and the same item with the box unticked must still be refused, or the case above "
             "proves nothing")

    label = f"a criterion's identity: citation and tick (F-094, F-096) ({observations} cases)"
    runner.emit(label, not problems, detail="\n".join(problems))


def main() -> int:
    runner = Runner()
    runner.run("library self-test", [sys.executable, os.path.join(SCRIPTS, "lib", "selftest.py")])
    runner.run("lint-skills", [sys.executable, os.path.join(SCRIPTS, "lint-skills")])
    check_fixture(runner)
    check_render(runner)
    check_example(runner)
    check_claims(runner)
    check_mention_is_not_a_verdict(runner)
    check_document_window(runner)
    check_document_obligations(runner)
    check_cross_answers(runner)
    check_retro(runner)
    check_retro_is_additive(runner)
    check_accepted_gaps(runner)
    check_adr_correction(runner)
    check_signoff(runner)
    check_termination(runner)
    check_abandoned(runner)
    check_pipeline_faults(runner)
    check_obligation_binding(runner)
    check_derived_model(runner)
    check_journal_body(runner)
    check_gate_verdicts(runner)
    check_gate_subject(runner)
    check_trial_merge(runner)
    check_record_catches_up(runner)
    check_criterion_identity(runner)
    check_silence_threshold(runner)
    check_halt_is_last(runner)
    check_process_gate_names(runner)
    check_shipped_scripts(runner)
    check_guard(runner)
    check_findings_citations(runner)
    check_finding_refs(runner)
    check_finding_statuses(runner)
    check_export(runner)
    check_harness(runner)

    print()
    if runner.failures:
        print(f"check: FAILED — {len(runner.failures)} step(s): "
              f"{', '.join(runner.failures)}")
    else:
        print("check: all steps passed")
    if runner.skips:
        print(f"check: {len(runner.skips)} step(s) SKIPPED — {', '.join(runner.skips)}")
        print("       a skipped step checks nothing; it is not a pass")
    return 1 if runner.failures else 0


if __name__ == "__main__":
    raise SystemExit(main())
