#!/usr/bin/env python3
"""The gate this repository must pass. Run: scripts/check

Steps, in order:
  1. scripts/lib/selftest.py                 — the parsing layer everything else stands on
  2. scripts/lint-skills                     — the methodology against spec/skill-contract.md
  3. must-fail fixture                       — validate-workspace over fixtures/broken-workspace,
                                               asserting the emitted finding codes equal
                                               EXPECTED-CODES.txt exactly
  4. rendered adapter output is current      — re-render and compare with the committed dist
  5. must-pass workspace                     — validate-workspace over examples/toy-project
  6. claim-provenance fixtures              — scripts/lint-claims must find both defects in
                                               fixtures/broken-workspace and nothing at all in
                                               fixtures/sourced-claims
  7. epic sign-off gate                      — scripts/check-epic-signoff refuses the broken
                                               fixture's epic and passes the sourced-claims one
  8. pipeline invariants                     — lint-skills must report the expected finding code
                                               for each defect reintroduced into pipeline.yaml
  9. write-guard self-test                   — adapters/claude-code/hooks/test_guard.py: the
                                               guard denies every way of writing a protected
                                               file and allows every way of reading or naming one
 10. findings citations resolve             — every `commit <sha>` cited in
                                               meta/findings/FINDINGS.md is an ancestor of HEAD
 11. export profiles                        — scripts/export leaves the workspace behind, and
                                               refuses to write a workspace file into a copy
 12. harness self-test                       — harness/tests/test_harness.py: the contamination
                                               assertions fire on transcripts that must be
                                               rejected, and pass on ones that must not

Steps 4 and 5 report **SKIP** with a reason when their inputs do not exist yet, and a skip is
printed as loudly as a failure. A gate that quietly checks nothing is the thing this file exists
to prevent.
"""

from __future__ import annotations

import os
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SCRIPTS = os.path.join(ROOT, "scripts")


class Runner:
    def __init__(self) -> None:
        self.failures = []
        self.skips = []

    def run(self, label: str, argv: list, expect_zero: bool = True) -> subprocess.CompletedProcess:
        result = subprocess.run(argv, capture_output=True, text=True, cwd=ROOT)
        ok = (result.returncode == 0) if expect_zero else (result.returncode != 0)
        self.emit(label, ok, result)
        return result

    def emit(self, label, ok, result=None, detail="") -> None:
        print(f"{'PASS' if ok else 'FAIL'}  {label}")
        if not ok:
            self.failures.append(label)
            if result is not None:
                for stream in (result.stdout, result.stderr):
                    for line in (stream or "").rstrip().split("\n"):
                        if line:
                            print(f"      {line}")
            if detail:
                for line in detail.rstrip().split("\n"):
                    print(f"      {line}")

    def skip(self, label: str, reason: str) -> None:
        print(f"SKIP  {label}")
        print(f"      {reason}")
        self.skips.append(label)


def codes_from(output: str) -> set:
    found = set()
    for line in output.split("\n"):
        for level in ("ERROR [", "WARNING ["):
            index = line.find(level)
            if index != -1:
                start = index + len(level)
                end = line.find("]", start)
                if end != -1:
                    found.add(line[start:end])
    return found


def check_fixture(runner: Runner) -> None:
    fixture = os.path.join(ROOT, "fixtures", "broken-workspace")
    expected_path = os.path.join(fixture, "EXPECTED-CODES.txt")
    if not os.path.isfile(expected_path):
        runner.skip("must-fail fixture", f"{expected_path} does not exist")
        return
    result = subprocess.run([sys.executable, os.path.join(SCRIPTS, "validate-workspace"),
                             fixture], capture_output=True, text=True, cwd=ROOT)
    if result.returncode == 0:
        runner.emit("must-fail fixture", False, result,
                    detail="the deliberately broken fixture validated clean")
        return
    with open(expected_path, "r", encoding="utf-8") as handle:
        expected = {line.strip() for line in handle if line.strip()}
    actual = codes_from(result.stdout + result.stderr)
    missing = sorted(expected - actual)
    extra = sorted(actual - expected)
    if missing or extra:
        detail = []
        if missing:
            detail.append("rules that stopped firing (present in EXPECTED-CODES.txt, not "
                          "emitted):")
            detail += [f"  - {code}" for code in missing]
        if extra:
            detail.append("codes emitted that EXPECTED-CODES.txt does not list:")
            detail += [f"  + {code}" for code in extra]
        detail.append("if this change is intended, update EXPECTED-CODES.txt in the same "
                      "commit and say why")
        runner.emit("must-fail fixture", False, detail="\n".join(detail))
    else:
        runner.emit(f"must-fail fixture ({len(expected)} codes)", True)


def check_render(runner: Runner) -> None:
    renderer = os.path.join(ROOT, "adapters", "claude-code", "render.py")
    if not os.path.isfile(renderer):
        runner.skip("rendered output is current", "the adapter renderer does not exist yet")
        return
    runner.run("rendered output is current",
               [sys.executable, renderer, "--check"])


def check_example(runner: Runner) -> None:
    example = os.path.join(ROOT, "examples", "toy-project")
    if not os.path.isdir(os.path.join(example, "tracker")):
        runner.skip("must-pass workspace", "examples/toy-project has no workspace yet")
        return
    runner.run("must-pass workspace",
               [sys.executable, os.path.join(SCRIPTS, "validate-workspace"), example])


def check_claims(runner: Runner) -> None:
    linter = os.path.join(SCRIPTS, "lint-claims")
    broken = os.path.join(ROOT, "fixtures", "broken-workspace")
    clean = os.path.join(ROOT, "fixtures", "sourced-claims")
    if not os.path.isfile(linter) or not os.path.isdir(clean):
        runner.skip("claim-provenance fixtures", "scripts/lint-claims or its fixtures are absent")
        return
    result = subprocess.run([sys.executable, linter, "--root", broken, "--all"],
                            capture_output=True, text=True, cwd=ROOT)
    found = codes_from(result.stdout + result.stderr)
    expected = {"claim.citation.unresolved", "claim.unsourced"}
    if result.returncode == 0 or not expected <= found:
        runner.emit("claim-provenance fixtures", False, result,
                    detail=f"expected {sorted(expected)} over the broken fixture, "
                           f"found {sorted(found)}")
        return
    # A rule nobody can satisfy is not a rule: prose that cites its sources must pass cleanly.
    runner.run("claim-provenance fixtures",
               [sys.executable, linter, "--root", clean, "--all"])
    # And the form the GATE actually runs. `--all` and `--changed-since` take different code
    # paths, and a preflight caught the second one crashing while the first was green — the
    # fixtures proved the rules and never proved the invocation.
    runner.run("claim-provenance as the gate invokes it",
               [sys.executable, linter, "--root", clean, "--changed-since", "HEAD"])


def check_signoff(runner: Runner) -> None:
    """DE7 both ways: an epic with no usable sign-off is refused, one with a real one passes."""
    gate = os.path.join(SCRIPTS, "check-epic-signoff")
    broken = os.path.join(ROOT, "fixtures", "broken-workspace")
    clean = os.path.join(ROOT, "fixtures", "signed-off-epic")
    if not os.path.isfile(gate) or not os.path.isdir(clean):
        runner.skip("epic sign-off gate", "scripts/check-epic-signoff or its fixtures are absent")
        return
    runner.run("epic sign-off gate refuses an unaccepted epic",
               [sys.executable, gate, "EP-001", "--root", broken], expect_zero=False)
    runner.run("epic sign-off gate",
               [sys.executable, gate, "EP-001", "--root", clean])


# Each entry: a label, an edit to methodology/pipeline.yaml, and the finding code lint-skills
# must report. Every one of these is a defect a real run found, restated as an invariant — the
# point of the step is that flipping the rule back reproduces the finding.
PIPELINE_FAULTS = [
    ("an epic ending that is not gated (F-045)",
     ("    actor: review-close\n    applies_to: [epic]\n    gated: true\n"
      "    resume_to: required\n",
      "    actor: review-close\n    applies_to: [epic]\n"
      "    resume_to: required\n"),
     "transition.ending.ungated"),
    ("an epic ending any skill may make (ADR-0006 §2)",
     ("  - from: open\n    to: blocked\n    actor: review-close\n",
      "  - from: open\n    to: blocked\n    actor: any\n"),
     "transition.ending.actor"),
    ("a creation row with no provenance (F-029)",
     ("    provenance: The question whose answer widened the scope, as arose-from ITEM/Q-###.\n",
      ""),
     "transition.creation.provenance"),
    ("a transition scoped to an item type that does not exist",
     ("    to: draft\n    actor: refine\n    applies_to: [work-item]\n",
      "    to: draft\n    actor: refine\n    applies_to: [work-itme]\n"),
     "transition.applies_to.unknown"),
    ("an epic that cannot be suspended (F-013)",
     ("  - name: open\n    applies_to: [epic]\n    owner: null\n    terminal: true\n"
      "    suspendable: true\n",
      "  - name: open\n    applies_to: [epic]\n    owner: null\n    terminal: true\n"
      "    suspendable: false\n"),
     "pipeline.status.unsuspendable"),
]


def check_pipeline_faults(runner: Runner) -> None:
    """Every pipeline invariant, proven to fire by reintroducing the defect it came from.

    lint-skills has no fixture directory of its own: it lints `methodology/`, and there is one
    of those. So the step copies the tree, injects one fault at a time, and asserts the expected
    code comes back — which is the same bargain `fixtures/broken-workspace` strikes for the
    workspace validator. A rule nobody has watched fail is a rule nobody knows works.
    """
    import shutil
    import tempfile
    linter = os.path.join(SCRIPTS, "lint-skills")
    source = os.path.join(ROOT, "methodology", "pipeline.yaml")
    if not os.path.isfile(linter) or not os.path.isfile(source):
        runner.skip("pipeline invariants refuse each injected fault",
                    "scripts/lint-skills or methodology/pipeline.yaml is absent")
        return
    with open(source, "r", encoding="utf-8") as handle:
        original = handle.read()
    problems = []
    with tempfile.TemporaryDirectory() as base:
        root = os.path.join(base, "tree")
        os.makedirs(root)
        for name in ("methodology", "spec"):
            shutil.copytree(os.path.join(ROOT, name), os.path.join(root, name))
        target = os.path.join(root, "methodology", "pipeline.yaml")
        for label, (find, replace), code in PIPELINE_FAULTS:
            if find not in original:
                problems.append(f"{label}: the text this fault edits is no longer in "
                                f"pipeline.yaml — the fault, not the rule, is stale")
                continue
            with open(target, "w", encoding="utf-8") as handle:
                handle.write(original.replace(find, replace, 1))
            result = subprocess.run([sys.executable, linter, root],
                                    capture_output=True, text=True, cwd=ROOT)
            if result.returncode == 0:
                problems.append(f"{label}: lint-skills passed; expected [{code}]")
            elif f"[{code}]" not in result.stdout:
                problems.append(f"{label}: lint-skills failed without reporting [{code}]")
    if problems:
        runner.emit("pipeline invariants refuse each injected fault", False,
                    detail="\n".join(f"  - {problem}" for problem in problems))
        return
    runner.emit(f"pipeline invariants refuse each injected fault "
                f"({len(PIPELINE_FAULTS)} faults)", True)


def check_guard(runner: Runner) -> None:
    tests = os.path.join(ROOT, "adapters", "claude-code", "hooks", "test_guard.py")
    if not os.path.isfile(tests):
        runner.skip("write-guard self-test",
                    "adapters/claude-code/hooks/test_guard.py does not exist yet")
        return
    runner.run("write-guard self-test", [sys.executable, tests])


# Shas that legitimately belong to a *throwaway project's* repository rather than to this one.
# F-019 cites one; a finding may cite more. Anything not listed here must resolve in this repo.
FOREIGN_SHAS = {"234f170"}


def check_findings_citations(runner: Runner) -> None:
    """F-024: a citation that looks valid and is not is the failure F-001 is about.

    All ten commit citations written during builder session two pointed at orphaned pre-amend
    commits: the unit cycle was commit, read the sha, edit the ledger, `--amend`, so the sha
    recorded was always the one the amend replaced. They survived locally through the reflog, so
    every spot-check passed. `git merge-base --is-ancestor` is the check that fails.
    """
    ledger = os.path.join(ROOT, "meta", "findings", "FINDINGS.md")
    if not os.path.isfile(ledger):
        runner.skip("findings citations resolve", f"{ledger} does not exist")
        return
    with open(ledger, "r", encoding="utf-8") as handle:
        text = handle.read()
    import re
    cited = sorted(set(re.findall(r"commit ([0-9a-f]{7,40})\b", text)) - FOREIGN_SHAS)
    if not cited:
        runner.skip("findings citations resolve", "the ledger cites no commits")
        return
    dangling = []
    for sha in cited:
        result = subprocess.run(["git", "merge-base", "--is-ancestor", sha, "HEAD"],
                                capture_output=True, text=True, cwd=ROOT)
        if result.returncode != 0:
            dangling.append(sha)
    if dangling:
        detail = ["these shas are cited in FINDINGS.md and are not in this repository's history:"]
        detail += [f"  - {sha}" for sha in dangling]
        detail.append("a commit recorded by amending the commit being cited is always orphaned;")
        detail.append("record the sha in a follow-up commit instead (F-024).")
        runner.emit("findings citations resolve", False, detail="\n".join(detail))
        return
    runner.emit(f"findings citations resolve ({len(cited)} cited)", True)


def check_export(runner: Runner) -> None:
    """F-007 both ways: the product profile ships no workspace, and the guard can refuse."""
    import tempfile
    exporter = os.path.join(SCRIPTS, "export")
    example = os.path.join(ROOT, "examples", "toy-project")
    if not os.path.isfile(exporter) or not os.path.isdir(os.path.join(example, "tracker")):
        runner.skip("export profiles", "scripts/export or examples/toy-project is absent")
        return
    with tempfile.TemporaryDirectory() as base:
        destination = os.path.join(base, "exported")
        result = subprocess.run(
            [sys.executable, exporter, destination, "--root", example, "--profile", "product"],
            capture_output=True, text=True, cwd=ROOT)
        if result.returncode != 0:
            runner.emit("export profiles", False, result)
            return
        strays = []
        for walk_base, dirs, files in os.walk(destination):
            dirs[:] = [entry for entry in dirs if entry != ".git"]
            for name in files:
                relative = os.path.relpath(os.path.join(walk_base, name), destination)
                if relative.split(os.sep)[0] in ("tracker", "docs", ".claude"):
                    strays.append(relative)
        if strays:
            runner.emit("export profiles", False,
                        detail="the product profile exported workspace files:\n"
                               + "\n".join(f"  - {name}" for name in strays[:10]))
            return
        # And the destination must be a repository with exactly one commit and no ancestry.
        log = subprocess.run(["git", "log", "--oneline"], cwd=destination,
                             capture_output=True, text=True)
        if log.returncode != 0 or len(log.stdout.strip().split("\n")) != 1:
            runner.emit("export profiles", False, log,
                        detail="the export should be a fresh repository with one commit")
            return
        # Refusing to overwrite is part of "non-destructive"; prove it can say no.
        again = subprocess.run(
            [sys.executable, exporter, destination, "--root", example, "--profile", "product"],
            capture_output=True, text=True, cwd=ROOT)
        if again.returncode == 0:
            runner.emit("export profiles", False, again,
                        detail="exporting over an existing directory should refuse without "
                               "--force")
            return
    runner.emit("export profiles", True)


def check_harness(runner: Runner) -> None:
    tests = os.path.join(ROOT, "harness", "tests", "test_harness.py")
    if not os.path.isfile(tests):
        runner.skip("harness self-test", "harness/tests/test_harness.py does not exist yet")
        return
    runner.run("harness self-test", [sys.executable, tests])


def main() -> int:
    runner = Runner()
    runner.run("library self-test", [sys.executable, os.path.join(SCRIPTS, "lib", "selftest.py")])
    runner.run("lint-skills", [sys.executable, os.path.join(SCRIPTS, "lint-skills")])
    check_fixture(runner)
    check_render(runner)
    check_example(runner)
    check_claims(runner)
    check_signoff(runner)
    check_pipeline_faults(runner)
    check_guard(runner)
    check_findings_citations(runner)
    check_export(runner)
    check_harness(runner)

    print()
    if runner.failures:
        print(f"check: FAILED — {len(runner.failures)} step(s): "
              f"{', '.join(runner.failures)}")
    else:
        print("check: all steps passed")
    if runner.skips:
        print(f"check: {len(runner.skips)} step(s) SKIPPED — {', '.join(runner.skips)}")
        print("       a skipped step checks nothing; it is not a pass")
    return 1 if runner.failures else 0


if __name__ == "__main__":
    raise SystemExit(main())
