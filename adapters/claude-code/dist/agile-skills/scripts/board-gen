#!/usr/bin/env python3
"""Regenerate tracker/board.md from tracker state.

Usage:
  scripts/board-gen [workspace-root]     write the board
  scripts/board-gen --check [root]       exit 1 if the committed board is stale, write nothing

The board is derived state. It exists in the repository because a human opening the project
should see the state without running anything — and it is checked for staleness because a
derived file nobody verifies is a file that quietly starts lying.
"""

from __future__ import annotations

import datetime
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "lib"))

import board as board_lib  # noqa: E402
from workspace import Workspace, resolve_root  # noqa: E402


def main(argv: list) -> int:
    if any(token in ("--help", "-h") for token in argv[1:]):
        print(__doc__.strip())
        return 0
    check_only = "--check" in argv
    positional = []
    index = 1
    while index < len(argv):
        if argv[index] == "--root" and index + 1 < len(argv):
            positional.insert(0, argv[index + 1])
            index += 2
            continue
        if not argv[index].startswith("-"):
            positional.append(argv[index])
        index += 1
    root = resolve_root(positional[0] if positional else None, tool="board-gen")

    workspace = Workspace(root).load()
    fatal = [entry for entry in workspace.load_errors
             if entry[2] in ("project.missing", "items.missing")]
    if fatal:
        for path, _, code, message, _ in fatal:
            print(f"board-gen: {code}: {message} ({path})", file=sys.stderr)
        return 1

    generated_at = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    rendered = board_lib.render(workspace, generated_at)
    path = board_lib.board_path(workspace)

    existing = ""
    if os.path.isfile(path):
        with open(path, "r", encoding="utf-8") as handle:
            existing = handle.read()

    if check_only:
        if not existing:
            print("board-gen: tracker/board.md does not exist", file=sys.stderr)
            return 1
        if board_lib.differs(rendered, existing):
            print("board-gen: tracker/board.md is stale; run scripts/board-gen",
                  file=sys.stderr)
            return 1
        print("board-gen: board is current")
        return 0

    if existing and not board_lib.differs(rendered, existing):
        # Deliberately stdout, and deliberately worded as a result rather than as a warning.
        # This is a success — the board says what the tracker says — and four regression runs
        # reported it as a suspected failure because a caller scanning stderr sees only that a
        # gate wrote something (H-017's companion, 4c turns 10-15 and 17).
        print("board-gen: board is current; nothing to rewrite", file=sys.stdout)
        return 0

    with open(path, "w", encoding="utf-8") as handle:
        handle.write(rendered)
    print(f"board-gen: wrote {os.path.relpath(path, root)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
